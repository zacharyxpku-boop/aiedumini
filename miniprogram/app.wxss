page {
  min-height: 100vh;
  color: #10231c;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 242, 215, 0.92) 0%, rgba(255, 242, 215, 0) 520rpx),
    #fbf4e8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker,
canvas,
image {
  box-sizing: border-box;
}

image {
  display: block;
  max-width: 100%;
  flex-shrink: 0;
  vertical-align: top;
}

button {
  margin: 0;
  padding: 0;
  color: inherit;
  line-height: 1.2;
  background: transparent;
  border: 0;
  border-radius: 0;
  font: inherit;
  transition: opacity 120ms ease, transform 120ms ease;
}

button:active {
  opacity: 0.86;
  transform: scale(0.985);
}

button::after {
  border: 0;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 28rpx 56rpx;
}

.safe-bottom {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.yd-page,
.yd-shell {
  position: relative;
  min-height: 100vh;
}

.yd-brand {
  display: flex;
  align-items: center;
}

.yd-brand {
  min-width: 0;
  gap: 14rpx;
}

.yd-logo {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  background: #0c4a3b;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(12, 74, 59, 0.16);
}

.yd-logo::before {
  content: "";
  position: absolute;
  inset: 13rpx;
  background: #ffd96b;
  border-radius: 50%;
}

.yd-logo-core::before,
.yd-logo-core::after {
  content: "";
  position: absolute;
  top: 23rpx;
  z-index: 1;
  width: 5rpx;
  height: 5rpx;
  background: #0c4a3b;
  border-radius: 50%;
}

.yd-logo-core::before { left: 20rpx; }
.yd-logo-core::after { right: 20rpx; }

.yd-brand-copy {
  min-width: 0;
}

.yd-brand-name {
  color: #10231c;
  font-size: 34rpx;
  font-weight: 1000;
  line-height: 1.02;
}

.yd-brand-sub {
  max-width: 340rpx;
  margin-top: 4rpx;
  color: #6b665d;
  font-size: 20rpx;
  font-weight: 760;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-pill {
  min-height: 48rpx;
  padding: 0 22rpx;
  flex: 0 0 auto;
  color: #705020;
  background: rgba(255, 253, 248, 0.88);
  border: 1rpx solid #eadbc3;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.yd-card,
.panel,
.panel-quiet,
.mini-card {
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid #eadfce;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(65, 48, 28, 0.065);
}

.yd-card,
.panel,
.panel-quiet {
  padding: 22rpx;
}

.panel-quiet {
  background: #fbf4e8;
}

.yd-section-title,
.title-md {
  color: #10231c;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.2;
}

.yd-section-subtitle,
.muted {
  margin-top: 8rpx;
  color: #6b6257;
  font-size: 22rpx;
  font-weight: 740;
  line-height: 1.5;
}

.title-xl {
  color: #10231c;
  font-size: 54rpx;
  font-weight: 1000;
  line-height: 1.04;
  letter-spacing: 0;
}

.title-lg {
  color: #10231c;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.14;
}

.body {
  color: #514c44;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.55;
}

.eyebrow,
.yd-secondary-chip {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 16rpx;
  color: #0c4a3b;
  background: #eaf5ee;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.yd-primary,
.yd-secondary,
.primary-button,
.secondary-button,
.ghost-button {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.1;
}

.yd-primary,
.primary-button {
  color: #fffdf8;
  background: linear-gradient(180deg, #155746 0%, #0c4a3b 100%);
  box-shadow: 0 16rpx 28rpx rgba(12, 74, 59, 0.18);
}

.yd-secondary,
.secondary-button,
.ghost-button {
  color: #0c4a3b;
  background: rgba(255, 253, 248, 0.92);
  border: 1rpx solid #e5d8c3;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  color: #423d36;
  font-size: 24rpx;
  font-weight: 900;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  min-height: 80rpx;
  padding: 20rpx 22rpx;
  color: #10231c;
  background: #fffdf8;
  border: 1rpx solid #e5d8c3;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 760;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.55;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section {
  margin-top: 20rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.bar {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  background: #eee7dc;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  background: #4da66b;
  border-radius: 999rpx;
}

.divider {
  height: 1rpx;
  margin: 20rpx 0;
  background: #eadfce;
}

.yd-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.yd-chip {
  min-height: 44rpx;
  padding: 0 16rpx;
  color: #0c4a3b;
  background: #fffdf8;
  border: 1rpx solid #e5d8c3;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.positioning-kicker {
  color: #587064;
  font-size: 22rpx;
  font-weight: 800;
}

.positioning-title {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.positioning-flow {
  margin-top: 8rpx;
  color: #56665f;
  font-size: 24rpx;
  line-height: 1.55;
}

.positioning-actions,
.upload-flow-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.positioning-actions button,
.upload-flow-actions button {
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #17342b;
  background: #fffaf0;
  border: 1rpx solid #e2cfad;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}
/* Current miniapp shell: active tabs use explicit yd-* classes only. */
.yd-app-screen {
  position: relative;
  z-index: 1;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.92);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(248, 198, 34, 0.16), transparent 25%),
    linear-gradient(180deg, #fffef8 0%, #ffffff 100%);
  box-shadow: 0 20rpx 46rpx rgba(38, 58, 43, 0.075);
}

.yd-app-screen::before,
.yd-app-screen::after {
  display: none;
}

.yd-jump-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.yd-jump-card {
  position: relative;
  z-index: 1;
  display: grid;
  min-height: 156rpx;
  align-content: center;
  justify-items: center;
  gap: 10rpx;
  padding: 18rpx 16rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5fbf1 100%);
  box-shadow: 0 14rpx 30rpx rgba(34, 58, 42, .07);
}

.yd-jump-card.primary {
  grid-column: span 2;
  min-height: 176rpx;
  grid-template-columns: 150rpx minmax(0, 1fr);
  align-items: center;
  justify-items: start;
  border-color: rgba(34, 185, 92, .32);
  background: linear-gradient(135deg, #ffffff 0%, #eef9e9 100%);
}

.yd-jump-card image {
  width: 104rpx;
  height: 104rpx;
  justify-self: center;
  object-fit: contain;
  filter: drop-shadow(0 12rpx 16rpx rgba(34, 68, 48, .12));
}

.yd-jump-card.primary image {
  width: 132rpx;
  height: 132rpx;
  grid-row: 1 / span 2;
}

.yd-jump-card text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: normal;
  line-height: 1.2;
}

.yd-jump-card text:first-of-type {
  color: #123f31;
  font-size: 27rpx;
  font-weight: 950;
}

.yd-jump-card text:last-of-type {
  color: #657069;
  font-size: 21rpx;
  font-weight: 780;
}

.yd-jump-card.primary text {
  text-align: left;
}

.yd-action-primary {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  border-radius: 21rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #10533f 0%, #073f30 100%);
  box-shadow: 0 16rpx 28rpx rgba(11, 70, 52, .18);
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.2;
  text-align: center;
}

.yd-action-secondary {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 14rpx auto 0;
  padding: 0 34rpx;
  border: 1rpx solid #e5dac7;
  border-radius: 999rpx;
  color: #184333;
  background: #fffef9;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

/* Active tab first screens stay focused; deeper workflows open through routed child pages. */
.yd-app-screen ~ view,
.yd-app-screen ~ button,
.yd-app-screen ~ form,
.yd-app-screen ~ scroll-view,
.yd-app-screen ~ swiper {
  display: none !important;
}
