<view class="yd-tabbar">
  <view
    class="yd-tab-item {{selected === 0 ? 'active' : ''}}"
    data-index="0"
    data-path="/pages/tutor/tutor"
    bindtap="switchTab"
  >
    <view class="yd-tab-icon-wrap"><image class="yd-tab-icon" mode="aspectFit" src="/assets/reference/entry-tutor.png" /></view>
    <view class="yd-tab-text">AI私教</view>
  </view>
  <view
    class="yd-tab-item {{selected === 1 ? 'active' : ''}}"
    data-index="1"
    data-path="/pages/review/review"
    bindtap="switchTab"
  >
    <view class="yd-tab-icon-wrap"><image class="yd-tab-icon" mode="aspectFit" src="/assets/reference/entry-review.png" /></view>
    <view class="yd-tab-text">知识乐园</view>
  </view>
  <view
    class="yd-tab-item {{selected === 2 ? 'active' : ''}}"
    data-index="2"
    data-path="/pages/profile/profile"
    bindtap="switchTab"
  >
    <view class="yd-tab-icon-wrap"><image class="yd-tab-icon" mode="aspectFit" src="/assets/reference/entry-parent.png" /></view>
    <view class="yd-tab-text">成长报告</view>
  </view>
</view>
