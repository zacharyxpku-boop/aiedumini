.yd-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 0;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding: 10rpx 48rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #f1f1ee;
  border-radius: 0;
  box-shadow: 0 -10rpx 26rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  transition: transform 180ms ease, opacity 180ms ease;
}

.yd-tabbar.hidden {
  transform: translateY(120%);
  opacity: 0;
  pointer-events: none;
}

.yd-tab-item {
  position: relative;
  display: grid;
  grid-template-rows: 50rpx 30rpx;
  row-gap: 2rpx;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 5rpx 0 6rpx;
  color: #403d37;
  background: transparent;
  border: 0;
  border-radius: 0;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  box-sizing: border-box;
}

.yd-tab-item.active {
  color: #0f8f7c;
  background: transparent;
}

.yd-tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 22rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #14b8a6;
  transform: translateX(-50%);
}

.yd-tab-icon-wrap {
  display: flex;
  width: 96rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  justify-self: center;
  border-radius: 18rpx;
  overflow: hidden;
}

.yd-tab-item.active .yd-tab-icon-wrap {
  background: #e4f7f3;
}

.yd-tab-icon {
  display: block;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  object-fit: contain;
}

.yd-tab-text {
  display: block;
  width: 100%;
  height: 32rpx;
  overflow: hidden;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
