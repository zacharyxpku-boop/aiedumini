.yd-tabbar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  z-index: 999;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 6rpx;
  height: 108rpx;
  padding: 8rpx 8rpx 10rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid #f0ede5;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 14rpx rgba(55, 42, 24, 0.045);
  box-sizing: border-box;
}

.yd-tab-item {
  position: relative;
  display: grid;
  grid-template-rows: 50rpx 32rpx;
  row-gap: 3rpx;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 5rpx 0 6rpx;
  color: #403d37;
  background: transparent;
  border: 0;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  box-sizing: border-box;
}

.yd-tab-item.active {
  color: #0c4a3b;
  background: #f1faef;
}

.yd-tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 24rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #22b95c;
  transform: translateX(-50%);
}

.yd-tab-icon-wrap {
  display: flex;
  width: 58rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  justify-self: center;
  border-radius: 18rpx;
  overflow: hidden;
}

.yd-tab-item.active .yd-tab-icon-wrap {
  background: rgba(34, 185, 92, 0.12);
}

.yd-tab-icon {
  display: block;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  object-fit: contain;
}

.yd-tab-text {
  display: block;
  width: 100%;
  height: 32rpx;
  overflow: hidden;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
