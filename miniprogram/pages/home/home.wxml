<view class="home-page">
  <view class="first-run-overlay" wx:if="{{showFirstRunOverlay}}" catchtap="closeFirstRunOverlay">
    <view class="first-run-card">
      <view>原点不直接给答案</view>
      <text>先陪你看清今晚第一步。</text>
      <text>点一下继续，或等 3 秒自动收起。</text>
    </view>
  </view>

  <view class="home-header">
    <view class="home-brand">
      <image class="home-brand-icon" mode="aspectFit" src="/assets/reference/brand-house.png" />
      <view>
        <view class="home-title">原点智学</view>
        <view class="home-subtitle">今晚先推出第一步</view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="home-scroll">
    <view class="yd-home-screen yd-app-screen yd-home-app">
      <view class="yd-home-hero-card">
        <view class="yd-home-hero-copy">
          <view class="mini-streak-pill"><text class="mini-streak-dot"></text><text>{{homeViewModel.routePill}}</text></view>
          <view class="mini-title">{{homeViewModel.title}}</view>
          <view class="mini-subtitle">{{homeViewModel.subtitle}}</view>
          <view class="mini-streak-pill"><text class="mini-streak-dot"></text><text>连续学习</text><text>7</text><text>天</text></view>
        </view>
        <image class="yd-home-hero-mascot" mode="aspectFit" src="/assets/reference/gudian-fullbody-transparent.png" />
      </view>

      <view class="mini-relay-card" wx:if="{{incomingShareRelay}}">
        <view class="mini-relay-head">
          <text>鍚屼即鎺ュ姏</text>
          <text bindtap="continueShareRelay">缁х画</text>
        </view>
        <view wx:for="{{incomingShareRelay.relayPackCards}}" wx:key="id">{{item.title}} {{item.line}}</view>
        <view>{{incomingShareRelay.receiverOwnMaterialActionLine}}</view>
        <view>{{incomingShareRelay.firstStepLine}}</view>
      </view>

      <view class="home-upload-feature yd-jump-card" data-scene="upload" bindtap="openEntryDetail">
        <view class="home-upload-copy">
          <view class="home-card-kicker">第一步</view>
          <view class="home-upload-title">先把作业或错题发过来</view>
          <view class="home-upload-sub">拍照、粘贴文字、发试卷都可以。原点会先帮你看清今晚从哪里开始。</view>
          <view class="home-upload-cta">上传材料</view>
        </view>
        <image class="home-upload-visual" mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" />
      </view>

      <view class="home-result-grid">
        <view class="home-result-card blue" data-scene="parent" bindtap="openEntryDetail">
          <image class="home-result-icon" mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
          <text>家长报告</text>
          <text>看证据、看下一步</text>
        </view>
        <view class="home-result-card green" data-scene="today" bindtap="openEntryDetail">
          <image class="home-result-icon" mode="aspectFit" src="/assets/reference/learning-route-map-transparent.png" />
          <text>今晚路径</text>
          <text>把任务排成顺序</text>
        </view>
      </view>
      <view class="mini-route-card">
        <view class="mini-section-head"><text>{{homeViewModel.inputCard.title}}</text><text>预计 15-20 分钟</text></view>
        <view class="mini-subtitle" wx:if="{{homeViewModel.miniLessonResume}}">{{homeViewModel.miniLessonResume.title}}</view>
        <view class="mini-subtitle" wx:if="{{homeViewModel.reportServiceResume}}">{{homeViewModel.reportServiceResume.title}}</view>
        <textarea class="mini-route-input" value="{{thoughtInput}}" placeholder="{{homeViewModel.inputCard.placeholder}}" maxlength="500" auto-height bindinput="onThoughtInput" />
        <view class="mini-subtitle" wx:if="{{homeViewModel.emptyState}}">{{homeViewModel.emptyState}}</view>
        <view class="mini-subtitle route-next-lite" wx:if="{{homeViewModel.nextStep}}" catchtap="runHomeNextStep">{{homeViewModel.nextStep.text}} 路 {{homeViewModel.nextStep.cta}}</view>
        <view class="mini-main-cta" catchtap="planTonight">{{homeViewModel.primaryCta}}</view>
        <view class="mini-subtitle" bindtap="submitAiDraft">{{homeViewModel.secondaryAction}}</view>
      </view>

    </view>
  </scroll-view>
</view>
