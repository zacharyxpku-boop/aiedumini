<view class="home-page">
  <view class="first-run-overlay" wx:if="{{showFirstRunOverlay}}" catchtap="closeFirstRunOverlay">
    <view class="first-run-card">
      <view>原点不直接给答案</view>
      <text>陪你先看清今晚第一步。</text>
      <text>点一下继续，或等 3 秒自动收起。</text>
    </view>
  </view>

  <view class="home-header">
    <view class="home-brand">
      <image class="home-brand-icon" mode="aspectFit" src="/assets/reference/brand-house.png" />
      <view>
        <view class="home-title">原点智学</view>
        <view class="home-subtitle">今晚先推出第一步</view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="home-scroll">
    <view class="yd-home-screen yd-app-screen yd-home-app">
      <view class="yd-home-hero-card">
        <view class="yd-home-hero-copy">
          <view class="mini-streak-pill"><text class="mini-streak-dot"></text><text>{{homeViewModel.routePill}}</text></view>
          <view class="mini-title">{{homeViewModel.title}}</view>
          <view class="mini-subtitle">{{homeViewModel.subtitle}}</view>
          <view class="mini-streak-pill"><text class="mini-streak-dot"></text><text>连续学习</text><text>7</text><text>天</text></view>
        </view>
        <image class="yd-home-hero-mascot" mode="aspectFit" src="/assets/reference/gudian-fullbody-transparent.png" />
      </view>

      <view class="mini-relay-card" wx:if="{{incomingShareRelay}}">
        <view class="mini-relay-head">
          <text>同伴接力</text>
          <text bindtap="continueShareRelay">继续</text>
        </view>
        <view wx:for="{{incomingShareRelay.relayPackCards}}" wx:key="id">{{item.title}} {{item.line}}</view>
        <view>{{incomingShareRelay.receiverOwnMaterialChallengeLine}}</view>
        <view>{{incomingShareRelay.firstStepLine}}</view>
      </view>

      <view class="mini-entry-grid yd-jump-grid">
        <view class="mini-entry-card yd-jump-card green" data-scene="upload" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-upload.png" />
          <text>上传资料</text>
          <text>文档、试卷、错题</text>
          <view class="mini-entry-arrow">›</view>
        </view>
        <view class="mini-entry-card yd-jump-card blue" data-scene="report" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-report.png" />
          <text>个性化报告</text>
          <text>待提升点与建议</text>
          <view class="mini-entry-arrow blue">›</view>
        </view>
        <view class="mini-entry-card yd-jump-card green" data-scene="tutor" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-tutor.png" />
          <text>原点点拨</text>
          <text>只追问第一步</text>
          <view class="mini-entry-arrow">›</view>
        </view>
        <view class="mini-entry-card yd-jump-card yellow" data-scene="review" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-review.png" />
          <text>短回访</text>
          <text>回忆与变式验证</text>
          <view class="mini-entry-arrow orange">›</view>
        </view>
        <view class="mini-entry-card yd-jump-card orange" data-scene="parent" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-parent.png" />
          <text>家长报告</text>
          <text>证据与下一步</text>
          <view class="mini-entry-arrow orange">›</view>
        </view>
        <view class="mini-entry-card yd-jump-card map" data-scene="today" bindtap="openEntryDetail">
          <image class="mini-entry-visual" mode="aspectFit" src="/assets/reference/entry-map.png" />
          <text>今晚路径</text>
          <text>五步闭环</text>
          <view class="mini-entry-arrow">›</view>
        </view>
      </view>
      <view class="mini-route-card">
        <view class="mini-section-head"><text>{{homeViewModel.inputCard.title}}</text><text>预计 15-20 分钟</text></view>
        <view class="mini-subtitle" wx:if="{{homeViewModel.miniLessonResume}}">{{homeViewModel.miniLessonResume.title}}</view>
        <view class="mini-subtitle" wx:if="{{homeViewModel.reportServiceResume}}">{{homeViewModel.reportServiceResume.title}}</view>
        <textarea class="mini-route-input" value="{{thoughtInput}}" placeholder="{{homeViewModel.inputCard.placeholder}}" maxlength="500" auto-height bindinput="onThoughtInput" />
        <view class="mini-route-line">
          <view class="mini-route-node done">
            <image class="mini-route-icon" mode="aspectFit" src="/assets/reference/entry-upload.png" />
            <text>上传资料</text>
            <text>材料进来</text>
          </view>
          <view class="mini-route-node done">
            <image class="mini-route-icon" mode="aspectFit" src="/assets/reference/entry-report.png" />
            <text>生成报告</text>
            <text>依据清楚</text>
          </view>
          <view class="mini-route-node active">
            <image class="mini-route-icon" mode="aspectFit" src="/assets/reference/entry-tutor.png" />
            <text>说第一步</text>
            <text>点拨追问</text>
          </view>
          <view class="mini-route-node">
            <image class="mini-route-icon" mode="aspectFit" src="/assets/reference/entry-review.png" />
            <text>回访</text>
            <text>验证迁移</text>
          </view>
          <view class="mini-route-node final">
            <image class="mini-route-icon" mode="aspectFit" src="/assets/reference/entry-parent.png" />
            <text>家长看</text>
            <text>只看下一步</text>
          </view>
        </view>
        <view class="mini-subtitle" wx:if="{{homeViewModel.emptyState}}">{{homeViewModel.emptyState}}</view>
        <view class="mini-subtitle route-next-lite" wx:if="{{homeViewModel.nextStep}}" catchtap="runHomeNextStep">{{homeViewModel.nextStep.text}} · {{homeViewModel.nextStep.cta}}</view>
        <view class="mini-main-cta" catchtap="planTonight">{{homeViewModel.primaryCta}}</view>
        <view class="mini-subtitle" bindtap="submitAiDraft">{{homeViewModel.secondaryAction}}</view>
      </view>

    </view>
  </scroll-view>
</view>
