.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfaf5 0%, #f3fbec 100%);
  color: #203127;
}

.first-run-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(20, 45, 32, 0.18);
}

.first-run-card {
  width: 560rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 70rpx rgba(30, 55, 36, 0.18);
}

.first-run-card view {
  color: #17342b;
  font-size: 34rpx;
  font-weight: 950;
}

.first-run-card text {
  display: block;
  margin-top: 12rpx;
  color: #607169;
  font-size: 24rpx;
  line-height: 1.45;
}

.home-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: calc(36rpx + env(safe-area-inset-top)) 204rpx 10rpx 32rpx;
  background: linear-gradient(180deg, rgba(251,250,245,.98), rgba(251,250,245,.82));
  backdrop-filter: blur(18rpx);
}

.home-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.home-brand-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
}

.home-title {
  color: #17342b;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.08;
}

.home-subtitle {
  margin-top: 4rpx;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  white-space: nowrap;
}

.home-scroll {
  height: calc(100vh - 92rpx - env(safe-area-inset-top));
  padding-top: calc(92rpx + env(safe-area-inset-top));
}

.yd-home-screen {
  margin: 0 24rpx 18rpx;
  padding: 0 0 calc(112rpx + env(safe-area-inset-bottom));
  border: 0;
  background: transparent;
  box-shadow: none;
}

.yd-home-hero-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 184rpx;
  gap: 8rpx;
  min-height: 184rpx;
  padding: 20rpx 20rpx 18rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 34rpx;
  background: radial-gradient(circle at 88% 18%, rgba(248,198,34,.22), transparent 28%), linear-gradient(135deg, #ffffff 0%, #effaea 100%);
  box-shadow: 0 22rpx 50rpx rgba(42, 68, 52, 0.08);
}

.yd-home-hero-copy { min-width: 0; position: relative; z-index: 1; }

.yd-home-hero-mascot {
  position: relative;
  z-index: 1;
  width: 190rpx;
  height: 184rpx;
  justify-self: end;
  align-self: center;
  filter: drop-shadow(0 18rpx 22rpx rgba(34, 68, 48, .13));
}

.mini-streak-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 9rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.84);
  color: #174c3d;
  font-size: 21rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 1rpx rgba(34,185,92,.12);
}

.mini-streak-pill:first-child { margin-top: 0; color: #0d7a3d; background: #e9f8ef; }
.mini-streak-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #22b95c; }

.mini-title {
  max-width: 410rpx;
  margin-top: 9rpx;
  color: #17211d;
  font-size: 35rpx;
  font-weight: 1000;
  line-height: 1.06;
}

.mini-subtitle {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: #56645c;
  font-size: 21rpx;
  line-height: 1.36;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mini-relay-card,
.mini-route-card {
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(32,49,39,.055);
}

.mini-relay-card { margin-top: 14rpx; padding: 16rpx; }
.mini-relay-head,
.mini-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.mini-relay-head text:first-child,
.mini-section-head text:first-child { color: #17211d; font-size: 24rpx; font-weight: 950; }
.mini-relay-head text:last-child,
.mini-section-head text:last-child { color: #16a34a; font-size: 20rpx; font-weight: 900; }

.mini-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 9rpx;
}

.mini-entry-card {
  position: relative;
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  align-items: center;
  column-gap: 8rpx;
  min-height: 98rpx;
  padding: 9rpx 30rpx 9rpx 8rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f4fbef 100%);
  box-shadow: 0 14rpx 30rpx rgba(34,58,42,.07);
}

.mini-entry-card.blue { background: linear-gradient(180deg, #ffffff 0%, #eef7ff 100%); }
.mini-entry-card.yellow { background: linear-gradient(180deg, #ffffff 0%, #fff8df 100%); }
.mini-entry-card.orange { background: linear-gradient(180deg, #ffffff 0%, #fff1ea 100%); }
.mini-entry-card.map { background: linear-gradient(180deg, #ffffff 0%, #eefbed 100%); }

.mini-entry-visual {
  grid-row: 1 / 3;
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  filter: drop-shadow(0 12rpx 16rpx rgba(34,68,48,.12));
}

.mini-entry-card text {
  display: block;
  grid-column: 2;
  max-width: 100%;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
}
.mini-entry-card text:first-of-type { align-self: end; color: #123f31; font-size: 22rpx; font-weight: 950; white-space: nowrap; }
.mini-entry-card text:nth-of-type(2) { display: -webkit-box; align-self: start; min-height: 30rpx; color: #657069; font-size: 17rpx; line-height: 1.12; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

.mini-entry-arrow {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(34,185,92,.12);
  color: #16a34a;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 32rpx;
  text-align: center;
}

.mini-entry-arrow.blue { background: rgba(47,129,247,.12); color: #2f74d0; }
.mini-entry-arrow.orange { background: rgba(255,122,69,.12); color: #c6512f; }

.mini-route-card { margin-top: 9rpx; padding: 12rpx; }
.mini-route-input { width: 100%; min-height: 54rpx; margin-top: 7rpx; padding: 11rpx 13rpx; border: 1rpx solid #e8eee6; border-radius: 18rpx; background: #f8fbf5; color: #203127; font-size: 21rpx; line-height: 1.25; }

.mini-route-line { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5rpx; margin-top: 8rpx; }
.mini-route-node { display: grid; min-height: 68rpx; justify-items: center; align-content: center; gap: 2rpx; padding: 6rpx 2rpx; border: 1rpx solid #e8eee6; border-radius: 15rpx; background: #ffffff; }
.mini-route-node.done { background: #eefbed; }
.mini-route-node.active { border-color: rgba(34,185,92,.34); background: #e9f8ef; }
.mini-route-node.final { background: #fff8df; }
.mini-route-icon { width: 28rpx; height: 28rpx; border-radius: 10rpx; }
.mini-route-node text:nth-child(2) { max-width: 100%; overflow: hidden; color: #17211d; font-size: 16rpx; font-weight: 950; text-overflow: ellipsis; white-space: nowrap; }
.mini-route-node text:nth-child(3) { display: none; }

.route-next-lite { color: #0d7a3d; font-weight: 900; }
.mini-main-cta { height: 60rpx; margin-top: 9rpx; border-radius: 18rpx; background: linear-gradient(180deg, #22b95c 0%, #16a34a 100%); color: #fff; font-size: 23rpx; font-weight: 950; line-height: 60rpx; text-align: center; box-shadow: 0 16rpx 28rpx rgba(34,185,92,.2); }
