.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fbfaf5 0%, #f3fbec 100%);
  color: #203127;
}

.first-run-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(20, 45, 32, 0.18);
}

.first-run-card {
  width: 560rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 70rpx rgba(30, 55, 36, 0.18);
}

.first-run-card view {
  color: #17342b;
  font-size: 34rpx;
  font-weight: 950;
}

.first-run-card text {
  display: block;
  margin-top: 12rpx;
  color: #607169;
  font-size: 24rpx;
  line-height: 1.45;
}

.home-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: calc(36rpx + env(safe-area-inset-top)) 204rpx 10rpx 32rpx;
  background: linear-gradient(180deg, rgba(251,250,245,.98), rgba(251,250,245,.82));
  backdrop-filter: blur(18rpx);
}

.home-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.home-brand-icon {
  width: 56rpx;
  height: 56rpx;
  object-fit: contain;
  border-radius: 20rpx;
}

.home-title {
  color: #17342b;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.08;
}

.home-subtitle {
  margin-top: 4rpx;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  white-space: nowrap;
}

.home-scroll {
  height: calc(100vh - 86rpx - env(safe-area-inset-top));
  padding-top: calc(86rpx + env(safe-area-inset-top));
}

.yd-home-screen {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: calc(100vh - 98rpx - env(safe-area-inset-top));
  margin: 0 22rpx 18rpx;
  padding: 0 0 calc(104rpx + env(safe-area-inset-bottom));
  border: 0;
  background: transparent;
  box-shadow: none;
  gap: 14rpx;
}

.yd-home-hero-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 12rpx;
  min-height: 252rpx;
  padding: 28rpx 22rpx 26rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 34rpx;
  background: radial-gradient(circle at 88% 18%, rgba(248,198,34,.22), transparent 28%), linear-gradient(135deg, #ffffff 0%, #effaea 100%);
  box-shadow: 0 22rpx 50rpx rgba(42, 68, 52, 0.08);
}

.yd-home-hero-copy { min-width: 0; position: relative; z-index: 1; }

.yd-home-hero-mascot {
  position: relative;
  z-index: 1;
  width: 218rpx;
  height: 218rpx;
  justify-self: end;
  align-self: center;
  object-fit: contain;
  filter: drop-shadow(0 18rpx 22rpx rgba(34, 68, 48, .13));
}

.mini-streak-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 9rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.84);
  color: #174c3d;
  font-size: 21rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 1rpx rgba(34,185,92,.12);
}

.mini-streak-pill:first-child { margin-top: 0; color: #0d7a3d; background: #e9f8ef; }
.mini-streak-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #22b95c; }

.mini-title {
  max-width: 430rpx;
  margin-top: 12rpx;
  color: #17211d;
  font-size: 42rpx;
  font-weight: 1000;
  line-height: 1.06;
}

.mini-subtitle {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: #56645c;
  font-size: 23rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mini-relay-card,
.mini-route-card {
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(32,49,39,.055);
}

.mini-relay-card { margin-top: 0; padding: 16rpx; }
.mini-relay-head,
.mini-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.mini-relay-head text:first-child,
.mini-section-head text:first-child { color: #17211d; font-size: 24rpx; font-weight: 950; }
.mini-relay-head text:last-child,
.mini-section-head text:last-child { color: #16a34a; font-size: 20rpx; font-weight: 900; }

.home-upload-feature {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 278rpx;
  margin-top: 8rpx;
  padding: 28rpx 22rpx 28rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid #dfeee1;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #ffffff 0%, #ecfaef 100%);
  box-shadow: 0 20rpx 44rpx rgba(34, 68, 48, 0.09);
}

.home-upload-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.home-card-kicker {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 16rpx;
  color: #0d7a3d;
  background: #e6f7ed;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 42rpx;
}

.home-upload-title {
  margin-top: 16rpx;
  color: #15241d;
  font-size: 42rpx;
  font-weight: 1000;
  line-height: 1.08;
}

.home-upload-sub {
  margin-top: 12rpx;
  color: #56645c;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.42;
}

.home-upload-cta {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 26rpx;
  color: #ffffff;
  background: #16a34a;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 58rpx;
}

.home-upload-visual {
  position: relative;
  z-index: 1;
  width: 210rpx;
  height: 210rpx;
  justify-self: end;
  object-fit: contain;
  filter: drop-shadow(0 18rpx 24rpx rgba(34, 68, 48, 0.14));
}

.home-result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 0;
}

.home-result-card {
  position: relative;
  display: flex;
  min-height: 176rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 22rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 30rpx rgba(34,58,42,.07);
}

.home-result-card.blue { background: linear-gradient(180deg, #ffffff 0%, #edf7ff 100%); }
.home-result-card.green { background: linear-gradient(180deg, #ffffff 0%, #eefbed 100%); }

.home-result-icon {
  width: 76rpx;
  height: 76rpx;
  object-fit: contain;
  border-radius: 20rpx;
  filter: drop-shadow(0 12rpx 16rpx rgba(34,68,48,.12));
}

.home-result-card text {
  display: block;
  max-width: 100%;
  text-align: left;
}

.home-result-card text:first-of-type {
  color: #123f31;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.18;
}

.home-result-card text:nth-of-type(2) {
  color: #66746d;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 1.28;
}

.mini-route-card {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  margin-top: 0;
  padding: 16rpx 16rpx 14rpx;
}
.mini-route-input { width: 100%; min-height: 82rpx; margin-top: 10rpx; padding: 15rpx 16rpx; border: 1rpx solid #e8eee6; border-radius: 20rpx; background: #f8fbf5; color: #203127; font-size: 23rpx; line-height: 1.32; }

.route-next-lite { color: #0d7a3d; font-weight: 900; }
.mini-main-cta { height: 72rpx; margin-top: 14rpx; border-radius: 22rpx; background: linear-gradient(180deg, #22b95c 0%, #16a34a 100%); color: #fff; font-size: 26rpx; font-weight: 950; line-height: 72rpx; text-align: center; box-shadow: 0 18rpx 32rpx rgba(34,185,92,.22); }
