.entry-detail-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 100vh;
  padding: calc(76rpx + env(safe-area-inset-top)) 22rpx calc(38rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #203127;
  background:
    radial-gradient(circle at 18% 5%, rgba(248, 198, 34, 0.16), transparent 20%),
    linear-gradient(180deg, #fbfaf5 0%, #f5fbef 100%);
}

.entry-detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}

.entry-back {
  display: grid;
  width: 48rpx;
  height: 48rpx;
  place-items: center;
  padding: 0;
  border-radius: 30rpx;
  color: #203127;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.07);
  font-size: 32rpx;
  line-height: 1;
}

.entry-brand {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 13rpx 6rpx 9rpx;
  border: 1rpx solid #e8eee6;
  border-radius: 999rpx;
  color: #174c3d;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.05);
  font-size: 22rpx;
  font-weight: 900;
}

.entry-brand image {
  width: 32rpx;
  height: 32rpx;
}

.entry-jump-section {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: 126rpx minmax(0, 1fr);
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.8);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 20rpx rgba(38, 58, 43, 0.045);
}

.entry-jump-current {
  min-width: 0;
  padding-left: 5rpx;
}

.entry-jump-current text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-jump-current text:first-child {
  color: #77847d;
  font-size: 20rpx;
  font-weight: 800;
}

.entry-jump-current text:last-child {
  margin-top: 3rpx;
  color: #173f31;
  font-size: 22rpx;
  font-weight: 950;
}

.entry-jump-scroll {
  width: 100%;
  white-space: nowrap;
}

.entry-jump-row {
  display: inline-flex;
  gap: 8rpx;
  min-width: 100%;
}

.entry-jump-card {
  display: inline-flex;
  min-width: 132rpx;
  max-width: 176rpx;
  min-height: 54rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 7rpx;
  padding: 7rpx 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.92);
  border-radius: 999rpx;
  color: #526158;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 16rpx rgba(38, 58, 43, 0.035);
  font-size: 21rpx;
  line-height: 1.1;
}

.entry-jump-card.active {
  border-color: rgba(34, 185, 92, 0.38);
  color: #0d7a3d;
  background: linear-gradient(180deg, #eaf9ef 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.13);
}

.entry-jump-card image {
  width: 30rpx;
  height: 30rpx;
  object-fit: contain;
}

.entry-jump-card text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.1;
}

.entry-detail-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 208rpx;
  gap: 18rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 286rpx;
  padding: 28rpx 22rpx 26rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 20%, rgba(34, 185, 92, 0.13), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f3fbef 100%);
  box-shadow: 0 22rpx 50rpx rgba(42, 68, 52, 0.08);
}

.entry-detail-hero::before {
  content: "";
  position: absolute;
  right: -50rpx;
  bottom: -52rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: rgba(34, 185, 92, 0.10);
  transform: rotate(-12deg);
}

.entry-detail-hero::after {
  content: "";
  position: absolute;
  left: 26rpx;
  bottom: 22rpx;
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f8c622;
  transform: rotate(-5deg);
}

.entry-detail-hero.scene-tutor,
.entry-detail-hero.scene-report {
  background:
    radial-gradient(circle at 84% 18%, rgba(76, 159, 255, 0.16), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-detail-hero.scene-review {
  background:
    radial-gradient(circle at 84% 18%, rgba(248, 198, 34, 0.18), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-detail-hero.scene-parent {
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 122, 69, 0.15), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-detail-hero.scene-upload {
  background:
    radial-gradient(circle at 84% 18%, rgba(34, 185, 92, 0.17), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-badge,
.entry-title,
.entry-subtitle,
.entry-mini-path,
.entry-image {
  position: relative;
  z-index: 1;
}

.entry-badge {
  display: inline-flex;
  margin-bottom: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #16a34a;
  background: #e9f8ef;
  font-size: 20rpx;
  font-weight: 850;
}

.entry-title {
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.12;
  letter-spacing: 0;
}

.entry-subtitle {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  color: #56645c;
  font-size: 24rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.entry-mini-path {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
  max-width: 306rpx;
  margin-top: 10rpx;
}

.entry-mini-path text {
  min-height: 44rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.15);
  border-radius: 999rpx;
  color: #174c3d;
  background: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  white-space: nowrap;
}

.entry-image {
  width: 196rpx;
  height: 196rpx;
  justify-self: end;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border-radius: 26rpx;
  filter: drop-shadow(0 18rpx 24rpx rgba(47, 88, 58, 0.14));
}

.entry-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin: 0;
}

.entry-primary,
.entry-secondary {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.2;
}

.entry-primary {
  color: #183023;
  background: linear-gradient(180deg, #ffd84d 0%, #f8c622 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.24);
}

.entry-secondary {
  border: 2rpx solid rgba(34, 185, 92, 0.22);
  color: #16a34a;
  background: #ffffff;
}

.entry-spotlight {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 124rpx;
  gap: 12rpx;
  flex: 0 0 auto;
  min-height: 232rpx;
  margin-top: 0;
  margin-bottom: 0;
  padding: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1fbf1 100%);
  box-shadow: 0 14rpx 32rpx rgba(32, 49, 39, 0.055);
}

.entry-spotlight.scene-report,
.entry-spotlight.scene-tutor {
  background: linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-spotlight.scene-review {
  background: linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-spotlight.scene-parent {
  background: linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-spotlight.scene-upload {
  background: linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-spotlight-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.entry-spotlight-kicker {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #0d7a3d;
  background: rgba(34, 185, 92, 0.10);
  font-size: 20rpx;
  font-weight: 900;
}

.entry-spotlight.scene-report .entry-spotlight-kicker,
.entry-spotlight.scene-tutor .entry-spotlight-kicker {
  color: #2669ad;
  background: rgba(76, 159, 255, 0.12);
}

.entry-spotlight.scene-review .entry-spotlight-kicker {
  color: #8c6f1a;
  background: rgba(248, 198, 34, 0.18);
}

.entry-spotlight.scene-parent .entry-spotlight-kicker {
  color: #b6512f;
  background: rgba(255, 122, 69, 0.13);
}

.entry-spotlight-title {
  margin-top: 5rpx;
  color: #203127;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.18;
}

.entry-spotlight-image {
  position: relative;
  z-index: 1;
  width: 124rpx;
  height: 124rpx;
  justify-self: end;
  align-self: center;
  object-fit: contain;
  filter: drop-shadow(0 14rpx 18rpx rgba(47, 88, 58, 0.12));
}

.entry-spotlight-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 9rpx;
}

.entry-spotlight-metrics view {
  min-width: 0;
  min-height: 74rpx;
  padding: 9rpx 7rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.11);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.entry-spotlight-metrics text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
}

.entry-spotlight-metrics text:first-child {
  color: #6c7970;
  font-size: 20rpx;
  font-weight: 760;
}

.entry-spotlight-metrics text:last-child {
  margin-top: 3rpx;
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
}

.entry-spotlight-points {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 7rpx;
  align-self: end;
}

.entry-spotlight-points view {
  display: grid;
  grid-template-columns: 10rpx minmax(0, 1fr);
  gap: 6rpx;
  align-items: start;
  padding: 8rpx 10rpx;
  border-radius: 18rpx;
  color: #455149;
  background: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.28;
}

.entry-spotlight-points text:first-child {
  width: 10rpx;
  height: 10rpx;
  margin-top: 5rpx;
  border-radius: 999rpx;
  background: #22b95c;
}

.entry-proof-strip {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
  align-items: stretch;
  margin-top: 0;
  padding: 9rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.9);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.04);
}

.entry-proof-label {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #0d7a3d;
  background: #eaf9ef;
  font-size: 22rpx;
  font-weight: 950;
  text-align: center;
  white-space: nowrap;
}

.entry-proof-node {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 62rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 0;
  border-radius: 18rpx;
  background: #f8fbf5;
  box-shadow: none;
  line-height: 1.15;
}

.entry-proof-node::after {
  display: none;
}

.entry-proof-node:last-child::after {
  display: none;
}

.entry-proof-node.final {
  border-color: rgba(248, 198, 34, 0.34);
  background: linear-gradient(180deg, #fff8df 0%, #ffffff 100%);
}

.entry-proof-node.active {
  border-color: rgba(34, 185, 92, 0.34);
  background: linear-gradient(180deg, #eaf9ef 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.12);
}

.entry-proof-icon {
  width: 28rpx;
  height: 28rpx;
  object-fit: contain;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.entry-proof-node.final .entry-proof-icon {
  background: #fff1bd;
}

.entry-proof-strip text {
  max-width: 100%;
  overflow: hidden;
  color: #17211d;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 1.18;
  text-align: center;
  text-overflow: ellipsis;
  white-space: normal;
}

.entry-proof-hint {
  display: none;
  color: #6c7970 !important;
  font-size: 20rpx !important;
  font-weight: 760 !important;
}
