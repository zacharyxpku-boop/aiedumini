.entry-detail-page {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 100vh;
  padding: calc(86rpx + env(safe-area-inset-top)) 22rpx calc(58rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  color: #203127;
  background:
    radial-gradient(circle at 18% 5%, rgba(248, 198, 34, 0.16), transparent 20%),
    linear-gradient(180deg, #fbfaf5 0%, #f5fbef 100%);
}

.entry-detail-top {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-bottom: 0;
}

.entry-back {
  display: grid;
  width: 48rpx;
  height: 48rpx;
  place-items: center;
  padding: 0;
  border-radius: 30rpx;
  color: #203127;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.07);
  font-size: 32rpx;
  line-height: 1;
}

.entry-brand {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 13rpx 6rpx 9rpx;
  border: 1rpx solid #e8eee6;
  border-radius: 999rpx;
  color: #174c3d;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.05);
  font-size: 22rpx;
  font-weight: 900;
}

.entry-brand image {
  width: 32rpx;
  height: 32rpx;
}

.entry-focus-card {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: 164rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.88);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 22rpx rgba(38, 58, 43, 0.045);
}

.entry-focus-label,
.entry-focus-title,
.entry-focus-copy {
  display: block;
  overflow-wrap: break-word;
  word-break: break-word;
  white-space: normal;
}

.entry-focus-label {
  color: #77847d;
  font-size: 20rpx;
  font-weight: 850;
}

.entry-focus-title {
  margin-top: 2rpx;
  color: #173f31;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.12;
}

.entry-focus-copy {
  color: #526158;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.28;
}

.entry-card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.entry-card-item {
  display: grid;
  min-width: 0;
  min-height: 148rpx;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.9);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(32, 49, 39, 0.045);
}

.entry-card-item:active {
  transform: scale(0.985);
}

.entry-card-item image {
  width: 48rpx;
  height: 48rpx;
}

.entry-card-item text {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  overflow-wrap: break-word;
  word-break: break-word;
  -webkit-box-orient: vertical;
}

.entry-card-item text:nth-child(2) {
  color: #173f31;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 1.14;
  -webkit-line-clamp: 1;
}

.entry-card-item text:nth-child(3) {
  color: #66746d;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.2;
  -webkit-line-clamp: 2;
}

.entry-detail-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 188rpx;
  gap: 16rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 292rpx;
  padding: 24rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 20%, rgba(34, 185, 92, 0.13), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f3fbef 100%);
  box-shadow: 0 22rpx 50rpx rgba(42, 68, 52, 0.08);
}

.entry-detail-hero::before {
  content: "";
  position: absolute;
  right: -50rpx;
  bottom: -52rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: rgba(34, 185, 92, 0.10);
  transform: rotate(-12deg);
}

.entry-detail-hero::after {
  content: "";
  position: absolute;
  left: 26rpx;
  bottom: 22rpx;
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f8c622;
  transform: rotate(-5deg);
}

.entry-detail-hero.scene-tutor,
.entry-detail-hero.scene-report {
  background:
    radial-gradient(circle at 84% 18%, rgba(76, 159, 255, 0.16), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-detail-hero.scene-review {
  background:
    radial-gradient(circle at 84% 18%, rgba(248, 198, 34, 0.18), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-detail-hero.scene-parent {
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 122, 69, 0.15), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-detail-hero.scene-upload {
  background:
    radial-gradient(circle at 84% 18%, rgba(34, 185, 92, 0.17), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-badge,
.entry-title,
.entry-subtitle,
.entry-mini-path,
.entry-image {
  position: relative;
  z-index: 1;
}

.entry-badge {
  display: inline-flex;
  margin-bottom: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #16a34a;
  background: #e9f8ef;
  font-size: 20rpx;
  font-weight: 850;
}

.entry-title {
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.12;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.entry-subtitle {
  display: -webkit-box;
  margin-top: 5rpx;
  overflow: hidden;
  color: #56645c;
  font-size: 24rpx;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.entry-mini-path {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
  max-width: 330rpx;
  margin-top: 9rpx;
}

.entry-mini-path text {
  min-height: 44rpx;
  padding: 6rpx 7rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(34, 185, 92, 0.15);
  border-radius: 999rpx;
  color: #174c3d;
  background: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.15;
  text-align: center;
  white-space: normal;
}

.entry-image {
  width: 208rpx;
  height: 208rpx;
  justify-self: end;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border-radius: 26rpx;
  filter: drop-shadow(0 18rpx 24rpx rgba(47, 88, 58, 0.14));
}

.entry-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin: 0;
}

.entry-primary,
.entry-secondary {
  display: flex;
  min-height: 88rpx;
  height: auto;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
  white-space: normal;
}

.entry-primary {
  color: #183023;
  background: linear-gradient(180deg, #ffd84d 0%, #f8c622 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.24);
}

.entry-secondary {
  border: 2rpx solid rgba(34, 185, 92, 0.22);
  color: #16a34a;
  background: #ffffff;
}

.entry-spotlight {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  grid-template-rows: auto auto;
  gap: 12rpx;
  flex: 0 0 auto;
  align-content: stretch;
  min-height: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1fbf1 100%);
  box-shadow: 0 14rpx 32rpx rgba(32, 49, 39, 0.055);
}

.entry-spotlight.scene-report,
.entry-spotlight.scene-tutor {
  background: linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-spotlight.scene-review {
  background: linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-spotlight.scene-parent {
  background: linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-spotlight.scene-upload {
  background: linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-spotlight-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.entry-spotlight-kicker {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #0d7a3d;
  background: rgba(34, 185, 92, 0.10);
  font-size: 20rpx;
  font-weight: 900;
}

.entry-spotlight.scene-report .entry-spotlight-kicker,
.entry-spotlight.scene-tutor .entry-spotlight-kicker {
  color: #2669ad;
  background: rgba(76, 159, 255, 0.12);
}

.entry-spotlight.scene-review .entry-spotlight-kicker {
  color: #8c6f1a;
  background: rgba(248, 198, 34, 0.18);
}

.entry-spotlight.scene-parent .entry-spotlight-kicker {
  color: #b6512f;
  background: rgba(255, 122, 69, 0.13);
}

.entry-spotlight-title {
  margin-top: 6rpx;
  color: #203127;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.18;
}

.entry-spotlight-image {
  position: relative;
  z-index: 1;
  width: 150rpx;
  height: 150rpx;
  justify-self: end;
  align-self: center;
  object-fit: contain;
  filter: drop-shadow(0 14rpx 18rpx rgba(47, 88, 58, 0.12));
}

.entry-spotlight-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 10rpx;
}

.entry-spotlight-metrics view {
  min-width: 0;
  min-height: 76rpx;
  padding: 9rpx 8rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.11);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.entry-spotlight-metrics text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
}

.entry-spotlight-metrics text:first-child {
  color: #6c7970;
  font-size: 20rpx;
  font-weight: 760;
}

.entry-spotlight-metrics text:last-child {
  margin-top: 3rpx;
  color: #17211d;
  font-size: 24rpx;
  font-weight: 950;
}

.entry-spotlight-points {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: repeat(3, minmax(112rpx, auto));
  gap: 10rpx;
  align-self: stretch;
  align-content: stretch;
}

.entry-spotlight-points view {
  display: grid;
  grid-template-columns: 10rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  min-height: 112rpx;
  padding: 16rpx 16rpx;
  border-radius: 18rpx;
  color: #455149;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.32;
}

.entry-spotlight-points text:first-child {
  width: 10rpx;
  height: 10rpx;
  margin-top: 5rpx;
  border-radius: 999rpx;
  background: #22b95c;
}
