.entry-detail-page {
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 22rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: #203127;
  background:
    radial-gradient(circle at 18% 5%, rgba(248, 198, 34, 0.16), transparent 20%),
    linear-gradient(180deg, #fbfaf5 0%, #f5fbef 100%);
}

.entry-detail-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.entry-back {
  display: grid;
  width: 56rpx;
  height: 56rpx;
  place-items: center;
  padding: 0;
  border-radius: 30rpx;
  color: #203127;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.07);
  font-size: 38rpx;
  line-height: 1;
}

.entry-brand {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 15rpx 8rpx 11rpx;
  border: 1rpx solid #e8eee6;
  border-radius: 999rpx;
  color: #174c3d;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.05);
  font-size: 24rpx;
  font-weight: 900;
}

.entry-brand image {
  width: 36rpx;
  height: 36rpx;
}

.entry-jump-section {
  position: relative;
  z-index: 5;
  margin: 8rpx 0 6rpx;
  padding: 5rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.8);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 20rpx rgba(38, 58, 43, 0.045);
}

.entry-jump-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 4rpx;
}

.entry-jump-card {
  display: grid;
  min-width: 0;
  min-height: 62rpx;
  box-sizing: border-box;
  align-content: center;
  justify-items: center;
  gap: 2rpx;
  padding: 6rpx 2rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  color: #526158;
  background: transparent;
  box-shadow: none;
  font-size: 18rpx;
  line-height: 1.1;
}

.entry-jump-card.active {
  border-color: rgba(34, 185, 92, 0.38);
  color: #0d7a3d;
  background: linear-gradient(180deg, #eaf9ef 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.13);
}

.entry-jump-card image {
  width: 32rpx;
  height: 32rpx;
}

.entry-jump-card text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.1;
}

.entry-detail-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150rpx;
  gap: 8rpx;
  align-items: center;
  min-height: 186rpx;
  padding: 14rpx 18rpx 13rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 86% 20%, rgba(34, 185, 92, 0.13), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #f3fbef 100%);
  box-shadow: 0 22rpx 50rpx rgba(42, 68, 52, 0.08);
}

.entry-detail-hero::before {
  content: "";
  position: absolute;
  right: -58rpx;
  bottom: -54rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 58rpx;
  background: rgba(34, 185, 92, 0.10);
  transform: rotate(-12deg);
}

.entry-detail-hero::after {
  content: "";
  position: absolute;
  left: 30rpx;
  bottom: 28rpx;
  width: 86rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #f8c622;
  transform: rotate(-5deg);
}

.entry-detail-hero.scene-tutor,
.entry-detail-hero.scene-report {
  background:
    radial-gradient(circle at 84% 18%, rgba(76, 159, 255, 0.16), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-detail-hero.scene-review {
  background:
    radial-gradient(circle at 84% 18%, rgba(248, 198, 34, 0.18), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-detail-hero.scene-parent {
  background:
    radial-gradient(circle at 84% 18%, rgba(255, 122, 69, 0.15), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-detail-hero.scene-upload {
  background:
    radial-gradient(circle at 84% 18%, rgba(34, 185, 92, 0.17), transparent 28%),
    linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-badge,
.entry-title,
.entry-subtitle,
.entry-mini-path,
.entry-image {
  position: relative;
  z-index: 1;
}

.entry-badge {
  display: inline-flex;
  margin-bottom: 8rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #16a34a;
  background: #e9f8ef;
  font-size: 21rpx;
  font-weight: 850;
}

.entry-title {
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.12;
  letter-spacing: 0;
}

.entry-subtitle {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #56645c;
  font-size: 22rpx;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.entry-mini-path {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  max-width: 300rpx;
  margin-top: 8rpx;
}

.entry-mini-path text {
  min-height: 34rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.15);
  border-radius: 999rpx;
  color: #174c3d;
  background: rgba(255, 255, 255, 0.82);
  font-size: 17rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  white-space: nowrap;
}

.entry-image {
  width: 132rpx;
  height: 132rpx;
  justify-self: end;
  overflow: hidden;
  border-radius: 30rpx;
  filter: drop-shadow(0 18rpx 24rpx rgba(47, 88, 58, 0.14));
}

.entry-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin: 8rpx 0;
}

.entry-primary,
.entry-secondary {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.2;
}

.entry-primary {
  color: #183023;
  background: linear-gradient(180deg, #ffd84d 0%, #f8c622 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.24);
}

.entry-secondary {
  border: 2rpx solid rgba(34, 185, 92, 0.22);
  color: #16a34a;
  background: #ffffff;
}

.entry-spotlight {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 108rpx;
  gap: 10rpx;
  margin-bottom: 8rpx;
  padding: 10rpx;
  overflow: hidden;
  border: 1rpx solid #e8eee6;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1fbf1 100%);
  box-shadow: 0 14rpx 32rpx rgba(32, 49, 39, 0.055);
}

.entry-spotlight.scene-report,
.entry-spotlight.scene-tutor {
  background: linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.entry-spotlight.scene-review {
  background: linear-gradient(135deg, #ffffff 0%, #fff8df 100%);
}

.entry-spotlight.scene-parent {
  background: linear-gradient(135deg, #ffffff 0%, #fff1ea 100%);
}

.entry-spotlight.scene-upload {
  background: linear-gradient(135deg, #ffffff 0%, #eefbed 100%);
}

.entry-spotlight-main {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.entry-spotlight-kicker {
  display: inline-flex;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d7a3d;
  background: rgba(34, 185, 92, 0.10);
  font-size: 19rpx;
  font-weight: 900;
}

.entry-spotlight.scene-report .entry-spotlight-kicker,
.entry-spotlight.scene-tutor .entry-spotlight-kicker {
  color: #2669ad;
  background: rgba(76, 159, 255, 0.12);
}

.entry-spotlight.scene-review .entry-spotlight-kicker {
  color: #8c6f1a;
  background: rgba(248, 198, 34, 0.18);
}

.entry-spotlight.scene-parent .entry-spotlight-kicker {
  color: #b6512f;
  background: rgba(255, 122, 69, 0.13);
}

.entry-spotlight-title {
  margin-top: 6rpx;
  color: #203127;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
}

.entry-spotlight-image {
  position: relative;
  z-index: 1;
  width: 100rpx;
  height: 100rpx;
  justify-self: end;
  align-self: center;
  filter: drop-shadow(0 14rpx 18rpx rgba(47, 88, 58, 0.12));
}

.entry-spotlight-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  margin-top: 8rpx;
}

.entry-spotlight-metrics view {
  min-width: 0;
  padding: 8rpx 6rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.11);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.entry-spotlight-metrics text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-spotlight-metrics text:first-child {
  color: #6c7970;
  font-size: 16rpx;
  font-weight: 760;
}

.entry-spotlight-metrics text:last-child {
  margin-top: 3rpx;
  color: #17211d;
  font-size: 21rpx;
  font-weight: 950;
}

.entry-spotlight-points {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
}

.entry-spotlight-points view {
  display: grid;
  grid-template-columns: 12rpx minmax(0, 1fr);
  gap: 7rpx;
  align-items: start;
  padding: 8rpx;
  border-radius: 18rpx;
  color: #455149;
  background: rgba(255, 255, 255, 0.72);
  font-size: 17rpx;
  font-weight: 760;
  line-height: 1.24;
}

.entry-spotlight-points text:first-child {
  width: 12rpx;
  height: 12rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: #22b95c;
}

.entry-card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7rpx;
}

.entry-card {
  position: relative;
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr) 24rpx;
  min-width: 0;
  min-height: 82rpx;
  align-items: center;
  justify-items: start;
  gap: 7rpx;
  padding: 7rpx;
  border: 1rpx solid #e8eee6;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(32, 49, 39, 0.045);
}

.entry-card:active {
  transform: translateY(1rpx);
  box-shadow: 0 8rpx 18rpx rgba(32, 49, 39, 0.04);
}

.entry-card-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #f8fbf5;
  box-shadow: 0 10rpx 18rpx rgba(34, 57, 43, 0.08);
}

.entry-card-label {
  overflow: hidden;
  color: #16a34a;
  font-size: 19rpx;
  font-weight: 950;
  line-height: 1.2;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-card-label::before {
  display: none;
}

.entry-card-value {
  display: -webkit-box;
  overflow: hidden;
  color: #455149;
  font-size: 17rpx;
  line-height: 1.25;
  text-align: left;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.entry-card-arrow {
  display: grid;
  width: 24rpx;
  height: 24rpx;
  place-items: center;
  justify-self: end;
  border-radius: 999rpx;
  color: #174c3d;
  background: #eaf9ef;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
}

.entry-proof-strip {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 5rpx;
  margin-top: 7rpx;
  padding: 4rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.9);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.055);
}

.entry-proof-node {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 50rpx;
  box-sizing: border-box;
  align-content: center;
  justify-items: center;
  gap: 2rpx;
  padding: 5rpx 3rpx;
  overflow: visible;
  border: 1rpx solid #e8eee6;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8faf5 100%);
  box-shadow: 0 12rpx 24rpx rgba(32, 49, 39, 0.05);
  line-height: 1.15;
}

.entry-proof-node::after {
  content: "";
  position: absolute;
  top: 50%;
  right: -11rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #dce8dc;
  transform: translateY(-50%);
}

.entry-proof-node:last-child::after {
  display: none;
}

.entry-proof-node.final {
  border-color: rgba(248, 198, 34, 0.34);
  background: linear-gradient(180deg, #fff8df 0%, #ffffff 100%);
}

.entry-proof-node.active {
  border-color: rgba(34, 185, 92, 0.34);
  background: linear-gradient(180deg, #eaf9ef 0%, #ffffff 100%);
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.12);
}

.entry-proof-icon {
  width: 22rpx;
  height: 22rpx;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #eef7ff;
}

.entry-proof-node.final .entry-proof-icon {
  background: #fff1bd;
}

.entry-proof-strip text {
  max-width: 100%;
  overflow: hidden;
  color: #17211d;
  font-size: 14rpx;
  font-weight: 950;
  line-height: 1.18;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-proof-hint {
  display: none;
  color: #6c7970 !important;
  font-size: 15rpx !important;
  font-weight: 760 !important;
}
