<view class="page safe-bottom profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-shell">
      <view class="yd-parent-screen yd-app-screen yd-parent-app">
        <view class="yd-parent-top">
          <view class="yd-parent-brand">
            <image class="yd-parent-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
            <view>
              <text>原点智学</text>
              <text>证据与下一步</text>
            </view>
          </view>
          <view class="yd-parent-pill">5 秒看懂</view>
        </view>

        <view class="yd-parent-hero">
          <view class="yd-parent-copy">
            <view class="yd-parent-kicker">今晚只看一个决策</view>
            <view class="yd-parent-title">{{profileViewModel.title}}</view>
            <view class="yd-parent-sub">把测评、成绩、错题和回访合成一张家长行动卡：先看证据，再问一句，明天再验证。</view>
          </view>
          <image class="yd-parent-art" mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
        </view>

        <view class="yd-parent-decision" data-scene="parent" bindtap="openEntryDetail">
          <image class="yd-parent-decision-img" mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" />
          <view class="yd-parent-decision-copy">
            <text>今晚结论</text>
            <text>先稳住一个真实卡点，让孩子说出第一步，明天用 90 秒复述验证。</text>
          </view>
          <view class="yd-parent-decision-badge">查看</view>
        </view>

        <view class="yd-parent-sources">
          <view class="yd-parent-section-head">
            <text>判断依据</text>
            <text>不靠感觉下结论</text>
          </view>
          <view class="yd-parent-source-row">
            <view data-scene="upload" bindtap="openEntryDetail"><image mode="aspectFit" src="/assets/reference/entry-upload.png" /><text>资料</text></view>
            <view data-scene="report" bindtap="openEntryDetail"><image mode="aspectFit" src="/assets/reference/entry-report.png" /><text>报告</text></view>
            <view data-scene="review" bindtap="openEntryDetail"><image mode="aspectFit" src="/assets/reference/entry-review.png" /><text>回访</text></view>
            <view data-scene="parent" bindtap="openEntryDetail"><image mode="aspectFit" src="/assets/reference/entry-parent.png" /><text>行动</text></view>
          </view>
        </view>

        <view class="yd-jump-grid">
          <view class="yd-jump-card primary parent-jump-card" data-scene="parent" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-parent.png" />
            <text>今晚安排</text>
            <text>看行动卡</text>
          </view>
          <view class="yd-jump-card parent-jump-card" data-scene="upload" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-upload.png" />
            <text>补充材料</text>
            <text>上传新证据</text>
          </view>
          <view class="yd-jump-card parent-jump-card" data-scene="review" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-review.png" />
            <text>复习回访</text>
            <text>验证是否迁移</text>
          </view>
        </view>

        <view class="yd-parent-methods">
          <view data-scene="tutor" bindtap="openEntryDetail">
            <text>费曼复述</text>
            <text>孩子用自己的话讲题意</text>
          </view>
          <view data-scene="tutor" bindtap="openEntryDetail">
            <text>苏格拉底追问</text>
            <text>只追问第一步和依据</text>
          </view>
          <view data-scene="review" bindtap="openEntryDetail">
            <text>间隔回访</text>
            <text>明天用 90 秒再验证</text>
          </view>
          <view data-scene="today" bindtap="openEntryDetail">
            <text>变式迁移</text>
            <text>换一个情境确认真会了</text>
          </view>
        </view>

        <view class="yd-parent-action-row">
          <view class="yd-action-primary parent-primary" data-scene="parent" bindtap="openEntryDetail">{{profileViewModel.primaryCta}}</view>
          <view class="yd-action-secondary parent-secondary" data-scene="upload" bindtap="openEntryDetail">补一份材料</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
