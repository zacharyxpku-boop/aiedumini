<view class="page safe-bottom profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-shell">
      <view class="yd-parent-screen yd-app-screen yd-parent-app">
        <view class="yd-parent-top">
          <view class="yd-parent-brand">
            <image class="yd-parent-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
            <view>
              <text>成长报告</text>
              <text>看懂孩子，再安排今天怎么学</text>
            </view>
          </view>
          <view class="yd-parent-pill">方法候选</view>
        </view>

        <view class="yd-parent-hero growth">
          <view class="yd-parent-copy">
            <view class="yd-parent-kicker">问卷 · 上传 · 报告</view>
            <view class="yd-parent-title">先了解孩子，再安排怎么学</view>
            <view class="yd-parent-sub">用问卷和材料沉淀学习线索；只做方法候选，不做天赋定论。</view>
          </view>
          <image class="yd-parent-art" mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" />
        </view>

        <view class="growth-choice-grid">
          <view class="growth-choice-card warm" bindtap="startGrowthQuestionnaire">
            <image mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
            <view>
              <text>做 1 分钟小问卷</text>
              <text>先了解学习偏好和卡点感受</text>
            </view>
            <text>开始</text>
          </view>
          <view class="growth-choice-card" data-action="upload" bindtap="runParentReportAction">
            <image mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" />
            <view>
              <text>上传错题/成绩/测评，生成成长报告</text>
              <text>把错因、成绩和反馈沉淀成证据</text>
            </view>
            <text>上传</text>
          </view>
        </view>

        <view class="growth-questionnaire-panel" wx:if="{{showLearningQuestionnaire}}">
          <view class="growth-questionnaire-head">
            <text>1 分钟学习问卷</text>
            <text bindtap="toggleLearningQuestionnaire">收起</text>
          </view>
          <view class="growth-question-card" wx:for="{{learningReportQuestionnaire}}" wx:key="id">
            <text>{{item.prompt}}</text>
            <view>
              <text wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="{{item.selectedOptionId === option.id ? 'active' : ''}}" data-id="{{item.id}}" data-option="{{option.id}}" bindtap="answerLearningQuestion">{{option.label}}</text>
            </view>
          </view>
          <view class="growth-generate-cta" bindtap="generateLearningReport">生成成长报告</view>
        </view>

        <view class="growth-signal-grid">
          <view>
            <text>错题记录</text>
            <text>{{learningReportSummary.uploadedMaterialDecisionDossierChildStrengthLine || '先上传一张真实错题或测评'}}</text>
          </view>
          <view>
            <text>卡点线索</text>
            <text>{{learningReportSummary.diagnosisLine || profileViewModel.parentRecap.evidenceRecap}}</text>
          </view>
          <view>
            <text>举一反三</text>
            <text>{{learningReportSummary.uploadedMaterialDecisionDossierMethodologyGuidePrimary || '用同类变形题继续验证'}}</text>
          </view>
          <view>
            <text>今晚建议</text>
            <text>{{profileViewModel.parentRecap.parentOneQuestion}}</text>
          </view>
        </view>

        <view class="yd-parent-decision growth" data-scene="parent" data-source="growth_report_card" bindtap="openEntryDetail">
          <image class="yd-parent-decision-img" mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
          <view class="yd-parent-decision-copy">
            <text>{{profileViewModel.familyDecisionCard.title}}</text>
            <text>{{profileViewModel.familyDecisionCard.parentQuestion}}</text>
          </view>
          <view class="yd-parent-decision-badge">{{profileViewModel.familyDecisionCard.ready ? '可执行' : '待材料'}}</view>
        </view>

        <view class="growth-action-row">
          <view class="yd-action-primary parent-primary" data-action="upload" bindtap="runParentReportAction">上传材料生成报告</view>
          <view class="yd-action-secondary parent-secondary" data-action="reportPreview" bindtap="runParentReportAction">查看最新报告</view>
        </view>

        <view class="growth-next-row">
          <view data-action="tutor" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/entry-tutor.png" /><text>去 AI私教修一个卡点</text></view>
          <view data-action="review" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/entry-review.png" /><text>去知识乐园练一局</text></view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
