<view class="page safe-bottom profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-shell">
      <view class="yd-parent-screen yd-app-screen yd-parent-app">
        <view class="yd-parent-top">
          <view class="yd-parent-brand"><image class="yd-parent-mark" mode="aspectFit" src="/assets/reference/brand-house.png" /><text class="yd-parent-brand-copy"><text>成长报告</text><text>看懂孩子，再安排怎么学</text></text></view>
          <text class="yd-parent-pill">方法候选</text>
        </view>

        <view class="yd-parent-hero growth">
          <text class="yd-parent-copy">
            <text class="yd-parent-kicker">问卷 · 上传 · 报告</text>
            <text class="yd-parent-title">先了解孩子，再安排怎么学</text>
            <text class="yd-parent-sub">可以先做 1 分钟问卷，也可以上传错题、成绩或测评。材料越多，报告越准；只做方法建议，不做天赋定论。</text>
          </text>
          <image class="yd-parent-art" mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" />
        </view>

        <view class="growth-choice-grid" wx:if="{{growthActiveScene === 'main'}}">
          <view class="growth-choice-card warm" bindtap="startGrowthQuestionnaire"><image mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" /><view><text>做 1 分钟小问卷</text><text>快速勾选，建立初像</text></view><text>开始</text></view>
          <view class="growth-choice-card" data-action="upload" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" /><view><text>上传错题/成绩/测评，生成成长报告</text><text>拍照上传，深度诊断</text></view><text>上传</text></view>
        </view>

        <view class="growth-flow-tabs" wx:if="{{growthActiveScene !== 'main'}}">
          <text class="{{growthActiveScene === 'main' ? 'active' : ''}}" data-panel="main" bindtap="setGrowthScene">成长报告</text>
          <text class="{{growthActiveScene === 'questionnaire' ? 'active' : ''}}" data-panel="questionnaire" bindtap="setGrowthScene">1 分钟问卷</text>
          <text class="{{growthActiveScene === 'upload' ? 'active' : ''}}" data-panel="upload" bindtap="setGrowthScene">上传材料</text>
          <text class="{{growthActiveScene === 'preview' ? 'active' : ''}}" data-panel="preview" bindtap="setGrowthScene">报告预览</text>
          <text class="{{growthActiveScene === 'action' ? 'active' : ''}}" data-panel="action" bindtap="setGrowthScene">行动卡</text>
        </view>

        <view class="growth-questionnaire-panel" wx:if="{{showLearningQuestionnaire}}">
          <view class="growth-questionnaire-head"><text>1分钟问卷 · 孩子最近最常卡在哪里？</text><text bindtap="toggleLearningQuestionnaire">收起</text></view>
          <view class="growth-questionnaire-progress"><text></text><text></text><text></text><text></text><text></text></view>
          <text class="growth-question-intro">选出最符合的一项，帮我们建立初步画像。</text>
          <view class="growth-question-card" data-contract="questionIndex === 0" wx:for="{{learningReportQuestionnaire}}" wx:for-index="questionIndex" wx:key="id" wx:if="{{questionIndex === growthQuestionIndex}}"><text>{{item.prompt}}</text><view><text wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="{{item.selectedOptionId === option.id ? 'active' : ''}}" data-id="{{item.id}}" data-option="{{option.id}}" bindtap="answerLearningQuestion">{{option.label}}</text></view></view>
          <text class="growth-question-note">后续上传错题、成绩或老师反馈后，报告会继续变准。</text>
          <view class="growth-action-row"><view class="yd-action-secondary" bindtap="nextGrowthQuestion">下一题</view><view class="yd-action-primary" bindtap="generateLearningReport">生成成长报告</view></view>
        </view>

        <view class="growth-progress-card" wx:if="{{growthActiveScene === 'main'}}">
          <text class="growth-progress-head"><text>报告生成进度</text><text>{{learningReportSummary.reportJobCaseId ? '已接入材料' : '待收集信息'}}</text></text>
          <view class="growth-progress-step done"><text></text><view><text>学习偏好线索</text><text>性格、习惯与抗挫力</text></view><text bindtap="startGrowthQuestionnaire">去收集</text></view>
          <view class="growth-progress-step active"><text></text><view><text>当前卡点证据</text><text>薄弱知识点与常见错误</text></view><text data-action="upload" bindtap="runParentReportAction">去上传</text></view>
          <view class="growth-progress-step"><text></text><view><text>今晚建议</text><text>基于分析生成专属方案</text></view><text>待生成</text></view>
        </view>

        <view class="growth-upload-panel" wx:if="{{growthActiveScene === 'upload'}}">
          <view class="growth-upload-head"><text>收集线索碎片</text><text>材料越真实，建议越具体。</text></view>
          <text class="growth-upload-lead">直接拍照或打字都可以，不必全部填满。</text>
          <view class="growth-upload-grid">
            <view class="growth-upload-card primary" data-action="upload" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" /><view><text>错题描述</text><text>记录孩子常卡住的题型。已添加 1 份：“昨天数学卷子大题第二问，总是列错方程...”</text></view><text>补充</text></view>
            <view class="growth-upload-card" data-action="upload" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" /><view><text>成绩/周测</text><text>把分数、错题分布和最近一次周测放进报告证据。</text></view><text>上传</text></view>
            <view class="growth-upload-card" data-action="upload" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/tutor-socratic-board-transparent.png" /><view><text>老师反馈</text><text>聊天截图、评语或老师提醒，帮助定位课堂里的真实卡点。</text></view><text>添加</text></view>
            <view class="growth-upload-card warm" bindtap="startGrowthQuestionnaire"><image mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" /><view><text>家长观察</text><text>用 1 分钟问卷记录孩子最近的状态、抗挫和学习习惯。</text></view><text>填写</text></view>
            <view class="growth-upload-card" data-action="upload" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/learning-route-map-transparent.png" /><view><text>测评摘要</text><text>导入以往测评或诊断摘要，和错题记录一起生成培养建议。</text></view><text>导入</text></view>
          </view>
          <view class="growth-unlock-strip"><text>生成报告后，将解锁：</text><text>专属学习偏好 · 如：视觉型</text><text>深层卡点定位 · 如：工作记忆瓶颈</text><text>今晚行动建议 · 如：睡前花 5 分钟</text></view>
          <text class="growth-generate-cta" bindtap="generateLearningReport">生成成长报告</text>
        </view>

        <view class="growth-signal-grid" wx:if="{{growthActiveScene === 'preview' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}">
          <view><text>错题记录</text><text>{{learningReportSummary.uploadedMaterialDecisionDossierChildStrengthLine || '先上传一张真实错题或测评。'}}</text></view>
          <view><text>卡点线索</text><text>{{learningReportSummary.diagnosisLine || profileViewModel.parentRecap.evidenceRecap}}</text></view>
          <view><text>举一反三</text><text>{{learningReportSummary.uploadedMaterialDecisionDossierMethodologyGuidePrimary || '用同类变形题继续验证。'}}</text></view>
          <view><text>今晚建议</text><text>{{profileViewModel.parentRecap.parentOneQuestion}}</text></view>
        </view>

        <view class="growth-report-preview" wx:if="{{growthActiveScene === 'preview' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}">
          <view class="growth-report-preview-head"><text>成长线索初步发现</text><text>{{learningReportSummary.reportJobCaseId ? '初步报告 · 基于材料' : '本地预览'}}</text></view>
          <text class="growth-report-lead">我们从碎片中拼凑出了孩子的学习画像。</text>
          <view class="growth-report-preview-card"><text>学习偏好线索 · 视觉型</text><text>来源：基础问卷。{{learningReportSummary.learningPreferenceLine || '孩子对图像、表格的敏感度高于纯文字，建议讲抽象概念时使用手绘图或实物辅助。'}}</text></view>
          <view class="growth-report-preview-card warn"><text>当前卡点证据 · 计算粗心</text><text>来源：错题描述。{{learningReportSummary.diagnosisLine || '错题集中在最后一步进位，可能是基础计算熟练度不足导致的工作记忆瓶颈。'}}</text></view>
          <view class="growth-report-preview-card action"><text>今晚建议 · 先练口算10分钟</text><text>来源：AI私教。在正式作业前先做短热身，降低后续大题笔误率。</text></view>
          <text class="growth-report-more">想要更精准的画像？再补充一点信息吧。</text>
          <view class="growth-report-actions"><text data-action="upload" bindtap="runParentReportAction">补充材料让报告更准</text><text data-action="tutor" bindtap="runParentReportAction">去AI私教</text><text data-action="review" bindtap="runParentReportAction">知识乐园</text></view>
        </view>

        <view class="growth-parent-action-card" wx:if="{{growthActiveScene === 'preview' || growthActiveScene === 'action' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}">
          <view class="growth-parent-action-head"><text>今晚行动卡 · 今晚行动指南</text><text>不替孩子学习，只提供更好的土壤</text></view>
          <view><text></text><view><text>建立自信 · 预计 2 分钟</text><text>正向具体表扬：“我看到你虽然算错了，但依然耐心把草稿写整齐，这种态度很棒。”</text></view></view>
          <view><text></text><view><text>环境优化 · 持续进行</text><text>清空桌面非学习用品；对视觉型孩子，清爽空间能降低分心。</text></view></view>
          <view><text></text><view><text>激发思考 · 预计 5 分钟</text><text>只问问题，不讲答案：“你觉得这一步和上一步的关系是什么？”</text></view></view>
          <text class="growth-action-done">完成勾选后，系统将为您更新明日建议 · 我已完成行动 / 稍后提醒</text>
        </view>

        <view class="yd-parent-decision growth" wx:if="{{growthActiveScene === 'preview' || growthActiveScene === 'action' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}" data-scene="parent" data-source="growth_report_card" bindtap="openEntryDetail"><image class="yd-parent-decision-img" mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" /><view class="yd-parent-decision-copy"><text>{{profileViewModel.familyDecisionCard.title}}</text><text>{{profileViewModel.familyDecisionCard.parentQuestion}}</text></view><view class="yd-parent-decision-badge">{{profileViewModel.familyDecisionCard.ready ? '可执行' : '待材料'}}</view></view>

        <view class="growth-action-row" wx:if="{{growthActiveScene === 'preview' || growthActiveScene === 'action' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}"><view class="yd-action-primary parent-primary" data-action="upload" bindtap="runParentReportAction">上传材料生成报告</view><view class="yd-action-secondary parent-secondary" data-action="reportPreview" bindtap="runParentReportAction">查看最新报告</view></view>
        <view class="growth-next-row" wx:if="{{growthActiveScene === 'preview' || growthActiveScene === 'action' || (learningReportSummary && learningReportSummary.reportJobCaseId)}}"><view data-action="tutor" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/entry-tutor.png" /><text>去AI私教修一个卡点</text></view><view data-action="review" bindtap="runParentReportAction"><image mode="aspectFit" src="/assets/reference/entry-review.png" /><text>去知识乐园练一局</text></view></view>
        <view class="growth-main-cta" wx:if="{{growthActiveScene === 'main'}}" bindtap="startGrowthQuestionnaire">开始了解孩子</view>
      </view>
    </view>
  </scroll-view>
</view>
