<view class="page safe-bottom profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-shell">
      <view class="yd-parent-screen yd-app-screen yd-parent-app">
        <view class="yd-parent-top">
          <view class="yd-parent-brand">
            <image class="yd-parent-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
            <view>
              <text>原点智学</text>
              <text>家长复盘中心</text>
            </view>
          </view>
          <view class="yd-parent-pill">每日复盘</view>
        </view>

        <view class="yd-parent-hero">
          <view class="yd-parent-copy">
            <view class="yd-parent-kicker">给家长看的证据和下一步</view>
            <view class="yd-parent-title">今晚孩子卡在哪，家长该问哪一句？</view>
            <view class="yd-parent-sub">这里不让家长重新学习一遍题目，只把证据、第一步和明天验证收成一张复盘卡。</view>
          </view>
          <image class="yd-parent-art" mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
        </view>

        <view class="yd-parent-decision" data-scene="parent" bindtap="openEntryDetail">
          <image class="yd-parent-decision-img" mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" />
          <view class="yd-parent-decision-copy">
            <text>今晚结论</text>
            <text>{{profileViewModel.parentRecap.firstStepLine}}</text>
          </view>
          <view class="yd-parent-decision-badge">查看</view>
        </view>

        <view class="yd-parent-task-head">
          <text>家长今晚只做这三步</text>
          <text>不重学题，只看证据、问一句、明天回看。</text>
        </view>

        <view class="yd-parent-loop">
          <view class="yd-parent-loop-card primary" data-scene="parent" bindtap="openEntryDetail">
            <image mode="aspectFit" src="/assets/reference/entry-parent.png" />
            <view>
              <text>1 看证据</text>
              <text>{{profileViewModel.parentRecap.tonightRecap}}</text>
            </view>
          </view>
          <view class="yd-parent-loop-card" data-scene="parent" bindtap="openEntryDetail">
            <image mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" />
            <view>
              <text>2 只问一句</text>
              <text>{{profileViewModel.parentRecap.parentOneQuestion}}</text>
            </view>
          </view>
          <view class="yd-parent-loop-card final" data-scene="parent" bindtap="openEntryDetail">
            <image mode="aspectFit" src="/assets/reference/learning-route-map-transparent.png" />
            <view>
              <text>3 明天再看</text>
              <text>{{profileViewModel.parentRecap.trustBoundaryNote}}</text>
            </view>
          </view>
        </view>

        <view class="yd-parent-action-row">
          <view class="yd-action-primary parent-primary" bindtap="goLearningReportCta">{{profileViewModel.primaryCta}}</view>
          <view class="yd-action-secondary parent-secondary" data-action="reportPreview" bindtap="runParentReportAction">看证据详情</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
