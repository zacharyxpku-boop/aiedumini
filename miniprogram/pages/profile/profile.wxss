page {
  background: #f9f8f4;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1f2933;
  background: #f9f8f4;
}

.profile-scroll {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  height: auto;
}

.profile-shell {
  position: relative;
  z-index: 2;
  padding: calc(96rpx + env(safe-area-inset-top)) 28rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: auto;
}

.yd-parent-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  min-height: auto;
  margin: 0;
  padding: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 9% 3%, rgba(248, 198, 34, 0.18), transparent 24%),
    radial-gradient(circle at 92% 12%, rgba(76, 159, 255, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-parent-top,
.yd-parent-brand,
.yd-parent-section-head,
.yd-parent-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-parent-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-parent-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  background: #ebf9ed;
  box-shadow: 0 14rpx 26rpx rgba(34, 185, 92, 0.24);
}

.yd-parent-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-parent-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-parent-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-parent-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 124rpx;
  gap: 12rpx;
  align-items: center;
  min-height: 148rpx;
  margin-top: 12rpx;
}

.yd-parent-kicker {
  width: max-content;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #9a6b00;
  background: #fff4c9;
  font-size: 19rpx;
  font-weight: 900;
}

.yd-parent-title {
  margin-top: 7rpx;
  color: #101a16;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.09;
  letter-spacing: 0;
}

.yd-parent-sub {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 20rpx;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-art {
  width: 124rpx;
  height: 116rpx;
  border-radius: 26rpx;
  background: #fff1ea;
}

.yd-parent-decision,
.yd-parent-sources {
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.yd-parent-decision {
  display: grid;
  grid-template-columns: 78rpx minmax(0, 1fr) auto;
  gap: 8rpx;
  align-items: center;
  margin-top: 10rpx;
  padding: 10rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(248, 198, 34, 0.16), transparent 36%),
    linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-decision-img {
  width: 78rpx;
  height: 62rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 18rpx;
  background: #edf8ff;
}

.yd-parent-decision-copy {
  min-width: 0;
}

.yd-parent-decision-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-decision-copy text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.yd-parent-decision-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 6rpx;
  color: #66756d;
  font-size: 18rpx;
  font-weight: 760;
  line-height: 1.24;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-decision-badge {
  flex: 0 0 auto;
  padding: 9rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 999rpx;
  color: #0f7b43;
  background: #ffffff;
  font-size: 19rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-sources {
  margin-top: 10rpx;
  padding: 10rpx;
}

.yd-parent-section-head text:first-child {
  color: #18211d;
  font-size: 24rpx;
  font-weight: 950;
}

.yd-parent-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  white-space: nowrap;
}

.yd-parent-source-row,
.yd-parent-methods {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 7rpx;
  margin-top: 8rpx;
}

.yd-parent-source-row view {
  display: grid;
  min-width: 0;
  justify-items: center;
  gap: 4rpx;
  padding: 7rpx 3rpx;
  border-radius: 17rpx;
  background: #f8fbf3;
}

.yd-parent-source-row view:active {
  transform: translateY(1rpx);
  background: #effaf0;
}

.yd-parent-source-row image {
  width: 30rpx;
  height: 30rpx;
}

.yd-parent-source-row text {
  display: block;
  overflow: hidden;
  color: #174533;
  font-size: 20rpx;
  font-weight: 900;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-screen .yd-jump-grid {
  gap: 8rpx;
  margin-top: 10rpx;
}

.parent-jump-card {
  min-height: 96rpx;
  padding: 9rpx 7rpx;
  background:
    radial-gradient(circle at 82% 18%, rgba(248, 198, 34, 0.18), transparent 32%),
    #ffffff;
}

.parent-jump-card image {
  width: 56rpx;
  height: 48rpx;
}

.yd-parent-methods {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 9rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #ecf9ed;
}

.yd-parent-methods view {
  display: grid;
  min-width: 0;
  gap: 4rpx;
  padding: 9rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.88);
}

.yd-parent-methods view:active {
  transform: translateY(1rpx);
  background: #ffffff;
}

.yd-parent-methods text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-methods text:first-child {
  color: #17211d;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-methods text:nth-child(2) {
  display: -webkit-box;
  color: #66746d;
  font-size: 17rpx;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-action-row {
  margin-top: 10rpx;
  padding-top: 0;
}

.parent-primary,
.parent-secondary {
  flex: 1 1 0;
  margin-top: 0;
}
