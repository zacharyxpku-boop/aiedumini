page {
  background: #f8faf5;
}

.profile-page {
  min-height: 100vh;
  background: #f8faf5;
  color: #1f2937;
}

.profile-scroll {
  min-height: 100vh;
}

.profile-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-parent-screen {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 40rpx calc(172rpx + env(safe-area-inset-bottom));
  background: #f8faf5;
  border-radius: 0;
}

.yd-parent-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-parent-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-height: 68rpx;
}

.yd-parent-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  opacity: 0;
  pointer-events: none;
}

.yd-parent-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-parent-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-parent-brand-copy text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.yd-parent-brand-copy text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-pill {
  flex: 0 0 auto;
  width: 168rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: transparent;
  font-size: 0;
  line-height: 64rpx;
  font-weight: 800;
  box-shadow: none;
}

.yd-parent-pill::before,
.yd-parent-pill::after {
  content: "";
  display: inline-block;
  vertical-align: middle;
}

.yd-parent-pill::before {
  width: 52rpx;
  height: 8rpx;
  border-top: 6rpx solid #111827;
  border-bottom: 6rpx solid #111827;
  opacity: 0.78;
}

.yd-parent-pill::after {
  width: 1rpx;
  height: 32rpx;
  margin-left: 28rpx;
  padding-left: 28rpx;
  border-left: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 50%;
  background: #111827;
  opacity: 0.78;
}

.yd-parent-hero {
  position: relative;
  display: block;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 0 22rpx;
  padding: 6rpx 0 0;
  border-radius: 0;
  background: #f8faf5;
  box-shadow: none;
}

.yd-parent-hero.growth {
  background:
    radial-gradient(circle at 84% 0%, rgba(254, 243, 199, 0.74), transparent 23%),
    radial-gradient(circle at 6% 58%, rgba(230, 244, 241, 0.74), transparent 26%),
    #f8faf5;
}

.yd-parent-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.yd-parent-kicker {
  display: none;
}

.yd-parent-title {
  max-width: 540rpx;
  color: #1f2937;
  font-size: 56rpx;
  line-height: 73rpx;
  font-weight: 950;
}

.yd-parent-sub {
  max-width: 560rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 720;
}

.yd-parent-art {
  position: absolute;
  right: 14rpx;
  bottom: 2rpx;
  width: 142rpx;
  height: 132rpx;
  object-fit: contain;
  opacity: 0.18;
}

.growth-choice-grid,
.growth-signal-grid,
.growth-action-row,
.growth-next-row,
.growth-report-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.growth-signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-choice-card {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    "icon"
    "copy";
  align-content: space-between;
  gap: 12rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 237, 213, 0.9);
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.growth-choice-card.warm {
  background: #ffffff;
  border-color: rgba(255, 237, 213, 0.95);
}

.growth-choice-card image {
  grid-area: icon;
  width: 80rpx;
  height: 80rpx;
  object-fit: contain;
  padding: 10rpx;
  border-radius: 50%;
  background: #fff7ed;
}

.growth-choice-card:not(.warm) image {
  background: #e6f4f1;
}

.growth-choice-card view {
  grid-area: copy;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.growth-choice-card view text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 950;
}

.growth-choice-card view text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-choice-card > text {
  display: none;
}

.growth-flow-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.growth-flow-tabs text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  border-radius: 15rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.growth-flow-tabs text.active {
  background: #ffffff;
  color: #0d9488;
  box-shadow: 0 6rpx 16rpx rgba(120, 83, 34, 0.1);
}

.growth-progress-card,
.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card,
.yd-parent-decision {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.065);
}

.growth-progress-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 0 0 44rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.growth-progress-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #1f2937;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.growth-progress-head text:last-child {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 20rpx;
  font-weight: 800;
}

.growth-progress-step {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f9fafb;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.035);
}

.growth-progress-step::before {
  content: "";
  position: absolute;
  left: -28rpx;
  top: -26rpx;
  width: 4rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
}

.growth-progress-step:first-of-type::before {
  display: none;
}

.growth-progress-step > text:first-child {
  position: absolute;
  left: -42rpx;
  top: 28rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 4rpx solid #fed7aa;
  border-radius: 999rpx;
  background: #ffffff;
}

.growth-progress-step.done > text:first-child,
.growth-progress-step.active > text:first-child {
  border-color: #99f6e4;
  background: #14b8a6;
  box-shadow: none;
}

.growth-progress-step view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.growth-progress-step view text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-progress-step view text:last-child {
  color: #64748b;
  font-size: 21rpx;
  line-height: 27rpx;
}

.growth-progress-step > text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #f59e0b;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary,
.yd-action-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary {
  background: #fbbf24;
  color: #78350f;
  box-shadow: 0 12rpx 30rpx rgba(251, 191, 36, 0.28);
}

.yd-action-secondary {
  border: 2rpx solid #ccfbf1;
  background: #ffffff;
  color: #0d9488;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #f0ebe1;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  min-height: 620rpx;
  justify-content: center;
}

.growth-questionnaire-head,
.growth-upload-head,
.growth-report-preview-head,
.growth-parent-action-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.growth-questionnaire-head text:first-child,
.growth-upload-head text:first-child,
.growth-report-preview-head text:first-child,
.growth-parent-action-head text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.growth-questionnaire-head text:last-child,
.growth-upload-head text:last-child,
.growth-report-preview-head text:last-child,
.growth-parent-action-head text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: right;
}

.growth-questionnaire-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.growth-questionnaire-progress text {
  height: 10rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
}

.growth-questionnaire-progress text:first-child {
  background: #14b8a6;
}

.growth-question-intro,
.growth-question-note,
.growth-upload-lead,
.growth-report-lead,
.growth-report-more,
.growth-action-done {
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.growth-question-card {
  display: grid;
  gap: 20rpx;
  padding: 10rpx 0 4rpx;
}

.growth-question-card > text {
  color: #1e293b;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.growth-question-option {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 224rpx;
  box-sizing: border-box;
  padding: 28rpx 18rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.055);
}

.growth-question-option-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ccfbf1;
}

.growth-question-option:nth-child(2) .growth-question-option-icon {
  background: #ffe4e6;
}

.growth-question-option:nth-child(3) .growth-question-option-icon {
  background: #fef3c7;
}

.growth-question-option:nth-child(4) .growth-question-option-icon {
  background: #dbeafe;
}

.growth-question-option:nth-child(5) .growth-question-option-icon {
  background: #ede9fe;
}

.growth-question-option:nth-child(6) .growth-question-option-icon {
  background: #f3f4f6;
}

.growth-question-option-label {
  color: #1e293b;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-option-check {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  display: none;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-question-option.active {
  border-color: #14b8a6;
  background: #f0fdfa;
  box-shadow: 0 14rpx 30rpx rgba(20, 184, 166, 0.14);
}

.growth-question-option.active .growth-question-option-label {
  color: #0d9488;
}

.growth-question-option.active .growth-question-option-check {
  display: flex;
}

.growth-upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.growth-upload-card {
  position: relative;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 14rpx;
  min-height: 188rpx;
  box-sizing: border-box;
  padding: 26rpx 20rpx;
  overflow: hidden;
  border: 4rpx dashed #e5e7eb;
  border-radius: 48rpx;
  background: #ffffff;
  text-align: center;
}

.growth-upload-card.primary {
  grid-column: 1 / -1;
  justify-items: stretch;
  min-height: 204rpx;
  background: #e6f4f1;
  border: 2rpx solid rgba(20, 184, 166, 0.4);
  text-align: left;
}

.growth-upload-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 0 48rpx 0 80rpx;
  background: rgba(20, 184, 166, 0.06);
}

.growth-upload-title-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr) auto;
  gap: 20rpx;
  align-items: start;
}

.growth-upload-card.primary .growth-upload-title-row image,
.growth-upload-card.primary > image {
  width: 88rpx;
  height: 88rpx;
  padding: 10rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.08);
}

.growth-upload-title-row view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.growth-upload-title-row view text:first-child {
  color: #0f766e;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 950;
}

.growth-upload-title-row view text:last-child {
  color: rgba(15, 118, 110, 0.7);
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-upload-added {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(20, 184, 166, 0.24);
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
}

.growth-upload-sample {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  padding: 18rpx;
  border: 1rpx solid #ffffff;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #4b5563;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.growth-upload-card:not(.primary) image {
  width: 84rpx;
  height: 84rpx;
  padding: 10rpx;
  border-radius: 36rpx;
  background: #eff6ff;
}

.growth-upload-card.teal image {
  background: #ccfbf1;
}

.growth-upload-card.warm image {
  background: #ffedd5;
}

.growth-upload-card.purple image {
  background: #ede9fe;
}

.growth-upload-card:not(.primary) view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.growth-upload-card:not(.primary) view text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-upload-card:not(.primary) view text:nth-child(2) {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 26rpx;
}

.growth-upload-plus {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #f9fafb;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.growth-unlock-strip {
  display: grid;
  gap: 18rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.growth-unlock-strip > text {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-unlock-strip view {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  min-height: 92rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.045);
}

.growth-unlock-strip view::before {
  content: "";
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: #eef2ff;
}

.growth-unlock-strip view:nth-of-type(2)::before {
  background: #fce7f3;
}

.growth-unlock-strip view:nth-of-type(3)::before {
  background: #ffedd5;
}

.growth-unlock-strip view text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.growth-unlock-strip view text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-signal-grid view,
.growth-report-preview-card {
  position: relative;
  display: grid;
  gap: 22rpx;
  padding: 40rpx;
  overflow: hidden;
  border: 1rpx solid #f3f4f6;
  border-radius: 56rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(15, 23, 42, 0.065);
}

.growth-report-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 192rpx;
  height: 192rpx;
  border-radius: 0 56rpx 0 120rpx;
  background: rgba(99, 102, 241, 0.08);
}

.growth-report-preview-card.warn .growth-report-corner {
  background: rgba(236, 72, 153, 0.08);
}

.growth-report-preview-card.action .growth-report-corner {
  background: rgba(251, 191, 36, 0.18);
}

.growth-report-card-head {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
}

.growth-report-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #eef2ff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
}

.growth-report-preview-card.warn .growth-report-icon {
  background: #fce7f3;
}

.growth-report-preview-card.action .growth-report-icon {
  background: #fef3c7;
}

.growth-report-card-head view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.growth-report-card-head view > text:first-child {
  color: #1f2937;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.growth-report-card-head view > text:last-child {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.growth-report-card-head view > text:last-child text:first-child {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.growth-report-preview-card.warn .growth-report-card-head view > text:last-child text:first-child {
  background: #fce7f3;
  color: #db2777;
}

.growth-report-preview-card.action .growth-report-card-head view > text:last-child text:first-child {
  background: #fef3c7;
  color: #b45309;
}

.growth-report-card-head view > text:last-child text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-signal-grid text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.growth-report-body {
  position: relative;
  z-index: 1;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
}

.growth-report-actions {
  grid-template-columns: 1fr 1fr;
  padding: 28rpx 0 0;
  border-top: 1rpx solid #f3f4f6;
}

.growth-report-actions text,
.growth-next-row view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #1f2937;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
  text-align: center;
}

.growth-report-actions text:first-child {
  grid-column: 1 / -1;
  border: 4rpx dashed rgba(20, 184, 166, 0.38);
  background: #ffffff;
  color: #0f766e;
}

.growth-report-actions text:nth-child(2) {
  background: #14b8a6;
  color: #ffffff;
}

.growth-report-actions text:nth-child(3) {
  background: #fbbf24;
  color: #78350f;
}

.growth-parent-action-card > .growth-parent-action-item {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 28rpx;
  align-items: start;
  padding: 40rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 56rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 34rpx rgba(15, 23, 42, 0.065);
}

.growth-parent-action-card > .growth-parent-action-item > text {
  width: 48rpx;
  height: 48rpx;
  margin-top: 4rpx;
  border: 4rpx solid rgba(20, 184, 166, 0.3);
  border-radius: 14rpx;
  box-sizing: border-box;
}

.growth-parent-action-card .growth-parent-action-item view {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child text:first-child {
  padding: 5rpx 16rpx;
  border-radius: 10rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.growth-parent-action-card .growth-parent-action-item.warm view > text:first-child text:first-child {
  background: #ffedd5;
  color: #c2410c;
}

.growth-parent-action-card .growth-parent-action-item.indigo view > text:first-child text:first-child {
  background: #eef2ff;
  color: #4f46e5;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-parent-action-card .growth-parent-action-item view > text:nth-child(2) {
  color: #1f2937;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.growth-parent-action-card .growth-parent-action-item view > text:nth-child(3) {
  color: #64748b;
  font-size: 28rpx;
  line-height: 40rpx;
}

.growth-parent-bottom-actions {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 18rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f3f4f6;
}

.growth-parent-bottom-actions text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  border-radius: 40rpx;
  color: #ffffff;
  background: #14b8a6;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-parent-bottom-actions text:last-child {
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  color: #1f2937;
}

.yd-parent-decision.growth {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
}

.yd-parent-decision-img {
  width: 104rpx;
  height: 84rpx;
  object-fit: contain;
}

.yd-parent-decision-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.yd-parent-decision-copy text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.yd-parent-decision-copy text:last-child {
  display: -webkit-box;
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.yd-parent-decision-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ccfbf1;
  color: #0d9488;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-next-row view {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  justify-content: stretch;
  text-align: left;
}

.growth-next-row image {
  width: 46rpx;
  height: 46rpx;
}

.growth-next-row text {
  color: #1f2937;
  font-size: 23rpx;
  line-height: 29rpx;
  font-weight: 900;
}
