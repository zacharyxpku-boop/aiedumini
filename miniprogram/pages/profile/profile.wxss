page {
  background: #f9f8f4;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1f2933;
  background: #f9f8f4;
}

.profile-scroll {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  height: auto;
}

.profile-shell {
  position: relative;
  z-index: 2;
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-parent-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 16rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  margin: 0;
  padding: 22rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 9% 3%, rgba(248, 198, 34, 0.18), transparent 24%),
    radial-gradient(circle at 92% 12%, rgba(76, 159, 255, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-parent-top,
.yd-parent-brand,
.yd-parent-section-head,
.yd-parent-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-parent-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-parent-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  background: #ebf9ed;
  box-shadow: 0 14rpx 26rpx rgba(34, 185, 92, 0.24);
}

.yd-parent-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-parent-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-parent-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-parent-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 184rpx;
  gap: 18rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 242rpx;
  margin-top: 0;
}

.yd-parent-kicker {
  width: max-content;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #9a6b00;
  background: #fff4c9;
  font-size: 20rpx;
  font-weight: 900;
}

.yd-parent-title {
  margin-top: 7rpx;
  color: #101a16;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.16;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-parent-sub {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 24rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.yd-parent-art {
  width: 178rpx;
  height: 166rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff1ea;
}

.yd-parent-decision {
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.yd-parent-decision {
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  margin-top: 0;
  padding: 16rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(248, 198, 34, 0.16), transparent 36%),
    linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-decision-img {
  width: 104rpx;
  height: 84rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 18rpx;
  background: #edf8ff;
}

.yd-parent-decision-copy {
  min-width: 0;
}

.yd-parent-decision-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-decision-copy text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
  white-space: normal;
  -webkit-line-clamp: 2;
}

.yd-parent-decision-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 6rpx;
  color: #66756d;
  font-size: 20rpx;
  font-weight: 760;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-decision-badge {
  flex: 0 0 auto;
  padding: 9rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 999rpx;
  color: #0f7b43;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-section-head text:first-child {
  color: #18211d;
  font-size: 24rpx;
  font-weight: 950;
}

.yd-parent-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  white-space: normal;
  text-align: right;
}

.yd-parent-loop {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.yd-parent-loop {
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: repeat(3, minmax(148rpx, auto));
  flex: 1 1 auto;
  margin-top: 0;
  gap: 12rpx;
}

.yd-parent-loop-card {
  display: flex;
  min-width: 0;
  min-height: 190rpx;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
}

.yd-parent-loop-card:active {
  transform: translateY(1rpx);
  background: #ffffff;
}

.yd-parent-loop-card.primary {
  background: linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-loop-card.final {
  background: #fff8df;
}

.yd-parent-loop-card image {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  object-fit: contain;
}

.yd-parent-loop-card view {
  min-width: 0;
}

.yd-parent-loop-card text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-loop-card text:first-child {
  color: #17211d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: normal;
}

.yd-parent-loop-card text:nth-child(2) {
  display: -webkit-box;
  margin-top: 4rpx;
  color: #66746d;
  font-size: 22rpx;
  font-weight: 780;
  line-height: 1.32;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-action-row {
  position: sticky;
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  z-index: 4;
  margin-top: 10rpx;
  padding-top: 0;
  padding-bottom: 2rpx;
}

.parent-primary,
.parent-secondary {
  flex: 1 1 0;
  min-width: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
  margin-top: 0;
}
