page {
  background: #f8faf5;
}

.profile-page {
  min-height: 100vh;
  background: #f8faf5;
  color: #1f2937;
}

.profile-scroll {
  min-height: 100vh;
}

.profile-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-parent-screen {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 40rpx calc(172rpx + env(safe-area-inset-bottom));
  background: #f8faf5;
  border-radius: 0;
}

.yd-parent-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-parent-top {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-height: 68rpx;
}

.yd-parent-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  opacity: 0;
  pointer-events: none;
}

.yd-parent-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-parent-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-parent-brand-copy text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.yd-parent-brand-copy text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-pill {
  flex: 0 0 auto;
  width: 168rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: transparent;
  font-size: 0;
  line-height: 64rpx;
  font-weight: 800;
  box-shadow: none;
}

.yd-parent-pill::before,
.yd-parent-pill::after {
  content: "";
  display: inline-block;
  vertical-align: middle;
}

.yd-parent-pill::before {
  width: 52rpx;
  height: 8rpx;
  border-top: 6rpx solid #111827;
  border-bottom: 6rpx solid #111827;
  opacity: 0.78;
}

.yd-parent-pill::after {
  width: 1rpx;
  height: 32rpx;
  margin-left: 28rpx;
  padding-left: 28rpx;
  border-left: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 50%;
  background: #111827;
  opacity: 0.78;
}

.yd-parent-hero {
  position: relative;
  display: block;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 0 32rpx;
  padding: 6rpx 0 0;
  border-radius: 0;
  background: #f8faf5;
  box-shadow: none;
}

.yd-parent-hero.growth {
  background:
    radial-gradient(circle at 84% 0%, rgba(254, 243, 199, 0.74), transparent 23%),
    radial-gradient(circle at 6% 58%, rgba(230, 244, 241, 0.74), transparent 26%),
    #f8faf5;
}

.yd-parent-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.yd-parent-kicker {
  display: none;
}

.yd-parent-title {
  max-width: 540rpx;
  color: #1f2937;
  font-size: 56rpx;
  line-height: 73rpx;
  font-weight: 950;
}

.yd-parent-sub {
  max-width: 560rpx;
  color: #475569;
  font-size: 26rpx;
  line-height: 39rpx;
  font-weight: 720;
}

.yd-parent-art {
  position: absolute;
  right: 14rpx;
  bottom: 2rpx;
  width: 142rpx;
  height: 132rpx;
  object-fit: contain;
  opacity: 0.18;
}

.growth-choice-grid,
.growth-signal-grid,
.growth-action-row,
.growth-next-row,
.growth-report-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.growth-signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-choice-card {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-areas:
    "icon"
    "copy";
  align-content: space-between;
  gap: 12rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 237, 213, 0.9);
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.growth-choice-card.warm {
  background: #ffffff;
  border-color: rgba(255, 237, 213, 0.95);
}

.growth-choice-card image {
  grid-area: icon;
  width: 80rpx;
  height: 80rpx;
  object-fit: contain;
  padding: 10rpx;
  border-radius: 50%;
  background: #fff7ed;
}

.growth-choice-card:not(.warm) image {
  background: #e6f4f1;
}

.growth-choice-card view {
  grid-area: copy;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.growth-choice-card view text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 950;
}

.growth-choice-card view text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-choice-card > text {
  display: none;
}

.growth-flow-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.growth-flow-tabs text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  border-radius: 15rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.growth-flow-tabs text.active {
  background: #ffffff;
  color: #0d9488;
  box-shadow: 0 6rpx 16rpx rgba(120, 83, 34, 0.1);
}

.growth-progress-card,
.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card,
.yd-parent-decision {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.065);
}

.growth-progress-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 0 0 44rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.growth-progress-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-progress-head text:last-child {
  color: #0d9488;
  font-size: 22rpx;
  font-weight: 800;
}

.growth-progress-step {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f9fafb;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.035);
}

.growth-progress-step::before {
  content: "";
  position: absolute;
  left: -28rpx;
  top: -26rpx;
  width: 4rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
}

.growth-progress-step:first-of-type::before {
  display: none;
}

.growth-progress-step > text:first-child {
  position: absolute;
  left: -42rpx;
  top: 28rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 4rpx solid #fed7aa;
  border-radius: 999rpx;
  background: #ffffff;
}

.growth-progress-step.done > text:first-child,
.growth-progress-step.active > text:first-child {
  border-color: #99f6e4;
  background: #14b8a6;
  box-shadow: none;
}

.growth-progress-step view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.growth-progress-step view text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-progress-step view text:last-child {
  color: #64748b;
  font-size: 21rpx;
  line-height: 27rpx;
}

.growth-progress-step > text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #f59e0b;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary,
.yd-action-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary {
  background: #14b8a6;
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(20, 184, 166, 0.24);
}

.yd-action-secondary {
  border: 2rpx solid #ccfbf1;
  background: #ffffff;
  color: #0d9488;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #f0ebe1;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  min-height: 620rpx;
  justify-content: center;
}

.growth-questionnaire-head,
.growth-upload-head,
.growth-report-preview-head,
.growth-parent-action-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.growth-questionnaire-head text:first-child,
.growth-upload-head text:first-child,
.growth-report-preview-head text:first-child,
.growth-parent-action-head text:first-child {
  color: #1f2937;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.growth-questionnaire-head text:last-child,
.growth-upload-head text:last-child,
.growth-report-preview-head text:last-child,
.growth-parent-action-head text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: right;
}

.growth-questionnaire-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.growth-questionnaire-progress text {
  height: 10rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
}

.growth-questionnaire-progress text:first-child {
  background: #14b8a6;
}

.growth-question-intro,
.growth-question-note,
.growth-upload-lead,
.growth-report-lead,
.growth-report-more,
.growth-action-done {
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.growth-question-card {
  display: grid;
  gap: 20rpx;
  padding: 10rpx 0 4rpx;
}

.growth-question-card > text {
  color: #1e293b;
  font-size: 52rpx;
  line-height: 62rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-card view {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.growth-question-card view text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 172rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 26rpx;
  background: #f8fafc;
  color: #1e293b;
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-card view text.active {
  border-color: #14b8a6;
  background: #ccfbf1;
  color: #0d9488;
}

.growth-upload-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.growth-upload-card {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 28rpx;
  background: #ffffff;
}

.growth-upload-card.primary {
  background: #e6f4f1;
  border-color: #99f6e4;
}

.growth-upload-card.warm {
  background: #fef3c7;
}

.growth-upload-card image {
  width: 82rpx;
  height: 82rpx;
}

.growth-upload-card view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.growth-upload-card view text:first-child {
  color: #1f2937;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.growth-upload-card view text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.growth-upload-card > text {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: #1f2937;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-unlock-strip {
  display: grid;
  gap: 12rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.growth-unlock-strip text {
  color: #64748b;
  font-size: 23rpx;
  line-height: 30rpx;
}

.growth-unlock-strip text:first-child {
  color: #1f2937;
  font-weight: 900;
}

.growth-signal-grid view,
.growth-report-preview-card {
  display: grid;
  gap: 10rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(82, 67, 54, 0.07);
}

.growth-signal-grid text:first-child,
.growth-report-preview-card text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.growth-signal-grid text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.growth-report-preview-card text:last-child {
  color: #4b5563;
  font-size: 28rpx;
  line-height: 40rpx;
}

.growth-report-preview-card.warn {
  background: #fef3c7;
}

.growth-report-preview-card.action {
  background: #ccfbf1;
}

.growth-report-actions {
  grid-template-columns: 1fr 1fr 1fr;
}

.growth-report-actions text,
.growth-next-row view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #1f2937;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
  text-align: center;
}

.growth-parent-action-card > view:not(.growth-parent-action-head) {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f9f8f4;
  background: #f8fafc;
}

.growth-parent-action-card > view:not(.growth-parent-action-head) > text {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border: 4rpx solid #14b8a6;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.growth-parent-action-card view view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.growth-parent-action-card view view text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.growth-parent-action-card view view text:last-child {
  color: #64748b;
  font-size: 25rpx;
  line-height: 36rpx;
}

.yd-parent-decision.growth {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
}

.yd-parent-decision-img {
  width: 104rpx;
  height: 84rpx;
  object-fit: contain;
}

.yd-parent-decision-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.yd-parent-decision-copy text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.yd-parent-decision-copy text:last-child {
  display: -webkit-box;
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.yd-parent-decision-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ccfbf1;
  color: #0d9488;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-next-row view {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  justify-content: stretch;
  text-align: left;
}

.growth-next-row image {
  width: 46rpx;
  height: 46rpx;
}

.growth-next-row text {
  color: #1f2937;
  font-size: 23rpx;
  line-height: 29rpx;
  font-weight: 900;
}
