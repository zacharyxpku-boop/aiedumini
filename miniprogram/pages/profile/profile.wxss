page {
  background: #f9f8f4;
}

.profile-page {
  min-height: 100vh;
  background: #f9f8f4;
  color: #1f2937;
}

.profile-scroll {
  min-height: 100vh;
}

.profile-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-parent-screen {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 40rpx calc(172rpx + env(safe-area-inset-bottom));
  background: #f9f8f4;
  border-radius: 0;
}

.yd-parent-screen.scene-main {
  gap: 20rpx;
  padding-bottom: calc(286rpx + env(safe-area-inset-bottom));
}

.yd-parent-screen:not(.scene-main) {
  gap: 24rpx;
  min-height: calc(100vh - 96rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 0 48rpx calc(172rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 0%, rgba(254, 243, 199, 0.64), transparent 26%),
    radial-gradient(circle at 0% 30%, rgba(204, 251, 241, 0.5), transparent 24%),
    #f8fafc;
}

.yd-parent-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-parent-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 68rpx;
}

.yd-parent-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  opacity: 1;
  pointer-events: auto;
}

.yd-parent-screen.scene-main .yd-parent-brand {
  opacity: 0;
  pointer-events: none;
}

.yd-parent-screen.scene-main .yd-parent-pill {
  width: 168rpx;
  padding: 0 18rpx;
  border-color: rgba(0, 0, 0, 0.05);
  background: rgba(255, 255, 255, 0.62);
  color: #111827;
  letter-spacing: 1rpx;
}

.yd-parent-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-parent-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-parent-brand-copy text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.yd-parent-brand-copy text:last-child {
  color: #0d9488;
  font-size: 21rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-pill {
  flex: 0 0 auto;
  width: auto;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid rgba(20, 184, 166, 0.16);
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 64rpx;
  font-weight: 900;
  box-shadow: none;
}

.yd-parent-hero {
  position: relative;
  display: block;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  margin: 0 0 18rpx;
  padding: 4rpx 0 8rpx;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.yd-parent-hero.growth {
  min-height: 218rpx;
  background:
    radial-gradient(circle at 88% 0%, rgba(254, 243, 199, 0.78), transparent 24%),
    radial-gradient(circle at 8% 70%, rgba(230, 244, 241, 0.78), transparent 26%),
    #f9f8f4;
}

.yd-parent-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.yd-parent-kicker {
  display: none;
}

.yd-parent-title {
  display: grid;
  max-width: 620rpx;
  color: #1f2937;
  font-size: 56rpx;
  line-height: 72rpx;
  font-weight: 950;
}

.yd-parent-title text {
  display: block;
}

.yd-parent-sub {
  max-width: 620rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 680;
}

.yd-parent-art {
  display: none;
  position: absolute;
  right: 4rpx;
  bottom: -4rpx;
  width: 158rpx;
  height: 148rpx;
  object-fit: contain;
  opacity: 0.24;
}

.growth-choice-grid,
.growth-report-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.growth-choice-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12rpx;
  height: 220rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 28rpx 28rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 237, 213, 0.9);
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.growth-choice-card.warm {
  background: #ffffff;
  border-color: rgba(255, 237, 213, 0.95);
}

.growth-choice-card image {
  width: 80rpx;
  height: 80rpx;
  object-fit: contain;
  padding: 13rpx;
  border-radius: 50%;
  background: #fff7ed;
}

.growth-choice-card:not(.warm) image {
  background: #e6f4f1;
}

.growth-choice-card view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.growth-choice-card view text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 950;
}

.growth-choice-card view text:last-child {
  display: -webkit-box;
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.growth-choice-card > text {
  display: none;
}

.growth-choice-card:not(.warm) > text {
  display: none;
}

.growth-flow-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.yd-parent-screen:not(.scene-main) .growth-flow-tabs {
  display: none;
}

.growth-flow-tabs text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  border-radius: 15rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.yd-parent-screen:not(.scene-main) .growth-flow-tabs text {
  min-height: 10rpx;
  height: 10rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(30, 41, 59, 0.1);
  color: transparent;
  font-size: 0;
  line-height: 10rpx;
  box-shadow: none;
}

.growth-flow-tabs text.active {
  background: #ffffff;
  color: #0d9488;
  box-shadow: 0 6rpx 16rpx rgba(120, 83, 34, 0.1);
}

.yd-parent-screen:not(.scene-main) .growth-flow-tabs text.active {
  background: #14b8a6;
  color: transparent;
  box-shadow: none;
}

.growth-progress-card,
.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.065);
}

.growth-progress-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 0 0 44rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.growth-progress-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 4rpx;
  color: #1f2937;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.growth-progress-head text:last-child {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 20rpx;
  font-weight: 800;
}

.growth-progress-step {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  align-items: center;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f9fafb;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.035);
}

.growth-progress-step::before {
  content: "";
  position: absolute;
  left: -28rpx;
  top: -26rpx;
  width: 4rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
}

.growth-progress-step:first-of-type::before {
  display: none;
}

.growth-progress-step > text:first-child {
  position: absolute;
  left: -42rpx;
  top: 28rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 4rpx solid #fed7aa;
  border-radius: 999rpx;
  background: #ffffff;
}

.growth-progress-step.done > text:first-child,
.growth-progress-step.active > text:first-child {
  border-color: #99f6e4;
  background: #14b8a6;
  box-shadow: none;
}

.growth-progress-step view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.growth-progress-step view text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-progress-step view text:last-child {
  color: #64748b;
  font-size: 21rpx;
  line-height: 27rpx;
}

.growth-progress-step > text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #f59e0b;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary,
.yd-action-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 28rpx;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary {
  background: #fbbf24;
  color: #78350f;
  box-shadow: 0 12rpx 30rpx rgba(251, 191, 36, 0.28);
}

.yd-parent-screen.scene-main .growth-main-cta {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(114rpx + env(safe-area-inset-bottom));
  z-index: 18;
  min-height: 104rpx;
  border-radius: 40rpx;
  background: #fbbf24;
  box-shadow: 0 16rpx 36rpx rgba(251, 191, 36, 0.32);
}

.yd-parent-screen.scene-main .growth-main-cta::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(88rpx + env(safe-area-inset-bottom));
  z-index: -1;
  height: 156rpx;
  background: linear-gradient(180deg, rgba(248, 250, 245, 0), #f8faf5 46%, #f8faf5);
  pointer-events: none;
}

.yd-action-secondary {
  border: 2rpx solid #ccfbf1;
  background: #ffffff;
  color: #0d9488;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #f0ebe1;
}

.yd-parent-screen:not(.scene-main) .growth-questionnaire-panel,
.yd-parent-screen:not(.scene-main) .growth-upload-panel,
.yd-parent-screen:not(.scene-main) .growth-report-preview,
.yd-parent-screen:not(.scene-main) .growth-parent-action-card {
  flex: 1;
  min-height: calc(100vh - 286rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.yd-parent-screen.scene-questionnaire .growth-questionnaire-panel {
  position: relative;
  justify-content: flex-start;
  padding-top: 28rpx;
}

.yd-parent-screen.scene-questionnaire > .growth-flow-tabs {
  display: none;
}

.yd-parent-screen.scene-upload .growth-upload-panel,
.yd-parent-screen.scene-preview .growth-report-preview,
.yd-parent-screen.scene-action .growth-parent-action-card {
  justify-content: flex-start;
  padding-top: 18rpx;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  min-height: 620rpx;
  justify-content: center;
}

.growth-questionnaire-head,
.growth-upload-head,
.growth-report-preview-head,
.growth-parent-action-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.growth-subpage-nav {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr) 80rpx;
  gap: 16rpx;
  align-items: center;
  min-height: 78rpx;
  margin: -8rpx 0 8rpx;
}

.growth-subpage-nav text:first-child,
.growth-subpage-nav text:last-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #374151;
  font-size: 34rpx;
  line-height: 72rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.05);
}

.growth-subpage-nav text:nth-child(2) {
  display: flex;
  justify-content: center;
  color: #1f2937;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 950;
}

.growth-subpage-nav.preview text:nth-child(2),
.growth-subpage-nav.action text:nth-child(2) {
  justify-self: center;
  width: auto;
  min-height: 0;
  box-sizing: border-box;
  padding: 10rpx 26rpx;
  border: 1rpx solid rgba(20, 184, 166, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #0f766e;
  font-size: 24rpx;
  line-height: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.045);
}

.growth-subpage-nav.action text:nth-child(2) {
  border-color: rgba(251, 191, 36, 0.28);
  color: #c2410c;
}

.growth-subpage-nav text:last-child {
  justify-self: end;
  color: #9ca3af;
  font-size: 28rpx;
}

.growth-subpage-nav.questionnaire {
  grid-template-columns: 72rpx minmax(0, 1fr) 72rpx;
  margin: 0 0 28rpx;
}

.growth-subpage-nav.questionnaire text:nth-child(2) {
  display: none;
}

.growth-subpage-nav.questionnaire > text:last-child {
  visibility: hidden;
}

.yd-parent-screen:not(.scene-main) .growth-questionnaire-head,
.yd-parent-screen:not(.scene-main) .growth-upload-head,
.yd-parent-screen:not(.scene-main) .growth-report-preview-head,
.yd-parent-screen:not(.scene-main) .growth-parent-action-head {
  display: grid;
  gap: 12rpx;
}

.growth-questionnaire-head text:first-child,
.growth-upload-head text:first-child,
.growth-report-preview-head text:first-child,
.growth-parent-action-head text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.yd-parent-screen:not(.scene-main) .growth-questionnaire-head text:first-child {
  max-width: 560rpx;
  font-size: 54rpx;
  line-height: 70rpx;
}

.yd-parent-screen:not(.scene-main) .growth-questionnaire-head .growth-questionnaire-title-ref {
  display: grid;
  gap: 0;
  max-width: 560rpx;
  color: #111827;
  font-size: 56rpx;
  line-height: 76rpx;
  font-weight: 950;
}

.growth-questionnaire-title-ref text {
  display: block;
}

.growth-questionnaire-title-ref text:last-child {
  position: relative;
  width: fit-content;
  color: #14b8a6;
}

.growth-questionnaire-title-ref text:last-child::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.16);
  z-index: -1;
}

.yd-parent-screen.scene-upload .growth-upload-head text:first-child,
.yd-parent-screen.scene-preview .growth-report-preview-head text:first-child,
.yd-parent-screen.scene-action .growth-parent-action-head text:first-child {
  font-size: 44rpx;
  line-height: 56rpx;
}

.growth-questionnaire-head text:last-child,
.growth-upload-head text:last-child,
.growth-report-preview-head text:last-child,
.growth-parent-action-head text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: right;
}

.yd-parent-screen:not(.scene-main) .growth-questionnaire-head text:last-child,
.yd-parent-screen:not(.scene-main) .growth-upload-head text:last-child,
.yd-parent-screen:not(.scene-main) .growth-report-preview-head text:last-child,
.yd-parent-screen:not(.scene-main) .growth-parent-action-head text:last-child {
  text-align: left;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.growth-questionnaire-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  width: 220rpx;
  justify-self: center;
}

.growth-questionnaire-progress.nav {
  align-self: center;
  justify-self: center;
  width: 240rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.56);
}

.growth-questionnaire-progress text {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(203, 213, 225, 0.72);
}

.growth-questionnaire-progress text.done {
  background: rgba(20, 184, 166, 0.42);
}

.growth-questionnaire-progress text.active {
  background: #14b8a6;
}

.growth-question-intro,
.growth-question-note,
.growth-upload-lead,
.growth-report-lead,
.growth-report-more,
.growth-action-done {
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.growth-upload-lead {
  display: grid;
  gap: 2rpx;
}

.growth-upload-lead text {
  display: block;
}

.growth-upload-lead-highlight {
  display: inline;
  padding: 0 6rpx;
  border-radius: 8rpx;
  background: rgba(255, 237, 213, 0.55);
  color: rgba(194, 65, 12, 0.82);
  font-weight: 900;
}

.growth-question-card {
  display: grid;
  gap: 28rpx;
  padding: 4rpx 0 16rpx;
}

.growth-question-card > text {
  display: none;
  color: #1e293b;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.yd-parent-screen.scene-questionnaire .growth-question-options {
  gap: 20rpx;
}

.growth-question-option {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 224rpx;
  box-sizing: border-box;
  padding: 28rpx 18rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.055);
}

.yd-parent-screen.scene-questionnaire .growth-question-option {
  min-height: 232rpx;
  border-radius: 48rpx;
}

.growth-question-option-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ccfbf1;
}

.growth-question-option-icon::before {
  content: "";
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin: 25rpx auto;
  border-radius: 12rpx;
  background: rgba(15, 118, 110, 0.72);
}

.growth-question-option:nth-child(2) .growth-question-option-icon {
  background: #ffe4e6;
}

.growth-question-option:nth-child(3) .growth-question-option-icon {
  background: #fef3c7;
}

.growth-question-option:nth-child(4) .growth-question-option-icon {
  background: #dbeafe;
}

.growth-question-option:nth-child(5) .growth-question-option-icon {
  background: #ede9fe;
}

.growth-question-option:nth-child(6) .growth-question-option-icon {
  background: #f3f4f6;
}

.growth-question-option-label {
  color: #1e293b;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-option-check {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  display: none;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-question-option.active {
  border-color: #14b8a6;
  background: #f0fdfa;
  box-shadow: 0 14rpx 30rpx rgba(20, 184, 166, 0.14);
}

.growth-question-option.active .growth-question-option-label {
  color: #0d9488;
}

.growth-question-option.active .growth-question-option-check {
  display: flex;
}

.growth-upload-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.yd-parent-screen.scene-upload .growth-upload-grid {
  gap: 16rpx;
}

.growth-upload-card {
  position: relative;
  display: grid;
  justify-items: center;
  align-content: center;
  gap: 12rpx;
  min-height: 174rpx;
  box-sizing: border-box;
  padding: 24rpx 20rpx;
  overflow: hidden;
  border: 3rpx dashed #e5e7eb;
  border-radius: 48rpx;
  background: #ffffff;
  text-align: center;
}

.yd-parent-screen.scene-upload .growth-upload-card {
  min-height: 150rpx;
  border-radius: 40rpx;
}

.yd-parent-screen.scene-upload .growth-upload-card.primary {
  min-height: 188rpx;
}

.growth-upload-card.primary {
  grid-column: 1 / -1;
  justify-items: stretch;
  min-height: 196rpx;
  background: #e6f4f1;
  border: 2rpx solid rgba(20, 184, 166, 0.4);
  text-align: left;
}

.growth-upload-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 0 48rpx 0 80rpx;
  background: rgba(20, 184, 166, 0.06);
}

.growth-upload-title-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: start;
}

.growth-upload-card.primary .growth-upload-title-row image,
.growth-upload-card.primary > image {
  width: 80rpx;
  height: 80rpx;
  padding: 10rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.08);
}

.growth-upload-title-row view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.growth-upload-title-row view text:first-child {
  color: #0f766e;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 950;
}

.growth-upload-title-row view text:last-child {
  color: rgba(15, 118, 110, 0.7);
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-upload-added {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(20, 184, 166, 0.24);
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
}

.growth-upload-sample {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  padding: 16rpx;
  border: 1rpx solid #ffffff;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #4b5563;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.growth-upload-card:not(.primary) image {
  width: 68rpx;
  height: 68rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: #eff6ff;
}

.growth-upload-card.teal image {
  background: #ccfbf1;
}

.growth-upload-card.warm image {
  background: #ffedd5;
}

.growth-upload-card.purple image {
  background: #ede9fe;
}

.growth-upload-card:not(.primary) view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.growth-upload-card:not(.primary) view text:first-child {
  color: #1f2937;
  font-size: 27rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.growth-upload-card:not(.primary) view text:nth-child(2) {
  display: -webkit-box;
  overflow: hidden;
  color: #9ca3af;
  font-size: 21rpx;
  line-height: 25rpx;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.growth-upload-plus {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #f9fafb;
  color: #9ca3af;
  font-size: 28rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.growth-unlock-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.growth-unlock-strip > text {
  grid-column: 1 / -1;
  color: #1f2937;
  font-size: 27rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.growth-unlock-strip view {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 6rpx;
  align-items: start;
  min-height: 112rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.045);
}

.growth-unlock-strip view::before {
  content: "";
  width: 42rpx;
  height: 42rpx;
  border-radius: 16rpx;
  background: #eef2ff;
}

.growth-unlock-strip view:nth-of-type(2)::before {
  background: #fce7f3;
}

.growth-unlock-strip view:nth-of-type(3)::before {
  background: #ffedd5;
}

.growth-unlock-strip view text:first-child {
  color: #1f2937;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.growth-unlock-strip view text:last-child {
  display: -webkit-box;
  overflow: hidden;
  color: #64748b;
  font-size: 20rpx;
  line-height: 24rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.growth-report-preview-card {
  position: relative;
  display: grid;
  gap: 16rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(240, 235, 225, 0.9);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.055);
}

.yd-parent-screen.scene-preview .growth-report-preview-card,
.yd-parent-screen.scene-action .growth-parent-action-card > .growth-parent-action-item {
  border-radius: 28rpx;
  box-shadow: 0 4rpx 22rpx rgba(15, 23, 42, 0.045);
}

.growth-report-corner {
  position: absolute;
  right: 0;
  top: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 0 34rpx 0 118rpx;
  background: rgba(20, 184, 166, 0.08);
}

.growth-report-preview-card.warn .growth-report-corner {
  background: rgba(236, 72, 153, 0.08);
}

.growth-report-preview-card.action .growth-report-corner {
  background: rgba(251, 191, 36, 0.18);
}

.growth-report-card-head {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
}

.growth-report-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #ccfbf1;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
}

.growth-report-preview-card.warn .growth-report-icon {
  background: #fce7f3;
}

.growth-report-preview-card.action .growth-report-icon {
  background: #fef3c7;
}

.growth-report-card-head view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.growth-report-card-head view > text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-report-card-head view > text:last-child {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.growth-report-card-head view > text:last-child text:first-child {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.growth-report-preview-card.warn .growth-report-card-head view > text:last-child text:first-child {
  background: #fce7f3;
  color: #db2777;
}

.growth-report-preview-card.action .growth-report-card-head view > text:last-child text:first-child {
  background: #fef3c7;
  color: #b45309;
}

.growth-report-card-head view > text:last-child text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-report-body {
  position: relative;
  z-index: 1;
  display: block;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 38rpx;
  overflow: visible;
}

.growth-report-actions {
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  padding: 0;
  border-top: 0;
}

.growth-report-actions text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 36rpx;
  background: #f8fafc;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-report-actions text:first-child {
  grid-column: auto;
  border: 0;
  background: #14b8a6;
  color: #ffffff;
}

.growth-report-actions text:nth-child(2) {
  background: #fbbf24;
  color: #78350f;
}

.growth-parent-action-card > .growth-parent-action-item {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: start;
  padding: 30rpx;
  border: 1rpx solid rgba(240, 235, 225, 0.92);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.055);
}

.growth-parent-action-card > .growth-parent-action-item.active {
  border-color: rgba(20, 184, 166, 0.28);
  background: #f0fdfa;
  box-shadow: 0 12rpx 28rpx rgba(20, 184, 166, 0.12);
}

.growth-parent-action-card > .growth-parent-action-item > text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-top: 4rpx;
  border: 4rpx solid rgba(20, 184, 166, 0.3);
  border-radius: 16rpx;
  box-sizing: border-box;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.growth-parent-action-card > .growth-parent-action-item.active > text {
  border-color: #14b8a6;
  background: #14b8a6;
}

.growth-parent-action-card .growth-parent-action-item view {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child text:first-child {
  padding: 5rpx 16rpx;
  border-radius: 10rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.growth-parent-action-card .growth-parent-action-item.warm view > text:first-child text:first-child {
  background: #ffedd5;
  color: #c2410c;
}

.growth-parent-action-card .growth-parent-action-item.indigo view > text:first-child text:first-child {
  background: #eef2ff;
  color: #4f46e5;
}

.growth-parent-action-card .growth-parent-action-item view > text:first-child text:last-child {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 28rpx;
}

.growth-parent-action-card .growth-parent-action-item view > text:nth-child(2) {
  color: #1f2937;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.growth-parent-action-card .growth-parent-action-item view > text:nth-child(3) {
  display: block;
  overflow: visible;
  color: #64748b;
  font-size: 25rpx;
  line-height: 36rpx;
}

.growth-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  z-index: 20;
  box-sizing: border-box;
  padding: 18rpx 48rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(226, 232, 240, 0.72);
  background: rgba(249, 248, 244, 0.94);
  box-shadow: 0 -18rpx 38rpx rgba(249, 248, 244, 0.86);
}

.growth-bottom-bar.question {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
}

.growth-bottom-bar.single {
  display: block;
}

.growth-bottom-bar.report {
  display: grid;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.9);
}

.growth-bottom-bar.report > text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  border: 3rpx dashed rgba(20, 184, 166, 0.38);
  border-radius: 36rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-bottom-bar.action {
  background: rgba(255, 255, 255, 0.9);
}

.growth-parent-bottom-actions {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 18rpx;
  padding-top: 0;
  border-top: 0;
}

.growth-parent-bottom-actions text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 108rpx;
  border-radius: 40rpx;
  color: #ffffff;
  background: #14b8a6;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-parent-bottom-actions text:last-child {
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  color: #1f2937;
}
