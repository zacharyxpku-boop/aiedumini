page {
  background: #f8faf5;
}

.profile-page {
  min-height: 100vh;
  background: #f8faf5;
  color: #1f2937;
}

.profile-scroll {
  min-height: 100vh;
}

.profile-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-parent-screen {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 32rpx 176rpx;
  background: #f8faf5;
  border-radius: 0;
}

.yd-parent-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-parent-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-parent-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.yd-parent-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-parent-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-parent-brand-copy text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.yd-parent-brand-copy text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(20, 184, 166, 0.08);
}

.yd-parent-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 214rpx;
  min-height: 292rpx;
  overflow: hidden;
  box-sizing: border-box;
  padding: 34rpx 26rpx;
  border-radius: 0 0 38rpx 38rpx;
  background: #e6f4f1;
  box-shadow: 0 18rpx 40rpx rgba(15, 118, 110, 0.12);
}

.yd-parent-hero.growth {
  background:
    radial-gradient(circle at 84% 20%, rgba(251, 191, 36, 0.36), transparent 28%),
    linear-gradient(135deg, #e6f4f1 0%, #ffffff 58%, #fef3c7 100%);
}

.yd-parent-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.yd-parent-kicker {
  color: #0d9488;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.yd-parent-title {
  max-width: 396rpx;
  color: #1f2937;
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 900;
}

.yd-parent-sub {
  max-width: 390rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 33rpx;
  font-weight: 600;
}

.yd-parent-art {
  position: absolute;
  right: 8rpx;
  bottom: 4rpx;
  width: 204rpx;
  height: 188rpx;
  object-fit: contain;
}

.growth-choice-grid,
.growth-signal-grid,
.growth-action-row,
.growth-next-row,
.growth-report-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.growth-choice-card {
  display: grid;
  grid-template-columns: 70rpx minmax(0, 1fr);
  grid-template-areas: "icon copy" "action action";
  gap: 16rpx;
  min-height: 204rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid #edf2e7;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.07);
}

.growth-choice-card.warm {
  background: #e6f4f1;
  border-color: #ccfbf1;
}

.growth-choice-card image {
  grid-area: icon;
  width: 70rpx;
  height: 70rpx;
  object-fit: contain;
}

.growth-choice-card view {
  grid-area: copy;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.growth-choice-card view text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.growth-choice-card view text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 29rpx;
}

.growth-choice-card > text {
  grid-area: action;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 18rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.growth-flow-tabs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.growth-flow-tabs text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  border-radius: 15rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.growth-flow-tabs text.active {
  background: #ffffff;
  color: #0d9488;
  box-shadow: 0 6rpx 16rpx rgba(120, 83, 34, 0.1);
}

.growth-progress-card,
.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card,
.yd-parent-decision {
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.065);
}

.growth-progress-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #edf2e7;
}

.growth-progress-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.growth-progress-head text:last-child {
  color: #0d9488;
  font-size: 22rpx;
  font-weight: 800;
}

.growth-progress-step {
  position: relative;
  display: grid;
  grid-template-columns: 40rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #f8faf5;
}

.growth-progress-step::before {
  content: "";
  position: absolute;
  left: 35rpx;
  top: -18rpx;
  width: 4rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #dbe7de;
}

.growth-progress-step:first-of-type::before {
  display: none;
}

.growth-progress-step > text:first-child {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #d1d5db;
}

.growth-progress-step.done > text:first-child,
.growth-progress-step.active > text:first-child {
  background: #14b8a6;
  box-shadow: 0 0 0 8rpx rgba(20, 184, 166, 0.12);
}

.growth-progress-step view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.growth-progress-step view text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-progress-step view text:last-child {
  color: #64748b;
  font-size: 21rpx;
  line-height: 27rpx;
}

.growth-progress-step > text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #0d9488;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary,
.yd-action-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-main-cta,
.growth-generate-cta,
.yd-action-primary {
  background: #14b8a6;
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(20, 184, 166, 0.24);
}

.yd-action-secondary {
  border: 2rpx solid #ccfbf1;
  background: #ffffff;
  color: #0d9488;
}

.growth-questionnaire-panel,
.growth-upload-panel,
.growth-report-preview,
.growth-parent-action-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #edf2e7;
}

.growth-questionnaire-head,
.growth-upload-head,
.growth-report-preview-head,
.growth-parent-action-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.growth-questionnaire-head text:first-child,
.growth-upload-head text:first-child,
.growth-report-preview-head text:first-child,
.growth-parent-action-head text:first-child {
  color: #1f2937;
  font-size: 31rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.growth-questionnaire-head text:last-child,
.growth-upload-head text:last-child,
.growth-report-preview-head text:last-child,
.growth-parent-action-head text:last-child {
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: right;
}

.growth-questionnaire-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.growth-questionnaire-progress text {
  height: 10rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
}

.growth-questionnaire-progress text:first-child {
  background: #14b8a6;
}

.growth-question-intro,
.growth-question-note,
.growth-upload-lead,
.growth-report-lead,
.growth-report-more,
.growth-action-done {
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.growth-question-card {
  display: grid;
  gap: 20rpx;
  padding: 10rpx 0 4rpx;
}

.growth-question-card > text {
  color: #1e293b;
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-card view {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.growth-question-card view text {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 156rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 26rpx;
  background: #f8fafc;
  color: #1e293b;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
}

.growth-question-card view text.active {
  border-color: #14b8a6;
  background: #ccfbf1;
  color: #0d9488;
}

.growth-upload-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.growth-upload-card {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  min-height: 136rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #ffffff;
}

.growth-upload-card.primary {
  background: #e6f4f1;
  border-color: #99f6e4;
}

.growth-upload-card.warm {
  background: #fef3c7;
}

.growth-upload-card image {
  width: 82rpx;
  height: 82rpx;
}

.growth-upload-card view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.growth-upload-card view text:first-child {
  color: #1f2937;
  font-size: 27rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.growth-upload-card view text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.growth-upload-card > text {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: #1f2937;
  color: #ffffff;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-unlock-strip {
  display: grid;
  gap: 10rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.growth-unlock-strip text {
  color: #64748b;
  font-size: 23rpx;
  line-height: 30rpx;
}

.growth-unlock-strip text:first-child {
  color: #1f2937;
  font-weight: 900;
}

.growth-signal-grid view,
.growth-report-preview-card {
  display: grid;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.055);
}

.growth-signal-grid text:first-child,
.growth-report-preview-card text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-signal-grid text:nth-child(2) {
  color: #64748b;
  font-size: 22rpx;
  line-height: 30rpx;
}

.growth-report-preview-card text:last-child {
  color: #4b5563;
  font-size: 26rpx;
  line-height: 36rpx;
}

.growth-report-preview-card.warn {
  background: #fef3c7;
}

.growth-report-preview-card.action {
  background: #ccfbf1;
}

.growth-report-actions {
  grid-template-columns: 1fr 1fr 1fr;
}

.growth-report-actions text,
.growth-next-row view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #1f2937;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
  text-align: center;
}

.growth-parent-action-card > view:not(.growth-parent-action-head) {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #f9f8f4;
  background: #f8fafc;
}

.growth-parent-action-card > view:not(.growth-parent-action-head) > text {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border: 4rpx solid #14b8a6;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.growth-parent-action-card view view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.growth-parent-action-card view view text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.growth-parent-action-card view view text:last-child {
  color: #64748b;
  font-size: 23rpx;
  line-height: 32rpx;
}

.yd-parent-decision.growth {
  display: grid;
  grid-template-columns: 104rpx minmax(0, 1fr) auto;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
}

.yd-parent-decision-img {
  width: 104rpx;
  height: 84rpx;
  object-fit: contain;
}

.yd-parent-decision-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.yd-parent-decision-copy text:first-child {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.yd-parent-decision-copy text:last-child {
  display: -webkit-box;
  color: #64748b;
  font-size: 22rpx;
  line-height: 28rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.yd-parent-decision-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ccfbf1;
  color: #0d9488;
  font-size: 21rpx;
  line-height: 25rpx;
  font-weight: 900;
}

.growth-next-row view {
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr);
  justify-content: stretch;
  text-align: left;
}

.growth-next-row image {
  width: 46rpx;
  height: 46rpx;
}

.growth-next-row text {
  color: #1f2937;
  font-size: 23rpx;
  line-height: 29rpx;
  font-weight: 900;
}
