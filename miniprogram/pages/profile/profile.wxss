page {
  background: #f9f8f4;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1f2933;
  background: #f9f8f4;
}

.profile-scroll {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  height: auto;
}

.profile-shell {
  position: relative;
  z-index: 2;
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-parent-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 16rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  margin: 0;
  padding: 22rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 216, 79, 0.2) 0%, rgba(255, 216, 79, 0) 32%),
    linear-gradient(205deg, rgba(76, 159, 255, 0.16) 0%, rgba(76, 159, 255, 0) 36%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.04);
}

.yd-parent-top,
.yd-parent-brand,
.yd-parent-section-head,
.yd-parent-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-parent-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-parent-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  background: #ebf9ed;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.10);
}

.yd-parent-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-parent-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-parent-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-parent-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  gap: 18rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 276rpx;
  margin-top: 0;
}

.yd-parent-hero.growth {
  min-height: 300rpx;
  padding: 18rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  background:
    linear-gradient(135deg, rgba(255, 248, 214, 0.96) 0%, rgba(239, 248, 255, 0.94) 58%, rgba(242, 251, 239, 0.96) 100%);
}

.yd-parent-kicker {
  width: max-content;
  max-width: 100%;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #9a6b00;
  background: #fff4c9;
  font-size: 20rpx;
  font-weight: 900;
}

.yd-parent-title {
  margin-top: 7rpx;
  color: #101a16;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.16;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-parent-sub {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 24rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-art {
  width: 204rpx;
  height: 188rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border-radius: 26rpx;
  background: #fff1ea;
}

.yd-parent-hero.growth .yd-parent-art {
  width: 214rpx;
  height: 202rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  background: #edf8ff;
}

.growth-choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.growth-choice-card {
  display: grid;
  min-width: 0;
  min-height: 188rpx;
  align-content: space-between;
  gap: 8rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f2fbef 100%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.045);
}

.growth-choice-card.warm {
  border-color: rgba(248, 198, 34, 0.26);
  background: linear-gradient(135deg, #fffdf6 0%, #fff5cc 100%);
}

.growth-choice-card image {
  width: 70rpx;
  height: 70rpx;
  object-fit: contain;
}

.growth-choice-card view {
  min-width: 0;
}

.growth-choice-card view text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.growth-choice-card view text:first-child {
  color: #14241d;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.16;
  -webkit-line-clamp: 1;
}

.growth-choice-card view text:nth-child(2) {
  margin-top: 5rpx;
  color: #65746c;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-line-clamp: 2;
}

.growth-choice-card > text {
  justify-self: start;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 22rpx;
  font-weight: 950;
}

.growth-questionnaire-panel {
  display: grid;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.96);
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(251, 191, 36, 0.18), transparent 36%),
    radial-gradient(circle at 0% 60%, rgba(20, 184, 166, 0.12), transparent 40%),
    rgba(255, 255, 255, 0.97);
  box-shadow: 0 16rpx 34rpx rgba(38, 58, 43, 0.06);
}

.growth-questionnaire-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-questionnaire-head text:first-child {
  color: #14241d;
  font-size: 34rpx;
  font-weight: 950;
}

.growth-questionnaire-head text:last-child {
  color: #14854a;
  font-size: 22rpx;
  font-weight: 900;
}

.growth-questionnaire-progress {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.growth-questionnaire-progress text {
  height: 12rpx;
  border-radius: 999rpx;
  background: #dbe7e1;
}

.growth-questionnaire-progress text:first-child {
  background: #14b8a6;
}

.growth-question-card {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #f8fafc;
}

.growth-question-card > text {
  color: #173f31;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.28;
}

.growth-question-card view {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.growth-question-card view text {
  display: flex;
  max-width: 100%;
  min-height: 86rpx;
  align-items: center;
  justify-content: center;
  padding: 10rpx 12rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  color: #334155;
  background: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.18;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.035);
}

.growth-question-card view text.active {
  color: #0f766e;
  border-color: #14b8a6;
  background: #ccfbf1;
  box-shadow: none;
}

.growth-generate-cta {
  min-height: 96rpx;
  border-radius: 28rpx;
  color: #17342b;
  background: #fbbf24;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(251, 191, 36, 0.28);
}

.growth-upload-card {
  display: grid;
  grid-template-columns: 82rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  min-height: 132rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.20);
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.045);
}

.growth-upload-card image {
  width: 76rpx;
  height: 76rpx;
  object-fit: contain;
}

.growth-upload-card view {
  min-width: 0;
}

.growth-upload-card view text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.growth-upload-card view text:first-child {
  color: #14241d;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.growth-upload-card view text:nth-child(2) {
  display: -webkit-box;
  margin-top: 5rpx;
  color: #65746c;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  white-space: normal;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.growth-upload-card > text {
  flex: 0 0 auto;
  padding: 11rpx 14rpx;
  border-radius: 999rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 22rpx;
  font-weight: 950;
  white-space: nowrap;
}

.growth-signal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.growth-signal-grid view {
  min-width: 0;
  min-height: 118rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
}

.growth-signal-grid text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.growth-signal-grid text:first-child {
  color: #173f31;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.12;
  -webkit-line-clamp: 1;
}

.growth-signal-grid text:nth-child(2) {
  margin-top: 8rpx;
  color: #66746d;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-line-clamp: 2;
}

.growth-progress-card {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 8% 0%, rgba(34, 185, 92, 0.14), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 251, 243, 0.94));
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.045);
}

.growth-progress-head,
.growth-progress-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.growth-progress-head text:first-child {
  color: #14241d;
  font-size: 29rpx;
  font-weight: 950;
}

.growth-progress-head text:last-child {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 21rpx;
  font-weight: 900;
  white-space: nowrap;
}

.growth-progress-step {
  position: relative;
  min-height: 92rpx;
}

.growth-progress-step > text:first-child {
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #d7e5d4;
  border-radius: 999rpx;
  background: #ffffff;
}

.growth-progress-step.done > text:first-child,
.growth-progress-step.active > text:first-child {
  border-color: #18a94f;
  background: #18a94f;
}

.growth-progress-step view {
  flex: 1 1 auto;
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: #ffffff;
}

.growth-progress-step view text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.growth-progress-step view text:first-child {
  color: #14241d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.growth-progress-step view text:nth-child(2) {
  margin-top: 5rpx;
  color: #66746d;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.22;
  white-space: nowrap;
}

.growth-progress-step > text:last-child {
  flex: 0 0 auto;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 21rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-decision.growth {
  background:
    radial-gradient(circle at 88% 16%, rgba(255, 216, 79, 0.22), transparent 36%),
    linear-gradient(135deg, #ffffff 0%, #eef7ff 100%);
}

.growth-action-row,
.growth-next-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.growth-action-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.growth-action-row .yd-action-primary,
.growth-action-row .yd-action-secondary {
  min-height: 78rpx;
  margin: 0;
  line-height: 78rpx;
}

.growth-next-row view {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  align-items: center;
  gap: 10rpx;
  min-height: 86rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
}

.growth-next-row image {
  width: 46rpx;
  height: 46rpx;
  object-fit: contain;
}

.growth-next-row text {
  display: -webkit-box;
  overflow: hidden;
  color: #173f31;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.18;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.growth-main-cta {
  min-height: 94rpx;
  border-radius: 28rpx;
  color: #78350f;
  background: linear-gradient(180deg, #ffd84f 0%, #f4b51b 100%);
  box-shadow: 0 12rpx 24rpx rgba(248, 198, 34, 0.24);
  font-size: 32rpx;
  font-weight: 950;
  line-height: 94rpx;
  text-align: center;
}

.yd-parent-purpose {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.yd-parent-purpose view {
  min-width: 0;
  min-height: 96rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
}

.yd-parent-purpose text {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.yd-parent-purpose text:first-child {
  color: #173f31;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.12;
  -webkit-line-clamp: 1;
}

.yd-parent-purpose text:nth-child(2) {
  margin-top: 6rpx;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  -webkit-line-clamp: 2;
}

.yd-parent-decision {
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.035);
}

.yd-parent-decision {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  margin-top: 0;
  padding: 18rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(248, 198, 34, 0.16), transparent 36%),
    linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-decision-img {
  width: 104rpx;
  height: 84rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 18rpx;
  background: #edf8ff;
}

.yd-parent-decision-copy {
  min-width: 0;
}

.yd-parent-decision-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-decision-copy text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
  white-space: normal;
  -webkit-line-clamp: 2;
}

.yd-parent-decision-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 7rpx;
  color: #66756d;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.32;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.yd-parent-decision-badge {
  flex: 0 0 auto;
  padding: 9rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 999rpx;
  color: #0f7b43;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-report-status {
  display: grid;
  gap: 6rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.14);
  border-radius: 20rpx;
  background: #f6f7ff;
}

.yd-parent-report-status text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.yd-parent-report-status text:first-child {
  color: #29305f;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.2;
  -webkit-line-clamp: 1;
}

.yd-parent-report-status text:last-child {
  color: #69708a;
  font-size: 20rpx;
  font-weight: 760;
  line-height: 1.3;
  -webkit-line-clamp: 2;
}

.yd-parent-evidence {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.86);
}

.yd-parent-evidence-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.yd-parent-evidence-head text:first-child {
  flex: 0 0 auto;
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
}

.yd-parent-evidence-head text:last-child {
  min-width: 0;
  color: #6c776f;
  font-size: 20rpx;
  font-weight: 760;
  line-height: 1.26;
  text-align: right;
}

.yd-parent-evidence-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.yd-parent-evidence-chip {
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 10rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f6fbf4;
}

.yd-parent-evidence-chip text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-evidence-chip text:first-child {
  color: #66746d;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.12;
  white-space: nowrap;
}

.yd-parent-evidence-chip text:nth-child(2) {
  margin-top: 7rpx;
  color: #18211d;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.12;
  white-space: nowrap;
}

.yd-parent-section-head text:first-child {
  color: #18211d;
  font-size: 24rpx;
  font-weight: 950;
}

.yd-parent-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  white-space: normal;
  text-align: right;
}

.yd-parent-loop {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.yd-parent-loop {
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: repeat(3, minmax(116rpx, auto));
  flex: 1 1 auto;
  margin-top: 0;
  gap: 10rpx;
}

.yd-parent-loop-card {
  display: flex;
  min-width: 0;
  min-height: 132rpx;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
}

.yd-parent-loop-card:active {
  transform: translateY(1rpx);
  background: #ffffff;
}

.yd-parent-loop-card.primary {
  background: linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-loop-card.final {
  background: #fff8df;
}

.yd-parent-loop-card image {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  object-fit: contain;
}

.yd-parent-loop-card view {
  min-width: 0;
}

.yd-parent-loop-card text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-loop-card text:first-child {
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: normal;
}

.yd-parent-loop-card text:nth-child(2) {
  display: -webkit-box;
  margin-top: 4rpx;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.32;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-action-row {
  position: static;
  z-index: 1;
  margin-top: 10rpx;
  padding-top: 0;
  padding-bottom: 2rpx;
}

.parent-primary,
.parent-secondary {
  flex: 1 1 0;
  min-width: 0;
  padding-left: 12rpx;
  padding-right: 12rpx;
  margin-top: 0;
}
