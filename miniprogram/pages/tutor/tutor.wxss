page {
  background: #f4f2ec;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #2d2c2a;
  background:
    radial-gradient(circle at 50% -80rpx, rgba(242, 212, 121, 0.18), rgba(242, 212, 121, 0) 360rpx),
    #f4f2ec;
}

.tutor-shell {
  position: relative;
  min-height: 100vh;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(104rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 18rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 24rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 8% 4%, rgba(248, 198, 34, 0.17), transparent 24%),
    radial-gradient(circle at 92% 8%, rgba(34, 185, 92, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-section-head,
.tutor-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-tutor-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(76, 159, 255, 0.16);
  border-radius: 18rpx;
  background: #eef7ff;
  box-shadow: 0 14rpx 26rpx rgba(76, 159, 255, 0.12);
}

.yd-tutor-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-tutor-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
}

.yd-tutor-hero {
  display: grid;
  grid-template-columns: 190rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 266rpx;
  margin-top: 0;
}

.yd-tutor-mascot {
  width: 188rpx;
  height: 184rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: #effaf0;
}

.yd-tutor-bubble {
  min-width: 0;
  padding: 24rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.yd-tutor-bubble view:first-child {
  color: #101a16;
  font-size: 47rpx;
  font-weight: 950;
  line-height: 1.12;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 26rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-chip-row text {
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 21rpx;
  font-weight: 820;
  white-space: normal;
}

.tutor-socratic-panel {
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.045);
}

.tutor-socratic-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-socratic-steps view {
  display: grid;
  min-width: 0;
  min-height: 120rpx;
  align-content: center;
  gap: 5rpx;
  padding: 12rpx 10rpx;
  border-radius: 18rpx;
  background: #f6fbf0;
}

.tutor-socratic-steps view.active {
  background: #eef7ff;
  box-shadow: inset 0 0 0 2rpx rgba(76, 159, 255, 0.16);
}

.tutor-socratic-steps text {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.tutor-socratic-steps text:first-child {
  justify-self: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: #ffd84f;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 34rpx;
}

.tutor-socratic-steps text:nth-child(2) {
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.18;
}

.tutor-socratic-steps text:nth-child(3) {
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.24;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-mode-card {
  display: flex;
  min-width: 0;
  min-height: 106rpx;
  align-items: center;
  justify-content: center;
  padding: 10rpx 8rpx;
  border-radius: 16rpx;
  color: #17211d;
  background: #f8fbf4;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.22;
}

.tutor-prompt-board {
  display: block;
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #eef7ff;
  overflow-wrap: break-word;
  word-break: break-word;
  color: #536158;
  font-size: 22rpx;
  font-weight: 790;
  line-height: 1.34;
}

.tutor-socratic-trace {
  display: block;
  margin-top: 10rpx;
  padding: 9rpx 10rpx;
  border-radius: 14rpx;
  color: #2d3b33;
  background: #f8fbf4;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.28;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-socratic-boundary {
  display: block;
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  color: #536158;
  background: #fff8df;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.36;
}

.tutor-section-head text:first-child {
  color: #18211d;
  font-size: 23rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 12rpx;
  flex: 0 0 auto;
  min-height: 338rpx;
  max-height: none;
  margin-top: 0;
  padding: 20rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.tutor-chat-title {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
}

.tutor-chat-card .tutor-bubble {
  max-width: 82%;
  padding: 12rpx 15rpx;
  border-radius: 20rpx;
  color: #31423a;
  background: #f1f7ef;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.42;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
  background: #eaf3ff;
}

.tutor-input-bar {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx 0 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 999rpx;
  background: #ffffff;
}

.tutor-input-bar input {
  flex: 1 1 auto;
  min-width: 0;
  height: 68rpx;
  color: #8a958f;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 68rpx;
}

.tutor-feedback-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.tutor-feedback-good,
.tutor-feedback-stuck {
  display: flex;
  min-width: 0;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-feedback-good {
  color: #163321;
  background: #e8f8e8;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.14);
}

.tutor-feedback-stuck {
  color: #463a12;
  background: #fff4c6;
  box-shadow: inset 0 0 0 2rpx rgba(248, 198, 34, 0.2);
}

.tutor-feedback-good:active,
.tutor-feedback-stuck:active {
  transform: scale(0.985);
}

.tutor-feedback-note {
  display: block;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  color: #536158;
  background: #f8fbf4;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.32;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-input-bar view {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  font-size: 22rpx;
  font-weight: 950;
  line-height: 58rpx;
}

.tutor-action-row {
  margin-top: 10rpx;
  padding-top: 0;
}

.tutor-primary {
  flex: 1 1 0;
  min-width: 0;
  height: 90rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 90rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-primary {
  height: 90rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
}
