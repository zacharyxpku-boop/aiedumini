page {
  background: #f6f8f3;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #1f2937;
  background: #f6f8f3;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 32rpx calc(166rpx + env(safe-area-inset-bottom));
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  justify-content: flex-start;
  gap: 24rpx;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.yd-tutor-screen.detail-on {
  gap: 0;
}

.yd-tutor-screen:not(.detail-on) {
  height: calc(100vh - 262rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  min-height: 0;
  overflow: hidden;
  justify-content: space-between;
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-chat-head,
.tutor-section-head {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-tutor-top {
  position: relative;
  z-index: 8;
  min-height: 64rpx;
  margin: 0 -32rpx;
  padding: 0 32rpx 4rpx;
  background: rgba(246, 248, 243, 0.96);
}

.yd-tutor-brand {
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  object-fit: contain;
  padding: 7rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #14b8a6;
  box-shadow: 0 6rpx 14rpx rgba(20, 184, 166, 0.18);
}

.yd-tutor-brand-lines {
  display: grid;
  gap: 2rpx;
  min-width: 0;
}

.yd-tutor-brand-lines text {
  display: block;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand-lines text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.12;
}

.yd-tutor-brand-lines text:last-child {
  color: #0d9488;
  font-size: 21rpx;
  font-weight: 820;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  display: none;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid rgba(17, 24, 39, 0.06);
  border-radius: 999rpx;
  color: rgba(17, 24, 39, 0.78);
  background: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.yd-tutor-hero,
.tutor-chat-card,
.tutor-socratic-panel,
.tutor-reference-panel,
.tutor-result-stack {
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(35, 71, 45, 0.08);
}

.yd-tutor-hero {
  position: relative;
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  align-items: center;
  gap: 28rpx;
  min-height: 220rpx;
  padding: 34rpx 32rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.yd-tutor-hero::after {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: #ccfbf1;
  opacity: 0.62;
}

.yd-tutor-mascot {
  position: relative;
  z-index: 1;
  display: block;
  width: 144rpx;
  height: 144rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(20, 184, 166, 0.16);
  border-radius: 32rpx;
  background: linear-gradient(135deg, #e6f4f1, #ccfbf1);
  overflow: hidden;
}

.yd-tutor-hero::before {
  content: "";
  position: absolute;
  left: 150rpx;
  top: 28rpx;
  z-index: 2;
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: #fbbf24;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(251, 191, 36, 0.4);
}

.yd-tutor-bubble {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.yd-tutor-bubble-title {
  display: block;
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.12;
  letter-spacing: 0;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  overflow: hidden;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.58;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 24rpx;
  flex: 0 0 auto;
  min-height: 306rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(240, 235, 225, 0.9);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.04);
}

.tutor-chat-card.compact {
  min-height: 0;
  padding: 22rpx;
}

.tutor-chat-title {
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 950;
}

.tutor-chat-online {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 920;
}

.tutor-message-row {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
}

.tutor-avatar-dot {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #14b8a6;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  box-shadow: 0 8rpx 18rpx rgba(20, 184, 166, 0.18);
}

.tutor-bubble {
  display: block;
  max-width: 100%;
  padding: 22rpx 24rpx;
  border-radius: 36rpx 36rpx 36rpx 8rpx;
  color: #374151;
  background: #f7f8fa;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.48;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bubble.me {
  justify-self: end;
  grid-column: 1 / -1;
  max-width: 86%;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  color: #ffffff;
  background: #14b8a6;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
}

.tutor-thinking-line {
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 22rpx;
  font-weight: 880;
}

.tutor-thinking-line.dialogue {
  justify-self: start;
  margin-left: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 22rpx;
}

.tutor-input-bar {
  position: relative;
  display: block;
  min-height: 96rpx;
  padding: 0;
  border: 2rpx solid #e5e7eb;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: inset 0 4rpx 12rpx rgba(17, 24, 39, 0.025);
}

.tutor-input-bar textarea {
  width: 100%;
  min-height: 96rpx;
  max-height: 152rpx;
  box-sizing: border-box;
  padding: 26rpx 104rpx 20rpx 32rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 760;
  line-height: 40rpx;
}

.tutor-input-bar text {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  min-width: 0;
  height: 72rpx;
  width: 72rpx;
  padding: 0 18rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 72rpx;
  text-align: center;
}

.tutor-socratic-panel {
  display: grid;
  gap: 24rpx;
  padding: 0 0 4rpx;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}

.tutor-section-head text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #6b7280;
  font-size: 21rpx;
  font-weight: 780;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx;
}

.tutor-mode-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 170rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 24rpx 8rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 28rpx;
  color: #374151;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.045);
  font-size: 24rpx;
  font-weight: 860;
  line-height: 1.15;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-mode-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  padding: 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1;
}

.tutor-mode-card > text:last-child {
  display: block;
  color: #374151;
  font-size: 24rpx;
  font-weight: 880;
  line-height: 1.15;
}

.tutor-mode-icon {
  background-position: center;
  background-repeat: no-repeat;
  background-size: 44rpx 44rpx;
}

.tutor-mode-card:nth-child(1) .tutor-mode-icon { background-color: #fff7ed; color: #ea580c; background-image: url("data:image/svg+xml;base64,"); }
.tutor-mode-card:nth-child(2) .tutor-mode-icon { background-color: #f0fdf4; color: #16a34a; background-image: url("data:image/svg+xml;base64,"); }
.tutor-mode-card:nth-child(3) .tutor-mode-icon { background-color: #eff6ff; color: #2563eb; background-image: url("data:image/svg+xml;base64,"); }
.tutor-mode-card:nth-child(4) .tutor-mode-icon { background-color: #f5f3ff; color: #7c3aed; background-image: url("data:image/svg+xml;base64,"); }

.tutor-start-cta {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 18rpx 34rpx rgba(251, 191, 36, 0.35);
  font-size: 34rpx;
  font-weight: 950;
}

.tutor-start-row {
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
}

.tutor-start-secondary {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #f0ebe1;
  border-radius: 28rpx;
  color: #6b7280;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.055);
  font-size: 36rpx;
  font-weight: 900;
}

.tutor-usage-note {
  display: block;
  margin: -2rpx 0 0;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.4;
  text-align: center;
}

.tutor-reference-panel,
.tutor-result-stack {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
}

.tutor-reference-panel {
  min-height: calc(100vh - 196rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
}

.tutor-reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.tutor-reference-head text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 950;
}

.tutor-reference-head text:last-child {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 900;
}

.tutor-dialogue-card,
.tutor-stuck-panel,
.tutor-recap-panel,
.tutor-socratic-brief,
.tutor-bridge-card {
  display: grid;
  gap: 14rpx;
}

.tutor-dialogue-card > text,
.tutor-stuck-lead,
.tutor-stuck-question,
.tutor-feedback-note {
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 26rpx;
  font-weight: 780;
  line-height: 1.45;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-card > text.tutor-dialogue-user {
  justify-self: end;
  color: #ffffff;
  background: #f59e0b;
}

.tutor-pointing-grid,
.tutor-stuck-action-grid,
.tutor-brief-steps,
.tutor-micro-choice-row,
.tutor-feedback-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-pointing-grid text,
.tutor-dialogue-actions > text,
.tutor-stuck-action-card,
.tutor-stuck-footer text,
.tutor-micro-choice-row text,
.tutor-feedback-good,
.tutor-feedback-stuck,
.tutor-bridge-action {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  border-radius: 22rpx;
  color: #1f2937;
  background: #fff7ed;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-recap-panel {
  padding: 28rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 90% 6%, rgba(20, 184, 166, 0.18), transparent 25%),
    #f8fffd;
}

.tutor-recap-hero,
.tutor-recap-card {
  display: grid;
  gap: 12rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(20, 184, 166, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.tutor-recap-hero text:first-child,
.tutor-recap-card > text {
  color: #0d9488;
  font-size: 24rpx;
  font-weight: 950;
}

.tutor-recap-hero text:last-child {
  color: #1f2937;
  font-size: 34rpx;
  line-height: 46rpx;
  font-weight: 920;
}

.tutor-recap-card textarea {
  width: 100%;
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: 24rpx;
  color: #1f2937;
  background: #f6f8f3;
  font-size: 27rpx;
  line-height: 38rpx;
}

.tutor-reference-dialogue {
  display: grid;
  gap: 16rpx;
}

.tutor-knowledge-board {
  display: grid;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 90% 6%, rgba(251, 191, 36, 0.22), transparent 25%),
    #fffaf0;
}

.tutor-knowledge-subject {
  color: #0d9488;
  font-size: 24rpx;
  font-weight: 900;
}

.tutor-knowledge-title {
  color: #1f2937;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.1;
}

.tutor-blackboard {
  display: grid;
  gap: 0;
  overflow: hidden;
  border: 1rpx solid #f0ebe1;
  border-radius: 30rpx;
  background: #ffffff;
}

.tutor-blackboard text {
  display: block;
  padding: 22rpx;
  border-bottom: 1rpx solid #f0ebe1;
  color: #374151;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.tutor-blackboard text:first-child {
  color: #1f2937;
  font-size: 33rpx;
  font-weight: 950;
}

.tutor-blackboard text:last-child {
  border-bottom: 0;
}

.tutor-pointing-panel {
  position: relative;
  display: grid;
  gap: 28rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 0;
  background:
    radial-gradient(circle at 90% -8%, rgba(255, 122, 69, 0.08), transparent 28%),
    radial-gradient(circle at 0% 28%, rgba(20, 184, 166, 0.08), transparent 25%),
    #f9f8f4;
}

.tutor-pointing-pattern,
.tutor-stuck-pattern {
  position: absolute;
  inset: 0;
  opacity: 0.04;
  background-image: radial-gradient(#ff7a45 2rpx, transparent 2rpx);
  background-size: 32rpx 32rpx;
  pointer-events: none;
}

.tutor-pointing-lead {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 16rpx;
}

.tutor-pointing-lead text:first-child {
  justify-self: start;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e6f4f1;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.tutor-pointing-lead text:nth-child(2) {
  color: #1f2937;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.3;
}

.tutor-pointing-lead text:nth-child(2)::first-letter {
  color: inherit;
}

.tutor-pointing-lead text:nth-child(2) > text {
  position: relative;
  display: inline-flex;
  color: #ff7a45;
}

.tutor-pointing-lead text:nth-child(2) > text::after {
  content: "";
  position: absolute;
  top: 4rpx;
  right: -12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #14b8a6;
}

.tutor-pointing-lead text:nth-child(3) {
  justify-self: start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

.tutor-pointing-lead > text:nth-child(3) {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 920;
}

.tutor-question-box {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 22rpx;
  min-height: 264rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(240, 235, 225, 0.8);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.055);
}

.tutor-question-box textarea {
  width: 100%;
  min-height: 176rpx;
  max-height: 260rpx;
  box-sizing: border-box;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 760;
  line-height: 42rpx;
}

.tutor-question-media-row {
  display: grid;
  grid-template-columns: 112rpx 112rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: end;
}

.tutor-question-thumb,
.tutor-question-camera {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
}

.tutor-question-thumb {
  border: 1rpx solid #f0ebe1;
  background:
    linear-gradient(135deg, rgba(20, 184, 166, 0.18), rgba(255, 122, 69, 0.12)),
    #f9f8f4;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.04);
}

.tutor-question-camera {
  border: 2rpx dashed #d1ccc2;
  background: #f9f8f4;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 900;
}

.tutor-question-safe {
  justify-self: end;
  color: #b8b8b8;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.tutor-question-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.tutor-question-tools text {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 25rpx;
  font-weight: 940;
}

.tutor-question-tools text:first-child {
  color: #78350f;
  background: #fef3c7;
}

.tutor-pointing-mode-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.tutor-pointing-mode-row > text::before {
  content: "";
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
