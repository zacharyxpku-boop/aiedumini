page {
  background: #f4f2ec;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #2d2c2a;
  background:
    radial-gradient(circle at 50% -80rpx, rgba(242, 212, 121, 0.18), rgba(242, 212, 121, 0) 360rpx),
    #f4f2ec;
}

.tutor-shell {
  position: relative;
  min-height: 100vh;
}

.tutor-main {
  height: 100vh;
}

.main-inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: calc(108rpx + env(safe-area-inset-top)) 30rpx calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.yd-tutor-screen {
  position: relative;
  padding: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 8% 4%, rgba(248, 198, 34, 0.17), transparent 24%),
    radial-gradient(circle at 92% 8%, rgba(34, 185, 92, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-section-head,
.tutor-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-tutor-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(76, 159, 255, 0.16);
  border-radius: 18rpx;
  background: #eef7ff;
  box-shadow: 0 14rpx 26rpx rgba(76, 159, 255, 0.12);
}

.yd-tutor-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-tutor-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
}

.yd-tutor-hero {
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  gap: 12rpx;
  align-items: center;
  margin-top: 18rpx;
}

.yd-tutor-mascot {
  width: 150rpx;
  height: 140rpx;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: #effaf0;
}

.yd-tutor-bubble {
  min-width: 0;
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.yd-tutor-bubble view:first-child {
  color: #101a16;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.12;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 21rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-chip-row text {
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 19rpx;
  font-weight: 820;
  white-space: nowrap;
}

.tutor-flow-card {
  margin-top: 12rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.tutor-section-head text:first-child {
  color: #18211d;
  font-size: 27rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
}

.tutor-ladder {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-ladder-node {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 100rpx;
  align-content: center;
  justify-items: center;
  gap: 5rpx;
  padding: 10rpx 4rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 19rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8faf5 100%);
  box-shadow: 0 12rpx 24rpx rgba(41, 65, 52, 0.07);
}

.tutor-ladder-node:active {
  transform: translateY(1rpx);
  box-shadow: 0 8rpx 18rpx rgba(41, 65, 52, 0.05);
}

.tutor-ladder-node::after {
  content: "";
  position: absolute;
  top: 50%;
  right: -14rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #dce8dc;
  transform: translateY(-50%);
}

.tutor-ladder-node:last-child::after {
  display: none;
}

.tutor-ladder-icon {
  width: 42rpx;
  height: 42rpx;
  padding: 6rpx;
  border-radius: 15rpx;
  background: #f0f8ee;
}

.tutor-ladder-node text {
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-ladder-node text:nth-child(2) {
  color: #17211d;
  font-size: 18rpx;
  font-weight: 950;
  line-height: 1.18;
}

.tutor-ladder-node text:nth-child(3) {
  color: #526158;
  font-size: 16rpx;
  font-weight: 780;
  line-height: 1.18;
}

.tutor-ladder-node.active {
  border-color: rgba(76, 159, 255, 0.32);
  background: linear-gradient(180deg, #eef7ff 0%, #ffffff 100%);
}

.tutor-ladder-node.final {
  border-color: rgba(248, 198, 34, 0.34);
  background: linear-gradient(180deg, #fff8df 0%, #ffffff 100%);
}

.tutor-ladder-node.active .tutor-ladder-icon {
  background: #e5f2ff;
}

.tutor-ladder-node.final .tutor-ladder-icon {
  background: #fff1bd;
}

.tutor-chat-card {
  display: grid;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.tutor-chat-title {
  color: #18211d;
  font-size: 25rpx;
  font-weight: 950;
}

.tutor-chat-card .tutor-bubble {
  max-width: 82%;
  padding: 13rpx 16rpx;
  border-radius: 20rpx;
  color: #31423a;
  background: #f1f7ef;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.42;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
  background: #eaf3ff;
}

.tutor-input-bar {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx 0 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 999rpx;
  background: #ffffff;
}

.tutor-input-bar text {
  min-width: 0;
  overflow: hidden;
  color: #8a958f;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-input-bar view {
  flex: 0 0 auto;
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  font-size: 20rpx;
  font-weight: 950;
  line-height: 46rpx;
}

.tutor-action-row {
  margin-top: 12rpx;
}

.tutor-primary,
.tutor-secondary {
  flex: 1 1 0;
  height: 66rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 66rpx;
  text-align: center;
}

.tutor-primary {
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
}

.tutor-secondary {
  color: #14854a;
  background: #ebf9ed;
}
