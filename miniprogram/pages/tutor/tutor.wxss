page {
  background: #f6f8f3;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #1f2937;
  background: #f9f8f4;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(86rpx + env(safe-area-inset-top)) 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow: visible;
  border-radius: 0;
  background: #f9f8f4;
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-chat-head,
.tutor-section-head {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-tutor-top {
  position: relative;
  z-index: 8;
  margin: 0 -32rpx;
  padding: 0 32rpx 8rpx;
  background: rgba(246, 248, 243, 0.92);
}

.yd-tutor-brand {
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #14b8a6;
  box-shadow: 0 8rpx 18rpx rgba(20, 184, 166, 0.16);
}

.yd-tutor-brand-lines {
  display: grid;
  gap: 2rpx;
  min-width: 0;
}

.yd-tutor-brand-lines text {
  display: block;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand-lines text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.12;
}

.yd-tutor-brand-lines text:last-child {
  color: #0d9488;
  font-size: 20rpx;
  font-weight: 820;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 999rpx;
  color: #1f2937;
  background: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  font-weight: 900;
}

.yd-tutor-hero,
.tutor-chat-card,
.tutor-socratic-panel,
.tutor-reference-panel,
.tutor-result-stack {
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(20, 184, 166, 0.05);
}

.yd-tutor-hero {
  position: relative;
  display: grid;
  grid-template-columns: 216rpx minmax(0, 1fr);
  align-items: center;
  gap: 24rpx;
  min-height: 294rpx;
  padding: 30rpx;
  overflow: hidden;
}

.yd-tutor-hero::after {
  content: "";
  position: absolute;
  top: -70rpx;
  right: -70rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: #e6f4f1;
  opacity: 0.7;
}

.yd-tutor-mascot {
  position: relative;
  z-index: 1;
  width: 216rpx;
  height: 208rpx;
  object-fit: contain;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #e6f4f1 0%, #ccfbf1 100%);
}

.yd-tutor-bubble {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.yd-tutor-bubble-title {
  display: block;
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.08;
  letter-spacing: 0;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  overflow: hidden;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.tutor-care-line {
  display: none;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 16rpx;
  flex: 0 0 auto;
  min-height: 318rpx;
  padding: 28rpx;
}

.tutor-chat-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
}

.tutor-chat-online {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 920;
}

.tutor-chat-clock {
  justify-self: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #9ca3af;
  background: #f3f4f6;
  font-size: 21rpx;
  font-weight: 820;
}

.tutor-service-status {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: #e6f4f1;
}

.tutor-service-status text:first-child {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.tutor-service-status text:last-child {
  min-width: 0;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.28;
}

.tutor-bubble {
  display: block;
  max-width: 86%;
  padding: 18rpx 22rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 1.48;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bubble.me {
  justify-self: end;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  color: #ffffff;
  background: #14b8a6;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
}

.tutor-thinking-line {
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 22rpx;
  font-weight: 880;
}

.tutor-input-bar {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 0 20rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: inset 0 4rpx 10rpx rgba(17, 24, 39, 0.03);
}

.tutor-input-bar input {
  flex: 1 1 auto;
  min-width: 0;
  height: 82rpx;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 82rpx;
}

.tutor-input-bar text {
  flex: 0 0 auto;
  min-width: 72rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #14b8a6;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 72rpx;
  text-align: center;
}

.tutor-socratic-panel {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
}

.tutor-section-head text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #6b7280;
  font-size: 21rpx;
  font-weight: 780;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.tutor-mode-card {
  display: flex;
  min-width: 0;
  min-height: 116rpx;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 24rpx;
  color: #374151;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
  font-size: 22rpx;
  font-weight: 860;
  line-height: 1.15;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-mode-card:nth-child(1) { background: #fff7ed; color: #ea580c; }
.tutor-mode-card:nth-child(2) { background: #f0fdf4; color: #16a34a; }
.tutor-mode-card:nth-child(3) { background: #eff6ff; color: #2563eb; }
.tutor-mode-card:nth-child(4) { background: #f5f3ff; color: #7c3aed; }

.tutor-prompt-board {
  display: block;
  color: #9ca3af;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.35;
  text-align: center;
}

.tutor-start-cta {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 12rpx 28rpx rgba(251, 191, 36, 0.35);
  font-size: 32rpx;
  font-weight: 950;
}

.tutor-reference-panel,
.tutor-result-stack {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
}

.tutor-reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.tutor-reference-head text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
}

.tutor-reference-head text:last-child {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 900;
}

.tutor-dialogue-card,
.tutor-stuck-panel,
.tutor-socratic-brief,
.tutor-bridge-card {
  display: grid;
  gap: 14rpx;
}

.tutor-dialogue-card > text,
.tutor-stuck-lead,
.tutor-stuck-question,
.tutor-feedback-note {
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 25rpx;
  font-weight: 780;
  line-height: 1.45;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-card > text.tutor-dialogue-user {
  justify-self: end;
  color: #ffffff;
  background: #f59e0b;
}

.tutor-pointing-grid,
.tutor-stuck-action-grid,
.tutor-brief-steps,
.tutor-micro-choice-row,
.tutor-feedback-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-pointing-grid text,
.tutor-dialogue-actions > text,
.tutor-stuck-action-card,
.tutor-stuck-footer text,
.tutor-micro-choice-row text,
.tutor-feedback-good,
.tutor-feedback-stuck,
.tutor-bridge-action {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  border-radius: 22rpx;
  color: #1f2937;
  background: #fff7ed;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-stuck-action-card {
  min-height: 150rpx;
  align-content: center;
  border: 2rpx solid #fed7aa;
}

.tutor-stuck-action-card > text:first-child {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 950;
}

.tutor-stuck-action-card > text:last-child {
  margin-top: 6rpx;
  color: #9a3412;
  font-size: 21rpx;
  font-weight: 760;
}

.tutor-stuck-journal {
  display: grid;
  gap: 10rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx #f3f4f6;
}

.tutor-stuck-journal text {
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.38;
}

.tutor-stuck-footer {
  display: grid;
  gap: 12rpx;
}

.tutor-brief-head,
.tutor-brief-actions,
.tutor-bridge-head {
  display: grid;
  gap: 8rpx;
}

.tutor-brief-head text:first-child,
.tutor-bridge-head text:first-child {
  justify-self: start;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #14b8a6;
  font-size: 20rpx;
  font-weight: 950;
}

.tutor-brief-head text:last-child,
.tutor-bridge-head text:last-child,
.tutor-brief-question {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.36;
}

.tutor-brief-step {
  display: -webkit-box;
  min-height: 104rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.tutor-brief-actions {
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
}

.tutor-brief-actions text {
  min-width: 0;
  color: #6b7280;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.28;
}

.tutor-brief-actions text:nth-child(2),
.tutor-brief-actions text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  white-space: nowrap;
}

.tutor-diagnostic-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  color: #1f2937;
  background: #fff7ed;
}

.tutor-diagnostic-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-diagnostic-card text:first-child {
  grid-column: 1 / -1;
  font-size: 26rpx;
  font-weight: 950;
}

.tutor-diagnostic-action {
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #ffffff;
  line-height: 64rpx;
  text-align: center;
}

.tutor-diagnostic-action.primary {
  color: #ffffff;
  background: #14b8a6;
}

.tutor-reference-panel.dialogue,
.tutor-reference-panel.knowledge,
.tutor-reference-panel.pointing,
.tutor-reference-panel.stuck {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card {
  min-height: 520rpx;
  padding: 26rpx 0 34rpx;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card > text {
  max-width: 78%;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tutor-reference-panel.dialogue .tutor-dialogue-card > text.tutor-dialogue-user {
  border-radius: 28rpx 28rpx 8rpx 28rpx;
}

.tutor-reference-panel.knowledge .tutor-dialogue-card {
  gap: 0;
  overflow: hidden;
  border: 1rpx solid #f0ebe1;
  border-radius: 28rpx;
  background: #ffffff;
}

.tutor-reference-panel.knowledge .tutor-dialogue-card > text {
  border-bottom: 1rpx solid #f0ebe1;
  border-radius: 0;
  background: #ffffff;
}

.tutor-reference-panel.pointing .tutor-pointing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.tutor-reference-panel.pointing .tutor-pointing-grid text {
  min-height: 106rpx;
}
