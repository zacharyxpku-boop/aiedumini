page {
  background: #f4f2ec;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #2d2c2a;
  background:
    radial-gradient(circle at 50% -80rpx, rgba(242, 212, 121, 0.18), rgba(242, 212, 121, 0) 360rpx),
    #f4f2ec;
}

.tutor-shell {
  position: relative;
  min-height: 100vh;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(148rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 16rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 22rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 216, 79, 0.22) 0%, rgba(255, 216, 79, 0) 32%),
    linear-gradient(205deg, rgba(76, 159, 255, 0.18) 0%, rgba(76, 159, 255, 0) 34%),
    linear-gradient(180deg, #fffef8 0%, #f3fbef 58%, #eef7ff 100%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.04);
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-tutor-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(76, 159, 255, 0.16);
  border-radius: 18rpx;
  background: #eef7ff;
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.08);
}

.yd-tutor-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-tutor-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 22rpx;
  font-weight: 900;
}

.yd-tutor-hero {
  display: grid;
  grid-template-columns: 218rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 294rpx;
  margin-top: 0;
  padding: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(239, 248, 255, 0.92) 100%);
}

.yd-tutor-mascot {
  width: 216rpx;
  height: 208rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: #f1fbef;
}

.yd-tutor-bubble {
  min-width: 0;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.035);
}

.yd-tutor-bubble-title {
  display: block;
  color: #101a16;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 1.12;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 26rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-context-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tutor-context-chips text {
  max-width: 100%;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #216a46;
  background: #f0fbef;
  font-size: 20rpx;
  font-weight: 860;
  line-height: 1.18;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-chip-row text {
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 21rpx;
  font-weight: 820;
  white-space: normal;
}

.tutor-care-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 13rpx 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 20rpx;
  background: rgba(240, 251, 240, 0.92);
}

.tutor-care-line text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-care-line text:first-child {
  flex: 0 0 auto;
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.tutor-care-line text:last-child {
  color: #65746c;
  font-size: 21rpx;
  font-weight: 790;
  text-align: right;
}

.tutor-thinking-line {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  color: #6f5b11;
  background: #fff6cf;
  font-size: 22rpx;
  font-weight: 880;
  line-height: 1.25;
}

.tutor-socratic-panel,
.tutor-result-stack,
.tutor-reference-panel {
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 248, 223, 0.9));
  box-shadow: none;
}

.tutor-reference-panel {
  display: grid;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.96);
}

.tutor-reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tutor-reference-head text:first-child {
  color: #14241d;
  font-size: 28rpx;
  font-weight: 950;
}

.tutor-reference-head text:last-child {
  color: #66756c;
  font-size: 21rpx;
  font-weight: 850;
}

.tutor-dialogue-card,
.tutor-blackboard,
.tutor-pointing-panel,
.tutor-recover-card {
  display: grid;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #f8fbf4;
}

.tutor-dialogue-card > text,
.tutor-blackboard > text,
.tutor-pointing-panel > text,
.tutor-recover-card > text {
  color: #314238;
  font-size: 23rpx;
  font-weight: 780;
  line-height: 1.36;
}

.tutor-dialogue-user {
  justify-self: end;
  max-width: 84%;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  color: #17342b !important;
  background: #fff0b6;
}

.tutor-dialogue-card view,
.tutor-blackboard view,
.tutor-recover-card view {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tutor-dialogue-card view text,
.tutor-blackboard view text,
.tutor-recover-card view text,
.tutor-panel-cta {
  padding: 11rpx 15rpx;
  border-radius: 999rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 22rpx;
  font-weight: 930;
  line-height: 1.15;
}

.tutor-pointing-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.tutor-pointing-grid text,
.tutor-recover-action {
  min-height: 62rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  color: #1d4434 !important;
  background: #ffffff;
  font-size: 22rpx !important;
  font-weight: 900 !important;
  line-height: 1.25 !important;
}

.tutor-recover-title {
  color: #14241d !important;
  font-size: 27rpx !important;
  font-weight: 950 !important;
}

.tutor-recover-note {
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: #fff7d8;
}

.tutor-result-stack {
  display: grid;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.94);
}

.tutor-socratic-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-socratic-steps view {
  display: grid;
  min-width: 0;
  min-height: 106rpx;
  align-content: center;
  gap: 5rpx;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
  background: #f6fbf0;
}

.tutor-socratic-steps view.active {
  background: #eef7ff;
  box-shadow: inset 0 0 0 2rpx rgba(76, 159, 255, 0.16);
}

.tutor-socratic-steps text {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.tutor-socratic-steps text:first-child {
  justify-self: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: #ffd84f;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 34rpx;
}

.tutor-socratic-steps text:nth-child(2) {
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.18;
}

.tutor-socratic-steps text:nth-child(3) {
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.24;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.tutor-mode-card {
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  color: #31423a;
  background: #ffffff;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.16;
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.04);
}

.tutor-mode-card:nth-child(1) {
  color: #c96a1d;
  background: #fff7ed;
}

.tutor-mode-card:nth-child(2) {
  color: #14854a;
  background: #f0fdf4;
}

.tutor-mode-card:nth-child(3) {
  color: #2376d2;
  background: #eff6ff;
}

.tutor-mode-card:nth-child(4) {
  color: #6d4fd7;
  background: #f5f3ff;
}

.tutor-prompt-board {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: #eef7ff;
  overflow-wrap: break-word;
  word-break: break-word;
  color: #536158;
  font-size: 23rpx;
  font-weight: 790;
  line-height: 1.32;
}

.tutor-start-cta {
  min-height: 92rpx;
  margin-top: 16rpx;
  border-radius: 28rpx;
  color: #17342b;
  background: linear-gradient(180deg, #ffd84f 0%, #f3b51b 100%);
  font-size: 32rpx;
  font-weight: 950;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 12rpx 24rpx rgba(248, 198, 34, 0.24);
}

.tutor-reference-panel {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.96);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 4%, rgba(255, 216, 79, 0.18), transparent 36%),
    rgba(255, 255, 255, 0.96);
}

.tutor-reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tutor-reference-head text:first-child {
  color: #13221b;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.12;
}

.tutor-reference-head text:last-child {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #2376d2;
  background: #eef7ff;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.tutor-blackboard {
  display: grid;
  grid-template-columns: 164rpx minmax(0, 1fr);
  gap: 10rpx 12rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #17342b;
}

.tutor-blackboard text {
  color: #eaf7ee;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.28;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-blackboard text:nth-child(odd) {
  color: #ffd84f;
  font-weight: 950;
}

.tutor-pointing-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.tutor-pointing-grid text,
.tutor-recover-action,
.tutor-dialogue-card > text:last-child {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 22rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.16;
  text-align: center;
}

.tutor-recover-card,
.tutor-dialogue-card {
  display: grid;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #f5fbef;
}

.tutor-recover-card > text,
.tutor-dialogue-card > text:first-child {
  color: #536158;
  font-size: 24rpx;
  font-weight: 820;
  line-height: 1.34;
}

.tutor-recover-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.tutor-recover-card > text:first-child {
  grid-column: 1 / -1;
}

.tutor-section-head text:first-child {
  color: #18211d;
  font-size: 23rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 14rpx;
  flex: 0 0 auto;
  min-height: 352rpx;
  max-height: none;
  margin-top: 0;
  padding: 20rpx 18rpx 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 4%, rgba(255, 216, 79, 0.18), transparent 35%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 251, 243, 0.96));
  box-shadow: 0 14rpx 30rpx rgba(38, 58, 43, 0.055);
}

.tutor-chat-head {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tutor-chat-title {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
}

.tutor-chat-online,
.tutor-chat-clock {
  display: block;
  color: #18a94f;
  font-size: 20rpx;
  font-weight: 900;
}

.tutor-chat-online {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #edf9ef;
}

.tutor-chat-clock {
  justify-self: center;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #8a958f;
  background: #f2f4ef;
}

.tutor-service-status {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: #f2fbf1;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.12);
}

.tutor-service-status text:first-child {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #0d7a3d;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 36rpx;
  white-space: nowrap;
}

.tutor-service-status text:last-child {
  min-width: 0;
  color: #536158;
  font-size: 21rpx;
  font-weight: 790;
  line-height: 1.28;
}

.tutor-chat-card .tutor-bubble {
  max-width: 78%;
  padding: 16rpx 18rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  color: #31423a;
  background: #ffffff;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 1.46;
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.05);
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  color: #ffffff;
  background: #2aa9b5;
  box-shadow: 0 10rpx 20rpx rgba(42, 169, 181, 0.16);
}

/* Reference HTML alignment: full app canvas, not a nested poster card. */
page {
  background: #f3f4f6;
}

.tutor-page {
  background: #f3f4f6;
}

.main-inner {
  padding: calc(88rpx + env(safe-area-inset-top)) 32rpx calc(142rpx + env(safe-area-inset-bottom));
}

.yd-tutor-screen {
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 0;
  gap: 20rpx;
  border: 0;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.yd-tutor-top {
  position: relative;
  z-index: 8;
  margin: 0 -32rpx;
  padding: 24rpx 32rpx 14rpx;
  background: rgba(249, 248, 244, 0.92);
}

.yd-tutor-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #14b8a6;
}

.yd-tutor-brand text:first-child {
  font-size: 26rpx;
  font-weight: 900;
}

.yd-tutor-brand text:last-child {
  color: #0f8f7c;
  font-size: 20rpx;
  font-weight: 800;
}

.yd-tutor-pill {
  color: #2f2a16;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.04);
}

.yd-tutor-hero,
.tutor-chat-card,
.tutor-socratic-panel,
.tutor-reference-panel,
.tutor-result-stack {
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.yd-tutor-hero {
  grid-template-columns: 128rpx minmax(0, 1fr);
  min-height: 184rpx;
  padding: 28rpx;
}

.yd-tutor-mascot {
  width: 124rpx;
  height: 124rpx;
  border: 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #ccfbf1, #ecfeff);
}

.yd-tutor-bubble {
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.yd-tutor-bubble-title {
  font-size: 44rpx;
  line-height: 1.14;
}

.yd-tutor-bubble > text {
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-line-clamp: 3;
}

.tutor-care-line {
  display: none;
}

.tutor-chat-card {
  min-height: 292rpx;
  padding: 28rpx;
  background: #ffffff;
}

.tutor-chat-title {
  font-size: 30rpx;
}

.tutor-chat-card .tutor-bubble {
  max-width: 86%;
  background: #f9f8f4;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.04);
}

.tutor-input-bar input {
  min-height: 86rpx;
  border-radius: 30rpx;
  background: #ffffff;
}

.tutor-mode-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.tutor-mode-card {
  min-height: 118rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.05);
}

.tutor-start-cta {
  min-height: 100rpx;
  border-radius: 32rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 16rpx 30rpx rgba(251, 191, 36, 0.3);
}

.tutor-socratic-brief {
  display: grid;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(24, 169, 79, 0.18);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f2fbf1 0%, #eef7ff 100%);
}

.tutor-socratic-brief > view:first-child,
.tutor-socratic-brief > view:last-child {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tutor-socratic-brief text {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-socratic-brief > view:first-child text:first-child {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a94f;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.tutor-socratic-brief > view:first-child text:last-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.tutor-socratic-brief > text {
  color: #27362e;
  font-size: 25rpx;
  font-weight: 860;
  line-height: 1.36;
}

.tutor-brief-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.tutor-brief-step {
  display: -webkit-box;
  min-width: 0;
  min-height: 112rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  color: #27362e;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.24;
  box-shadow: inset 0 0 0 1rpx rgba(24, 169, 79, 0.12);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.tutor-socratic-brief > view:last-child text:first-child {
  flex: 1 1 auto;
  color: #66746d;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.28;
}

.tutor-socratic-brief > view:last-child text:nth-child(2),
.tutor-socratic-brief > view:last-child text:last-child {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 950;
}

.tutor-socratic-brief > view:last-child text:nth-child(2) {
  color: #23679f;
  background: #eef7ff;
}

.tutor-socratic-brief > view:last-child text:last-child {
  color: #0f5f39;
  background: #ffffff;
}

.tutor-diagnostic-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #fff8df;
  box-shadow: inset 0 0 0 1rpx rgba(248, 198, 34, 0.22);
}

.tutor-diagnostic-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #27362e;
  font-size: 21rpx;
  font-weight: 860;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-diagnostic-card text:first-child {
  grid-column: 1 / -1;
  color: #8a6414;
  font-size: 22rpx;
  font-weight: 950;
}

.tutor-diagnostic-action {
  display: flex;
  grid-column: span 1;
  min-width: 0;
  min-height: 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #173f31;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.14);
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}

.tutor-diagnostic-action.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #22b95c, #108d4e);
  box-shadow: none;
}

.tutor-input-bar {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 4rpx;
  padding: 0 9rpx 0 22rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 999rpx;
  background: #f3f0eb;
}

.tutor-input-bar input {
  flex: 1 1 auto;
  min-width: 0;
  height: 88rpx;
  color: #8a958f;
  font-size: 26rpx;
  font-weight: 760;
  line-height: 88rpx;
}

.tutor-feedback-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.tutor-micro-choice-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.tutor-micro-choice-row text {
  display: flex;
  min-width: 0;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #174c3d;
  background: #edf9ef;
  font-size: 23rpx;
  font-weight: 930;
  line-height: 1.16;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.18);
}

.tutor-micro-choice-row text:active {
  transform: scale(0.985);
}

.tutor-feedback-good,
.tutor-feedback-stuck {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-feedback-good {
  color: #163321;
  background: #e8f8e8;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.14);
}

.tutor-feedback-stuck {
  color: #463a12;
  background: #fff4c6;
  box-shadow: inset 0 0 0 2rpx rgba(248, 198, 34, 0.2);
}

.tutor-feedback-good:active,
.tutor-feedback-stuck:active {
  transform: scale(0.985);
}

.tutor-feedback-note {
  display: block;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  color: #536158;
  background: #f8fbf4;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.32;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bridge-card {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #fff8df;
  box-shadow: inset 0 0 0 1rpx rgba(248, 198, 34, 0.22);
}

.tutor-bridge-card > view:first-child {
  display: grid;
  gap: 4rpx;
}

.tutor-bridge-card text {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bridge-card > view:first-child text:first-child {
  color: #8a6414;
  font-size: 20rpx;
  font-weight: 950;
}

.tutor-bridge-card > view:first-child text:last-child {
  color: #1f211d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.26;
}

.tutor-bridge-card > text {
  color: #675b42;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.28;
}

.tutor-bridge-action {
  justify-self: start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a94f;
  font-size: 22rpx;
  font-weight: 950;
}

.tutor-input-bar text {
  flex: 0 0 auto;
  height: 70rpx;
  min-width: 70rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ff7a1a;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 70rpx;
  text-align: center;
}

/* Reference child-page alignment: dialogue / blackboard / pointing / recovery. */
.tutor-reference-panel.dialogue,
.tutor-reference-panel.knowledge,
.tutor-reference-panel.pointing,
.tutor-reference-panel.stuck {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.tutor-reference-panel.dialogue .tutor-reference-head {
  justify-content: center;
  padding: 10rpx 0 4rpx;
}

.tutor-reference-panel.dialogue .tutor-reference-head text:first-child {
  font-size: 32rpx;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card {
  gap: 18rpx;
  min-height: 520rpx;
  padding: 28rpx 20rpx 34rpx;
  border-radius: 0;
  background: transparent;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card > text {
  max-width: 82%;
  padding: 18rpx 22rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.06);
  color: #374151;
  font-size: 28rpx;
  line-height: 1.55;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card > text.tutor-dialogue-user {
  justify-self: end;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  color: #ffffff !important;
  background: #ff8a4c;
}

.tutor-reference-panel.knowledge .tutor-reference-head,
.tutor-reference-panel.pointing .tutor-reference-head,
.tutor-reference-panel.stuck .tutor-reference-head {
  display: grid;
  justify-items: start;
  gap: 10rpx;
}

.tutor-reference-panel.knowledge .tutor-reference-head text:first-child,
.tutor-reference-panel.stuck .tutor-reference-head text:first-child {
  max-width: 560rpx;
  font-size: 50rpx;
  line-height: 1.16;
}

.tutor-reference-panel.pointing .tutor-reference-head text:first-child {
  max-width: 560rpx;
  font-size: 46rpx;
  line-height: 1.18;
}

.tutor-reference-panel.knowledge .tutor-reference-head text:last-child,
.tutor-reference-panel.pointing .tutor-reference-head text:last-child,
.tutor-reference-panel.stuck .tutor-reference-head text:last-child {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ccfbf1;
}

.tutor-reference-panel.knowledge .tutor-dialogue-card {
  gap: 0;
  overflow: hidden;
  padding: 0;
  border: 1rpx solid #efe7db;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.tutor-reference-panel.knowledge .tutor-dialogue-card > text {
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f0ebe1;
  color: #1f2933;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.58;
}

.tutor-reference-panel.pointing .tutor-dialogue-card {
  padding: 24rpx;
  border: 1rpx solid #f0ebe1;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.tutor-reference-panel.pointing .tutor-dialogue-card > text {
  min-height: 108rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  color: #2c2621;
  font-size: 30rpx;
  font-weight: 900;
  text-align: center;
}

.tutor-reference-panel.pointing .tutor-pointing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-reference-panel.pointing .tutor-pointing-grid text {
  min-height: 106rpx;
  padding: 14rpx 10rpx;
  border: 2rpx solid #f0ebe1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
  color: #1f2933 !important;
  font-size: 25rpx !important;
  line-height: 1.18;
}

.tutor-reference-panel.stuck .tutor-dialogue-card {
  gap: 18rpx;
  padding: 0;
  background: transparent;
}

.tutor-reference-panel.stuck .tutor-dialogue-card > text {
  padding: 22rpx 24rpx;
  border: 1rpx solid #f1e6dc;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
  font-size: 27rpx;
}

.tutor-reference-panel.stuck .tutor-dialogue-card > text:nth-child(1),
.tutor-reference-panel.stuck .tutor-dialogue-card > text:nth-child(2) {
  border: 2rpx solid #ff8a4c;
  background: #fff5f0;
}
