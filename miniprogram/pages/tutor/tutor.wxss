page {
  background: #f4f2ec;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #2d2c2a;
  background:
    radial-gradient(circle at 50% -80rpx, rgba(242, 212, 121, 0.18), rgba(242, 212, 121, 0) 360rpx),
    #f4f2ec;
}

.tutor-shell {
  position: relative;
  min-height: 100vh;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(148rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 14rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  padding: 22rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 216, 79, 0.22) 0%, rgba(255, 216, 79, 0) 32%),
    linear-gradient(205deg, rgba(76, 159, 255, 0.18) 0%, rgba(76, 159, 255, 0) 34%),
    linear-gradient(180deg, #fffef8 0%, #f3fbef 58%, #eef7ff 100%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.04);
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-tutor-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(76, 159, 255, 0.16);
  border-radius: 18rpx;
  background: #eef7ff;
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.08);
}

.yd-tutor-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-tutor-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #17342b;
  background: #ffd84f;
  font-size: 22rpx;
  font-weight: 900;
}

.yd-tutor-hero {
  display: grid;
  grid-template-columns: 218rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 294rpx;
  margin-top: 0;
  padding: 16rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(239, 248, 255, 0.92) 100%);
}

.yd-tutor-mascot {
  width: 216rpx;
  height: 208rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background: #f1fbef;
}

.yd-tutor-bubble {
  min-width: 0;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.035);
}

.yd-tutor-bubble-title {
  display: block;
  color: #101a16;
  font-size: 50rpx;
  font-weight: 950;
  line-height: 1.12;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 26rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-context-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.tutor-context-chips text {
  max-width: 100%;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #216a46;
  background: #f0fbef;
  font-size: 20rpx;
  font-weight: 860;
  line-height: 1.18;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-capability-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.tutor-capability-card {
  display: grid;
  min-width: 0;
  min-height: 118rpx;
  align-content: center;
  justify-items: center;
  gap: 5rpx;
  padding: 12rpx 6rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.9);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

.tutor-capability-card image {
  width: 42rpx;
  height: 42rpx;
  object-fit: contain;
}

.tutor-capability-card text:nth-child(2) {
  color: #13241c;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.08;
}

.tutor-capability-card text:nth-child(3) {
  display: -webkit-box;
  color: #65746c;
  font-size: 20rpx;
  font-weight: 820;
  line-height: 1.16;
  text-align: center;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-chip-row text {
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 21rpx;
  font-weight: 820;
  white-space: normal;
}

.tutor-care-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 13rpx 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 20rpx;
  background: rgba(240, 251, 240, 0.92);
}

.tutor-care-line text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-care-line text:first-child {
  flex: 0 0 auto;
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.tutor-care-line text:last-child {
  color: #65746c;
  font-size: 21rpx;
  font-weight: 790;
  text-align: right;
}

.tutor-socratic-panel {
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 248, 223, 0.9));
  box-shadow: none;
}

.tutor-socratic-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.tutor-socratic-steps view {
  display: grid;
  min-width: 0;
  min-height: 106rpx;
  align-content: center;
  gap: 5rpx;
  padding: 12rpx 8rpx;
  border-radius: 18rpx;
  background: #f6fbf0;
}

.tutor-socratic-steps view.active {
  background: #eef7ff;
  box-shadow: inset 0 0 0 2rpx rgba(76, 159, 255, 0.16);
}

.tutor-socratic-steps text {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.tutor-socratic-steps text:first-child {
  justify-self: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: #ffd84f;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 34rpx;
}

.tutor-socratic-steps text:nth-child(2) {
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.18;
}

.tutor-socratic-steps text:nth-child(3) {
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.24;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 12rpx;
}

.tutor-mode-card {
  display: flex;
  min-width: 0;
  min-height: 66rpx;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 20rpx;
  color: #13723f;
  background: #f2fbf1;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.22;
}

.tutor-mode-card.primary {
  color: #16221d;
  background: linear-gradient(180deg, #ffd84f 0%, #f3b51b 100%);
  border-color: rgba(245, 179, 0, 0.72);
  box-shadow: 0 6rpx 12rpx rgba(248, 198, 34, 0.12);
}

.tutor-prompt-board {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  background: #eef7ff;
  overflow-wrap: break-word;
  word-break: break-word;
  color: #536158;
  font-size: 23rpx;
  font-weight: 790;
  line-height: 1.32;
}

.tutor-start-cta {
  min-height: 72rpx;
  margin-top: 12rpx;
  border-radius: 22rpx;
  color: #17342b;
  background: linear-gradient(180deg, #ffd84f 0%, #f3b51b 100%);
  font-size: 27rpx;
  font-weight: 950;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(248, 198, 34, 0.18);
}

.tutor-section-head text:first-child {
  color: #18211d;
  font-size: 23rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 12rpx;
  flex: 0 0 auto;
  min-height: 344rpx;
  max-height: none;
  margin-top: 0;
  padding: 20rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 251, 243, 0.94));
  box-shadow: 0 6rpx 14rpx rgba(38, 58, 43, 0.035);
}

.tutor-chat-title {
  color: #18211d;
  font-size: 28rpx;
  font-weight: 950;
}

.tutor-service-status {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: #f2fbf1;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.12);
}

.tutor-service-status text:first-child {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #0d7a3d;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 36rpx;
  white-space: nowrap;
}

.tutor-service-status text:last-child {
  min-width: 0;
  color: #536158;
  font-size: 21rpx;
  font-weight: 790;
  line-height: 1.28;
}

.tutor-chat-card .tutor-bubble {
  max-width: 82%;
  padding: 12rpx 15rpx;
  border-radius: 20rpx;
  color: #31423a;
  background: #f1f7ef;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.42;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
  background: #eaf3ff;
}

.tutor-socratic-brief {
  display: grid;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(24, 169, 79, 0.18);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f2fbf1 0%, #eef7ff 100%);
}

.tutor-socratic-brief > view:first-child,
.tutor-socratic-brief > view:last-child {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.tutor-socratic-brief text {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-socratic-brief > view:first-child text:first-child {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a94f;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.tutor-socratic-brief > view:first-child text:last-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.tutor-socratic-brief > text {
  color: #27362e;
  font-size: 25rpx;
  font-weight: 860;
  line-height: 1.36;
}

.tutor-brief-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.tutor-brief-step {
  display: -webkit-box;
  min-width: 0;
  min-height: 112rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  color: #27362e;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.24;
  box-shadow: inset 0 0 0 1rpx rgba(24, 169, 79, 0.12);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.tutor-socratic-brief > view:last-child text:first-child {
  flex: 1 1 auto;
  color: #66746d;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.28;
}

.tutor-socratic-brief > view:last-child text:nth-child(2),
.tutor-socratic-brief > view:last-child text:last-child {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 950;
}

.tutor-socratic-brief > view:last-child text:nth-child(2) {
  color: #23679f;
  background: #eef7ff;
}

.tutor-socratic-brief > view:last-child text:last-child {
  color: #0f5f39;
  background: #ffffff;
}

.tutor-diagnostic-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: #fff8df;
  box-shadow: inset 0 0 0 1rpx rgba(248, 198, 34, 0.22);
}

.tutor-diagnostic-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #27362e;
  font-size: 21rpx;
  font-weight: 860;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-diagnostic-card text:first-child {
  grid-column: 1 / -1;
  color: #8a6414;
  font-size: 22rpx;
  font-weight: 950;
}

.tutor-diagnostic-action {
  display: flex;
  grid-column: span 1;
  min-width: 0;
  min-height: 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #173f31;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.14);
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}

.tutor-diagnostic-action.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #22b95c, #108d4e);
  box-shadow: none;
}

.tutor-input-bar {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx 0 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 999rpx;
  background: #ffffff;
}

.tutor-input-bar input {
  flex: 1 1 auto;
  min-width: 0;
  height: 78rpx;
  color: #8a958f;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 78rpx;
}

.tutor-feedback-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.tutor-micro-choice-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.tutor-micro-choice-row text {
  display: flex;
  min-width: 0;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #174c3d;
  background: #edf9ef;
  font-size: 23rpx;
  font-weight: 930;
  line-height: 1.16;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.18);
}

.tutor-micro-choice-row text:active {
  transform: scale(0.985);
}

.tutor-feedback-good,
.tutor-feedback-stuck {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-feedback-good {
  color: #163321;
  background: #e8f8e8;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.14);
}

.tutor-feedback-stuck {
  color: #463a12;
  background: #fff4c6;
  box-shadow: inset 0 0 0 2rpx rgba(248, 198, 34, 0.2);
}

.tutor-feedback-good:active,
.tutor-feedback-stuck:active {
  transform: scale(0.985);
}

.tutor-feedback-note {
  display: block;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  color: #536158;
  background: #f8fbf4;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.32;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bridge-card {
  display: grid;
  gap: 10rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: #fff8df;
  box-shadow: inset 0 0 0 1rpx rgba(248, 198, 34, 0.22);
}

.tutor-bridge-card > view:first-child {
  display: grid;
  gap: 4rpx;
}

.tutor-bridge-card text {
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bridge-card > view:first-child text:first-child {
  color: #8a6414;
  font-size: 20rpx;
  font-weight: 950;
}

.tutor-bridge-card > view:first-child text:last-child {
  color: #1f211d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.26;
}

.tutor-bridge-card > text {
  color: #675b42;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.28;
}

.tutor-bridge-action {
  justify-self: start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #18a94f;
  font-size: 22rpx;
  font-weight: 950;
}

.tutor-input-bar text {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  font-size: 22rpx;
  font-weight: 950;
  line-height: 58rpx;
}
