page {
  background: #f9f8f4;
}

.tutor-page {
  min-height: 100vh;
  overflow: hidden;
  color: #1f2937;
  background: #f9f8f4;
}

.tutor-main {
  min-height: 100vh;
  height: auto;
}

.main-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 32rpx calc(150rpx + env(safe-area-inset-bottom));
}

.yd-tutor-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow: visible;
  border-radius: 0;
  background: #f9f8f4;
}

.yd-tutor-top,
.yd-tutor-brand,
.tutor-chat-head,
.tutor-section-head {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-tutor-top {
  position: relative;
  z-index: 8;
  margin: 0 -32rpx;
  padding: 0 32rpx 8rpx;
  background: rgba(249, 248, 244, 0.94);
}

.yd-tutor-brand {
  justify-content: flex-start;
}

.yd-tutor-mark {
  display: block;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  object-fit: contain;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #14b8a6;
  box-shadow: 0 8rpx 18rpx rgba(20, 184, 166, 0.16);
}

.yd-tutor-brand-lines {
  display: grid;
  gap: 2rpx;
  min-width: 0;
}

.yd-tutor-brand-lines text {
  display: block;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-tutor-brand-lines text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.12;
}

.yd-tutor-brand-lines text:last-child {
  color: #0d9488;
  font-size: 20rpx;
  font-weight: 820;
}

.yd-tutor-pill {
  flex: 0 0 auto;
  width: 168rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 999rpx;
  color: transparent;
  background: rgba(255, 255, 255, 0.72);
  font-size: 0;
  font-weight: 900;
}

.yd-tutor-pill::before,
.yd-tutor-pill::after {
  content: "";
  display: inline-block;
  vertical-align: middle;
}

.yd-tutor-pill::before {
  width: 52rpx;
  height: 8rpx;
  border-top: 6rpx solid #111827;
  border-bottom: 6rpx solid #111827;
  opacity: 0.78;
}

.yd-tutor-pill::after {
  width: 1rpx;
  height: 32rpx;
  margin-left: 28rpx;
  padding-left: 28rpx;
  border-left: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 50%;
  background: #111827;
  opacity: 0.78;
}

.yd-tutor-hero,
.tutor-chat-card,
.tutor-socratic-panel,
.tutor-reference-panel,
.tutor-result-stack {
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(41, 55, 46, 0.07);
}

.yd-tutor-hero {
  position: relative;
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr);
  align-items: center;
  gap: 28rpx;
  min-height: 196rpx;
  padding: 40rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 92% -12%, rgba(20, 184, 166, 0.26), transparent 34%),
    linear-gradient(135deg, #ffffff 0%, #f7fbf8 100%);
}

.yd-tutor-hero::after {
  content: "";
  position: absolute;
  top: -84rpx;
  right: -84rpx;
  width: 236rpx;
  height: 236rpx;
  border-radius: 50%;
  background: #ccfbf1;
  opacity: 0.7;
}

.yd-tutor-mascot {
  position: relative;
  z-index: 1;
  width: 144rpx;
  height: 144rpx;
  object-fit: contain;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #e6f4f1 0%, #ccfbf1 100%);
  box-shadow: inset 0 0 0 1rpx rgba(20, 184, 166, 0.08);
}

.yd-tutor-bubble {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 10rpx;
  min-width: 0;
}

.yd-tutor-bubble-title {
  display: block;
  color: #1f2937;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.08;
  letter-spacing: 0;
}

.yd-tutor-bubble > text {
  display: -webkit-box;
  overflow: hidden;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tutor-chat-card {
  display: grid;
  align-content: start;
  gap: 22rpx;
  flex: 0 0 auto;
  min-height: 344rpx;
  padding: 32rpx;
}

.tutor-chat-card.compact {
  min-height: 0;
  padding: 22rpx;
}

.tutor-chat-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
}

.tutor-chat-online {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 920;
}

.tutor-care-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 860;
}

.tutor-care-line text:first-child {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e6f4f1;
  color: #0d9488;
}

.tutor-care-line text:last-child {
  color: #6b7280;
}

.tutor-service-status {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: #e6f4f1;
}

.tutor-service-status text:first-child {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  white-space: nowrap;
}

.tutor-service-status text:last-child {
  min-width: 0;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.28;
}

.tutor-message-row {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
}

.tutor-avatar-dot {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #14b8a6;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 950;
  box-shadow: 0 8rpx 18rpx rgba(20, 184, 166, 0.18);
}

.tutor-bubble {
  display: block;
  max-width: 100%;
  padding: 26rpx 28rpx;
  border-radius: 36rpx 36rpx 36rpx 8rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.48;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-bubble.me {
  justify-self: end;
  grid-column: 1 / -1;
  max-width: 86%;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  color: #ffffff;
  background: #14b8a6;
}

.tutor-chat-card .tutor-bubble.me {
  justify-self: end;
}

.tutor-thinking-line {
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 22rpx;
  font-weight: 880;
}

.tutor-input-bar {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 0 20rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: inset 0 4rpx 10rpx rgba(17, 24, 39, 0.03);
}

.tutor-input-bar input {
  flex: 1 1 auto;
  min-width: 0;
  height: 82rpx;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 82rpx;
}

.tutor-input-bar text {
  flex: 0 0 auto;
  min-width: 72rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #fbbf24;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 72rpx;
  text-align: center;
}

.tutor-socratic-panel {
  display: grid;
  gap: 14rpx;
  padding: 0 0 4rpx;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}

.tutor-section-head text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
}

.tutor-section-head text:last-child {
  color: #6b7280;
  font-size: 21rpx;
  font-weight: 780;
}

.tutor-mode-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx;
}

.tutor-mode-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 136rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 18rpx 8rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 28rpx;
  color: #374151;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(17, 24, 39, 0.05);
  font-size: 22rpx;
  font-weight: 860;
  line-height: 1.15;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-mode-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1;
}

.tutor-mode-card > text:last-child {
  display: block;
  color: #374151;
  font-size: 22rpx;
  font-weight: 880;
  line-height: 1.15;
}

.tutor-mode-card:nth-child(1) .tutor-mode-icon { background: #fff7ed; color: #ea580c; }
.tutor-mode-card:nth-child(2) .tutor-mode-icon { background: #f0fdf4; color: #16a34a; }
.tutor-mode-card:nth-child(3) .tutor-mode-icon { background: #eff6ff; color: #2563eb; }
.tutor-mode-card:nth-child(4) .tutor-mode-icon { background: #f5f3ff; color: #7c3aed; }

.tutor-prompt-board {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.35;
  text-align: center;
}

.tutor-start-cta {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 16rpx 32rpx rgba(251, 191, 36, 0.34);
  font-size: 34rpx;
  font-weight: 950;
}

.tutor-reference-panel,
.tutor-result-stack {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
}

.tutor-reference-panel {
  min-height: 604rpx;
}

.tutor-reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.tutor-reference-head text:first-child {
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 950;
}

.tutor-reference-head text:last-child {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 20rpx;
  font-weight: 900;
}

.tutor-dialogue-card,
.tutor-stuck-panel,
.tutor-socratic-brief,
.tutor-bridge-card {
  display: grid;
  gap: 14rpx;
}

.tutor-dialogue-card > text,
.tutor-stuck-lead,
.tutor-stuck-question,
.tutor-feedback-note {
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 26rpx;
  font-weight: 780;
  line-height: 1.45;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-card > text.tutor-dialogue-user {
  justify-self: end;
  color: #ffffff;
  background: #f59e0b;
}

.tutor-pointing-grid,
.tutor-stuck-action-grid,
.tutor-brief-steps,
.tutor-micro-choice-row,
.tutor-feedback-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-pointing-grid text,
.tutor-dialogue-actions > text,
.tutor-stuck-action-card,
.tutor-stuck-footer text,
.tutor-micro-choice-row text,
.tutor-feedback-good,
.tutor-feedback-stuck,
.tutor-bridge-action {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  border-radius: 22rpx;
  color: #1f2937;
  background: #fff7ed;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.tutor-dialogue-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.tutor-reference-dialogue {
  display: grid;
  gap: 16rpx;
}

.tutor-knowledge-board {
  display: grid;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 90% 6%, rgba(251, 191, 36, 0.22), transparent 25%),
    #fffaf0;
}

.tutor-knowledge-subject {
  color: #0d9488;
  font-size: 24rpx;
  font-weight: 900;
}

.tutor-knowledge-title {
  color: #1f2937;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.1;
}

.tutor-blackboard {
  display: grid;
  gap: 0;
  overflow: hidden;
  border: 1rpx solid #f0ebe1;
  border-radius: 30rpx;
  background: #ffffff;
}

.tutor-blackboard text {
  display: block;
  padding: 22rpx;
  border-bottom: 1rpx solid #f0ebe1;
  color: #374151;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.tutor-blackboard text:first-child {
  color: #1f2937;
  font-size: 33rpx;
  font-weight: 950;
}

.tutor-blackboard text:last-child {
  border-bottom: 0;
}

.tutor-pointing-panel {
  position: relative;
  display: grid;
  gap: 28rpx;
  padding: 32rpx;
  overflow: hidden;
  border-radius: 0;
  background:
    radial-gradient(circle at 90% -8%, rgba(255, 122, 69, 0.08), transparent 28%),
    radial-gradient(circle at 0% 28%, rgba(20, 184, 166, 0.08), transparent 25%),
    #f9f8f4;
}

.tutor-pointing-pattern,
.tutor-stuck-pattern {
  position: absolute;
  inset: 0;
  opacity: 0.04;
  background-image: radial-gradient(#ff7a45 2rpx, transparent 2rpx);
  background-size: 32rpx 32rpx;
  pointer-events: none;
}

.tutor-pointing-lead {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 16rpx;
}

.tutor-pointing-lead text:first-child {
  justify-self: start;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e6f4f1;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.tutor-pointing-lead text:nth-child(2) {
  color: #1f2937;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.3;
}

.tutor-pointing-lead text:nth-child(2)::first-letter {
  color: #ff7a45;
}

.tutor-pointing-lead text:last-child {
  justify-self: start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #2563eb;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

.tutor-pointing-lead text:nth-child(3) {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 920;
}

.tutor-question-box {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 22rpx;
  min-height: 264rpx;
  padding: 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(240, 235, 225, 0.8);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.055);
}

.tutor-question-box input {
  width: 100%;
  height: 176rpx;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1.35;
}

.tutor-question-media-row {
  display: grid;
  grid-template-columns: 112rpx 112rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: end;
}

.tutor-question-thumb,
.tutor-question-camera {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
}

.tutor-question-thumb {
  border: 1rpx solid #f0ebe1;
  background:
    linear-gradient(135deg, rgba(20, 184, 166, 0.18), rgba(255, 122, 69, 0.12)),
    #f9f8f4;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.04);
}

.tutor-question-camera {
  border: 2rpx dashed #d1ccc2;
  background: #f9f8f4;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 900;
}

.tutor-question-safe {
  justify-self: end;
  color: #b8b8b8;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.tutor-question-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.tutor-question-tools text {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #0d9488;
  background: #e6f4f1;
  font-size: 25rpx;
  font-weight: 940;
}

.tutor-question-tools text:first-child {
  color: #78350f;
  background: #fef3c7;
}

.tutor-pointing-mode-row {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.tutor-pointing-mode-row > text {
  position: relative;
  display: grid;
  justify-items: center;
  align-content: center;
  min-height: 164rpx;
  gap: 12rpx;
  padding: 28rpx 18rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  color: #374151;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(31, 41, 55, 0.05);
}

.tutor-pointing-mode-row > text.active {
  border-color: #ff7a45;
  background: #fff5f0;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.12);
}

.tutor-mode-check {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.tutor-pointing-mode-row > text.active .tutor-mode-check {
  background: #ff7a45;
}

.tutor-pointing-section-title {
  position: relative;
  z-index: 1;
  padding-left: 18rpx;
  border-left: 8rpx solid #ff7a45;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.tutor-pointing-mode-row > text > text:nth-child(2) {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.16;
}

.tutor-pointing-mode-row > text > text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 790;
  line-height: 1.28;
  white-space: pre-line;
}

.tutor-stuck-panel {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 0;
  background:
    radial-gradient(circle at -8% -4%, rgba(255, 122, 69, 0.08), transparent 26%),
    radial-gradient(circle at 105% 34%, rgba(20, 184, 166, 0.08), transparent 26%),
    #f9f8f4;
}

.tutor-stuck-chip {
  position: relative;
  z-index: 1;
  justify-self: start;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(240, 235, 225, 0.7);
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.04);
}

.tutor-stuck-lead,
.tutor-stuck-question {
  position: relative;
  z-index: 1;
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.tutor-stuck-lead {
  color: #1f2937;
  font-size: 56rpx;
  line-height: 72rpx;
  font-weight: 950;
}

.tutor-stuck-question {
  color: #6b7280;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.tutor-stuck-action-card {
  min-height: 150rpx;
  justify-content: flex-start;
  padding: 28rpx;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  background: #ffffff;
  text-align: left;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.055);
}

.tutor-stuck-action-card:first-child {
  border-color: #ff7a45;
  background: #fff5f0;
}

.tutor-stuck-action-card > text:first-child {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 950;
}

.tutor-stuck-action-card > text:last-child {
  margin-top: 6rpx;
  color: #9a3412;
  font-size: 21rpx;
  font-weight: 760;
}

.tutor-stuck-journal {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 22rpx;
  padding: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.035);
}

.tutor-stuck-journal > text {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.tutor-stuck-journal view {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: start;
}

.tutor-stuck-journal view text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #ffffff;
  border-radius: 999rpx;
  background: #e6f4f1;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 52rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.04);
}

.tutor-stuck-journal view:nth-child(3) text:first-child {
  background: #fff0ea;
  color: #ff7a45;
}

.tutor-stuck-journal view text:last-child {
  padding: 18rpx;
  border: 1rpx solid rgba(240, 235, 225, 0.45);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.52);
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.38;
}

.tutor-stuck-footer {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 12rpx;
}

.tutor-brief-head,
.tutor-brief-actions,
.tutor-bridge-head {
  display: grid;
  gap: 8rpx;
}

.tutor-brief-head text:first-child,
.tutor-bridge-head text:first-child {
  justify-self: start;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #14b8a6;
  font-size: 20rpx;
  font-weight: 950;
}

.tutor-brief-head text:last-child,
.tutor-bridge-head text:last-child,
.tutor-brief-question {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.36;
}

.tutor-brief-step {
  display: -webkit-box;
  min-height: 104rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  color: #374151;
  background: #f6f8f3;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.25;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.tutor-brief-actions {
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
}

.tutor-brief-actions text {
  min-width: 0;
  color: #6b7280;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.28;
}

.tutor-brief-actions text:nth-child(2),
.tutor-brief-actions text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #e6f4f1;
  white-space: nowrap;
}

.tutor-diagnostic-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  color: #1f2937;
  background: #fff7ed;
}

.tutor-diagnostic-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tutor-diagnostic-card text:first-child {
  grid-column: 1 / -1;
  font-size: 26rpx;
  font-weight: 950;
}

.tutor-diagnostic-action {
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #0d9488;
  background: #ffffff;
  line-height: 64rpx;
  text-align: center;
}

.tutor-diagnostic-action.primary {
  color: #ffffff;
  background: #14b8a6;
}

.tutor-reference-panel.dialogue,
.tutor-reference-panel.knowledge,
.tutor-reference-panel.pointing,
.tutor-reference-panel.stuck {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.tutor-reference-panel.dialogue .tutor-dialogue-card {
  min-height: 680rpx;
  padding: 0 0 28rpx;
  gap: 24rpx;
  background: #f9fafb;
}

.tutor-dialogue-top {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) 72rpx;
  align-items: center;
  min-height: 92rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  background: rgba(249, 250, 251, 0.92);
}

.tutor-dialogue-top > text {
  color: #6b7280;
  font-size: 42rpx;
  line-height: 72rpx;
  text-align: center;
}

.tutor-dialogue-top view {
  display: grid;
  justify-items: center;
  gap: 4rpx;
}

.tutor-dialogue-top view text:first-child {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #4ade80;
}

.tutor-dialogue-top view text:nth-child(2) {
  color: #14b8a6;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.tutor-dialogue-top view text:last-child {
  color: #1f2937;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.tutor-dialogue-time {
  justify-self: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(243, 244, 246, 0.7);
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 700;
}

.tutor-chatline {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: start;
  padding: 0 8rpx;
}

.tutor-chatline.me {
  grid-template-columns: minmax(0, 1fr) 80rpx;
}

.tutor-chatline-avatar {
  grid-column: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #5eead4, #14b8a6);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 80rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.tutor-chatline.me .tutor-chatline-avatar {
  grid-column: 2;
  background: #cff1f3;
  color: #1a818e;
}

.tutor-chatline-bubble {
  grid-column: 2;
  justify-self: start;
  max-width: 82%;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(243, 244, 246, 0.65);
  border-radius: 36rpx 36rpx 36rpx 8rpx;
  background: #ffffff;
  color: #374151;
  font-size: 30rpx;
  line-height: 48rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tutor-chatline.me .tutor-chatline-bubble {
  grid-column: 1;
  justify-self: end;
  border: 0;
  border-radius: 36rpx 36rpx 8rpx 36rpx;
  background: #f59e0b;
  color: #ffffff;
}

.tutor-dialogue-composer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 96rpx;
  gap: 18rpx;
  align-items: center;
  margin: 16rpx 0 0;
  padding: 18rpx;
  border-top: 1rpx solid rgba(243, 244, 246, 0.7);
  background: rgba(255, 255, 255, 0.95);
}

.tutor-dialogue-composer input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700;
}

.tutor-dialogue-composer text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #14b8a6;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(20, 184, 166, 0.24);
}

.tutor-reference-panel.knowledge .tutor-knowledge-board {
  gap: 28rpx;
  padding: 0;
  border-radius: 0;
  background: #f9f8f4;
  box-shadow: none;
}

.tutor-reference-panel.knowledge .tutor-knowledge-subject {
  justify-self: start;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #e6f4f1;
  color: #0d9488;
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.tutor-reference-panel.knowledge .tutor-knowledge-title {
  color: #1f2937;
  font-size: 64rpx;
  line-height: 76rpx;
  font-weight: 950;
}

.tutor-blackboard-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 176rpx;
  align-items: center;
  min-height: 240rpx;
  overflow: hidden;
  padding: 0 40rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(135deg, #e2f3f3, #f0f8f8);
}

.tutor-blackboard-hero view {
  display: grid;
  gap: 18rpx;
}

.tutor-blackboard-hero view text:first-child {
  justify-self: start;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.tutor-blackboard-hero view text:last-child {
  color: #1a2626;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.tutor-blackboard-hero > text {
  position: absolute;
  right: -18rpx;
  bottom: 0;
  width: 210rpx;
  height: 160rpx;
  border-radius: 60rpx 0 0 0;
  background: #ff7a45;
}

.tutor-reference-panel.knowledge .tutor-blackboard {
  gap: 0;
  overflow: hidden;
  border: 1rpx solid #f0ebe1;
  border-top: 0;
  border-radius: 0 0 28rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.045);
}

.tutor-reference-panel.knowledge .tutor-blackboard > view {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 22rpx;
  padding: 36rpx 40rpx;
  border-bottom: 1rpx solid #f0ebe1;
}

.tutor-reference-panel.knowledge .tutor-blackboard > view:last-child {
  border-bottom: 0;
}

.tutor-reference-panel.knowledge .tutor-blackboard > view > text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: #e6f4f1;
  color: #0d9488;
  font-size: 26rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.tutor-reference-panel.knowledge .tutor-blackboard > view:nth-child(2) > text {
  background: #fff0ea;
  color: #ff7a45;
}

.tutor-reference-panel.knowledge .tutor-blackboard > view:nth-child(3) > text {
  background: #fff8e6;
  color: #d97706;
}

.tutor-reference-panel.knowledge .tutor-blackboard view view {
  display: grid;
  gap: 12rpx;
}

.tutor-reference-panel.knowledge .tutor-blackboard view view text:first-child {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.tutor-reference-panel.knowledge .tutor-blackboard view view text:last-child {
  color: #333333;
  font-size: 32rpx;
  line-height: 50rpx;
  font-weight: 750;
}

.tutor-reference-panel.pointing .tutor-pointing-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.tutor-reference-panel.pointing .tutor-pointing-grid text {
  min-height: 106rpx;
}
