<view class="tutor-page safe-bottom">
  <view class="tutor-shell">
    <scroll-view class="tutor-main" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="main-inner">
        <view class="yd-tutor-screen yd-app-screen yd-tutor-app">
          <view class="yd-tutor-top">
            <view class="yd-tutor-brand">
              <image class="yd-tutor-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
              <view>
                <text>原点 · 咕点 AI点拨</text>
                <text>首页从这里开始</text>
              </view>
            </view>
            <view class="yd-tutor-pill">不代写</view>
          </view>

          <view class="yd-tutor-hero">
            <image class="yd-tutor-mascot" mode="aspectFit" src="/assets/reference/tutor-socratic-board-transparent.png" />
            <view class="yd-tutor-bubble">
              <view>{{tutorHomeContext.title}}</view>
              <text>{{tutorHomeContext.line}}</text>
              <view class="tutor-context-chips">
                <text wx:for="{{tutorHomeContext.chips}}" wx:key="index">{{item}}</text>
              </view>
            </view>
          </view>

          <view class="tutor-care-line">
            <text>先稳住，再说第一步</text>
            <text>不直接给答案</text>
          </view>

          <view class="tutor-socratic-panel">
            <view class="tutor-section-head">
              <text>先选一句真实情况</text>
              <text>咕点只追下一小步</text>
            </view>
            <view class="tutor-mode-grid">
              <text class="tutor-mode-card" data-step="read_problem" bindtap="launchFirstStep">我有点慌</text>
              <text class="tutor-mode-card primary" data-step="write_first_step" bindtap="launchFirstStep">先写第一步</text>
              <text class="tutor-mode-card" data-step="find_direction" bindtap="launchFirstStep">我看不懂题</text>
            </view>
            <text class="tutor-prompt-board">例：题目问什么我没看明白。</text>
          </view>

          <view class="tutor-chat-card">
            <view class="tutor-chat-title">把卡点发给原点</view>
            <view class="tutor-service-status" wx:if="{{tutorServiceStatus && tutorServiceStatus.visible}}">
              <text>{{tutorServiceStatus.label}}</text>
              <text>{{tutorServiceStatus.line}}</text>
            </view>
            <block wx:if="{{messages && messages.length}}">
              <block wx:for="{{messages}}" wx:key="index">
                <view class="tutor-bubble {{item.role === 'user' ? 'me' : ''}}">{{item.text}}</view>
              </block>
            </block>
            <block wx:else>
              <view class="tutor-bubble">先告诉我：你现在是看不懂题、不会第一步，还是心里有点急？</view>
              <view class="tutor-bubble me">我会先说自己的第一步，不要直接给答案。</view>
            </block>
            <view class="tutor-socratic-brief" wx:if="{{socraticBrief}}">
              <view>
                <text>{{socraticBrief.label}}</text>
                <text>{{socraticBrief.title}}</text>
              </view>
              <text>{{socraticBrief.nextQuestion}}</text>
              <view class="tutor-brief-steps"><text class="tutor-brief-step">{{socraticBrief.steps[0].label}}：{{socraticBrief.steps[0].text}}</text><text class="tutor-brief-step">{{socraticBrief.steps[1].label}}：{{socraticBrief.steps[1].text}}</text><text class="tutor-brief-step">{{socraticBrief.steps[2].label}}：{{socraticBrief.steps[2].text}}</text></view>
              <view>
                <text>{{socraticBrief.boundary}}</text>
                <text bindtap="requestSmallerTutorPrompt">再问小一点</text>
                <text bindtap="goSocraticBriefRoute">{{socraticBrief.routeLabel}}</text>
              </view>
            </view>
            <text class="tutor-diagnostic-card" wx:if="{{tutorDiagnosticCard}}"><text>{{tutorDiagnosticCard.title}}</text><text>卡点：{{tutorDiagnosticCard.issue}}</text><text>下一步：{{tutorDiagnosticCard.firstStep}}</text><text>家长问：{{tutorDiagnosticCard.parentCheck}}</text><text class="tutor-diagnostic-action primary" data-id="diagnosis_review" data-label="{{tutorDiagnosticCard.reviewMove}}" data-route="{{tutorDiagnosticCard.reviewRoute}}" data-evidence="tutor_diagnostic_card" bindtap="runTutorHandoffAction">去短回访验证</text><text class="tutor-diagnostic-action" data-id="diagnosis_parent" data-label="{{tutorDiagnosticCard.parentCheck}}" data-route="{{tutorDiagnosticCard.parentRoute}}" data-evidence="tutor_diagnostic_parent_check" bindtap="runTutorHandoffAction">给家长看证据</text></text>
            <view class="tutor-micro-choice-row" wx:if="{{socraticMicroChoices && socraticMicroChoices.length}}"><text data-id="{{socraticMicroChoices[0].id}}" data-index="0" bindtap="selectSocraticMicroChoice">{{socraticMicroChoices[0].label}} {{socraticMicroChoices[0].text}}</text><text data-id="{{socraticMicroChoices[1].id}}" data-index="1" bindtap="selectSocraticMicroChoice">{{socraticMicroChoices[1].label}} {{socraticMicroChoices[1].text}}</text></view>
            <view class="tutor-input-bar">
              <input value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" placeholder="写题目、卡点或第一步" />
              <view bindtap="send">发送</view>
            </view>
            <view class="tutor-feedback-row" wx:if="{{hasUserTutorTurn}}"><view class="tutor-feedback-good" data-status="first_step_spoken" bindtap="recordSocraticEffectivenessFeedback">我说出第一步了</view><view class="tutor-feedback-stuck" data-status="still_blocked" bindtap="recordSocraticEffectivenessFeedback">还是卡住</view></view>
            <text class="tutor-feedback-note" wx:if="{{socraticFeedbackNextAction}}">{{socraticFeedbackNextAction}}</text>
            <view class="tutor-bridge-card" wx:if="{{miniLessonFeedbackBridge && miniLessonFeedbackBridge.nextAction}}"><view><text>补一张证据</text><text>{{miniLessonFeedbackBridge.nextAction}}</text></view><text>{{miniLessonFeedbackBridge.type === 'evidence_review_required' ? '只留 A/B 小黑板证据，回短回访复测。' : '转成 3 分钟小讲堂，做完回短回访。'}}</text><view class="tutor-bridge-action" data-id="mini_lesson_bridge" data-label="{{miniLessonFeedbackBridge.nextAction}}" data-route="{{miniLessonFeedbackBridge.route}}" data-evidence="still_blocked_feedback" bindtap="runTutorHandoffAction">继续</view></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
