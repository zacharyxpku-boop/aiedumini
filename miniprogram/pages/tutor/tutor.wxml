<view class="tutor-page safe-bottom">
  <view class="tutor-shell">
    <scroll-view class="tutor-main" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="main-inner">
        <view class="yd-tutor-screen yd-app-screen yd-tutor-app">
          <view class="yd-tutor-top">
            <view class="yd-tutor-brand">
              <image class="yd-tutor-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
              <view>
                <text>原点点拨</text>
                <text>只追问第一步</text>
              </view>
            </view>
            <view class="yd-tutor-pill">第一步</view>
          </view>

          <view class="yd-tutor-hero">
            <image class="yd-tutor-mascot" mode="aspectFit" src="/assets/reference/tutor-socratic-board-transparent.png" />
            <view class="yd-tutor-bubble">
              <view>先说第一步</view>
              <text>原点不替你写答案。你说题目或卡点，它只问下一句最小提示。</text>
            </view>
          </view>

          <view class="tutor-socratic-panel">
            <view class="tutor-section-head"><text>选一句开头</text><text>说出来就能开始</text></view>
            <view class="tutor-mode-grid"><text class="tutor-mode-card" data-step="read_problem" bindtap="launchFirstStep">题目问什么</text><text class="tutor-mode-card primary" data-step="write_first_step" bindtap="launchFirstStep">先写第一步</text><text class="tutor-mode-card" data-step="find_direction" bindtap="launchFirstStep">找一个入口</text></view>
            <text class="tutor-prompt-board">孩子只要先回一句：“我先找已知条件。”原点再追问下一句。</text>
          </view>

          <view class="tutor-chat-card">
            <view class="tutor-chat-title">把卡点发给原点</view>
            <block wx:if="{{messages && messages.length}}">
              <block wx:for="{{messages}}" wx:key="index">
                <view class="tutor-bubble {{item.role === 'user' ? 'me' : ''}}">{{item.text}}</view>
              </block>
            </block>
            <block wx:else>
              <view class="tutor-bubble">先不急着算答案。读完题后，第一步想找什么条件？</view>
              <view class="tutor-bubble me">我想先找题目里给了哪些数量。</view>
            </block>
            <view class="tutor-input-bar">
              <input value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" placeholder="写下题目、卡点或你的第一步" />
              <view bindtap="send">发送</view>
            </view>
            <view class="tutor-feedback-row">
              <view class="tutor-feedback-good" data-status="first_step_spoken" bindtap="recordSocraticEffectivenessFeedback">我说出第一步了</view>
              <view class="tutor-feedback-stuck" data-status="still_blocked" bindtap="recordSocraticEffectivenessFeedback">还是卡住</view>
            </view>
            <text class="tutor-feedback-note" wx:if="{{socraticFeedbackNextAction}}">{{socraticFeedbackNextAction}}</text>
          </view>

          <view class="tutor-action-row">
            <view class="tutor-primary" data-step="{{activeStep}}" bindtap="launchFirstStep">开始追问第一步</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
