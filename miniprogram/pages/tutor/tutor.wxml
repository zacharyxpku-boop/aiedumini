<view class="tutor-page safe-bottom">
  <scroll-view class="tutor-main" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="main-inner">
      <view class="yd-tutor-screen yd-app-screen yd-tutor-app detail-{{showTutorDetails ? 'on' : 'off'}}">
        <view class="yd-tutor-top">
          <text class="yd-tutor-brand">
            <image class="yd-tutor-mark" mode="aspectFit" src="/assets/reference/gudian-sticker.png" />
            <text class="yd-tutor-brand-lines">
              <text>原点 · 咕点</text>
              <text>先问第一步 不代写答案</text>
            </text>
          </text>
          <text class="yd-tutor-pill">••• ｜ ○</text>
        </view>

        <view class="yd-tutor-hero" wx:if="{{!showTutorDetails}}">
          <image class="yd-tutor-mascot" mode="aspectFit" src="/assets/reference/gudian-sticker.png" />
          <text class="yd-tutor-bubble">
            <text class="yd-tutor-bubble-title">和咕点聊聊</text>
            <text>可以直接聊天、问知识点、说卡住了、发题目；咕点会追问第一步，不代写答案。</text>
          </text>
        </view>
        <view class="tutor-chat-card" wx:if="{{!showTutorDetails}}">
          <view class="tutor-chat-head"><text class="tutor-chat-title">把题目、卡点发给 AI私教</text><text class="tutor-chat-online">在线</text></view>
          <view class="tutor-message-row">
            <text class="tutor-avatar-dot">AI</text>
            <block wx:if="{{messages && messages.length}}">
              <block wx:for="{{messages}}" wx:key="index"><view class="tutor-bubble {{item.role === 'user' ? 'me' : ''}}">{{item.text}}</view></block>
            </block>
            <block wx:else><view class="tutor-bubble">先告诉我：你现在是看不懂题、不会第一步，还是心里有点急？</view></block>
          </view>
          <view class="tutor-thinking-line" wx:if="{{loading}}">咕点正在思考你的第一步...</view>
          <view class="tutor-input-bar"><textarea value="{{input}}" bindinput="onInput" auto-height maxlength="-1" placeholder="先发一句话，我帮你切小问题" /><text bindtap="send">↗</text></view>
        </view>

        <view class="tutor-socratic-panel" wx:if="{{!showTutorDetails}}">
          <view class="tutor-mode-grid">
            <text class="tutor-mode-card" data-step="read_problem" bindtap="openTutorScene"><text class="tutor-mode-icon">?</text><text>问知识点</text></text>
            <text class="tutor-mode-card" data-step="explain_misconception" bindtap="openTutorScene"><text class="tutor-mode-icon">!</text><text>我听不懂</text></text>
            <text class="tutor-mode-card" data-step="find_direction" bindtap="openTutorScene"><text class="tutor-mode-icon">→</text><text>题目点拨</text></text>
            <text class="tutor-mode-card" data-step="review" bindtap="openTutorScene"><text class="tutor-mode-icon">✓</text><text>学了什么</text></text>
          </view>
          <view class="tutor-start-cta" data-step="write_first_step" bindtap="openTutorScene">开始问咕点</view>
          <text class="tutor-usage-note">已有 2,451 位同学今天和咕点聊过</text>
        </view>

        <view class="tutor-reference-panel {{activeTutorScene}}" wx:if="{{showTutorDetails}}">
          <text class="tutor-reference-head"><text>{{tutorReferenceScene.title}}</text><text>{{tutorReferenceScene.status}}</text></text>

          <block wx:if="{{activeTutorScene === 'dialogue'}}">
            <view class="tutor-dialogue-card">
              <view class="tutor-dialogue-top"><text bindtap="closeTutorScene">‹</text><view><text></text><text>咕点在线</text><text>正在陪你想第一步</text></view><text>•••</text></view>
              <text class="tutor-dialogue-time">今天 15:30</text>
              <block wx:if="{{messages && messages.length}}">
                <view wx:for="{{messages}}" wx:key="index" class="tutor-chatline {{item.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{item.text}}</text><text class="tutor-chatline-avatar">{{item.role === 'user' ? '童' : 'AI'}}</text></view>
              </block>
              <block wx:else>
                <text class="tutor-reference-emptyline">先发一句话，我帮你切小问题</text>
                <view wx:if="{{tutorReferenceScene.row0}}" class="tutor-chatline {{tutorReferenceScene.row0.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{tutorReferenceScene.row0.text}}</text><text class="tutor-chatline-avatar">{{tutorReferenceScene.row0.role === 'user' ? '童' : 'AI'}}</text></view>
                <view wx:if="{{tutorReferenceScene.row1}}" class="tutor-chatline {{tutorReferenceScene.row1.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{tutorReferenceScene.row1.text}}</text><text class="tutor-chatline-avatar">{{tutorReferenceScene.row1.role === 'user' ? '童' : 'AI'}}</text></view>
                <view wx:if="{{tutorReferenceScene.row2}}" class="tutor-chatline {{tutorReferenceScene.row2.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{tutorReferenceScene.row2.text}}</text><text class="tutor-chatline-avatar">{{tutorReferenceScene.row2.role === 'user' ? '童' : 'AI'}}</text></view>
                <view wx:if="{{tutorReferenceScene.row3}}" class="tutor-chatline {{tutorReferenceScene.row3.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{tutorReferenceScene.row3.text}}</text><text class="tutor-chatline-avatar">{{tutorReferenceScene.row3.role === 'user' ? '童' : 'AI'}}</text></view>
                <view wx:if="{{tutorReferenceScene.row4}}" class="tutor-chatline {{tutorReferenceScene.row4.role === 'user' ? 'me' : ''}}"><text class="tutor-chatline-bubble">{{tutorReferenceScene.row4.text}}</text><text class="tutor-chatline-avatar">{{tutorReferenceScene.row4.role === 'user' ? '童' : 'AI'}}</text></view>
              </block>
              <view class="tutor-dialogue-composer"><input value="{{input}}" bindinput="onInput" bindconfirm="send" confirm-type="send" placeholder="跟小原说点什么..." /><text bindtap="send">↗</text></view>
            </view>
            <view class="tutor-dialogue-actions"><text wx:if="{{tutorReferenceScene.action0}}" data-action="{{tutorReferenceScene.action0.action}}" data-step="{{tutorReferenceScene.action0.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action0.label}}</text><text wx:if="{{tutorReferenceScene.action1}}" data-action="{{tutorReferenceScene.action1.action}}" data-step="{{tutorReferenceScene.action1.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action1.label}}</text></view>
          </block>

          <view class="tutor-knowledge-board" wx:elif="{{activeTutorScene === 'knowledge'}}">
            <text class="tutor-subpage-top"><text bindtap="closeTutorScene">‹</text><text>咕点讲解</text><text>···</text></text>
            <text class="tutor-knowledge-subject">{{tutorReferenceScene.row0.text}}</text>
            <text class="tutor-knowledge-title">{{tutorReferenceScene.row1.text}}</text>
            <view class="tutor-blackboard-hero"><view><text>咕点小黑板</text><text>“别怕，这其实是个变身魔法！”</text></view><image class="tutor-blackboard-hero-art" mode="aspectFit" src="/assets/reference/tutor-socratic-board-transparent.png" /></view>
            <view class="tutor-blackboard"><view><text>1</text><view><text>这是什么</text><text>{{tutorReferenceScene.row3.text}}</text></view></view><view><text>2</text><view><text>容易卡在哪里</text><text>{{tutorReferenceScene.row4.text}}</text></view></view><view><text>3</text><view><text>第一步怎么想</text><text>{{tutorReferenceScene.row5.text}}</text></view></view></view>
            <view class="tutor-dialogue-actions"><text data-action="{{tutorReferenceScene.action0.action}}" data-step="{{tutorReferenceScene.action0.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action0.label}}</text><text data-action="{{tutorReferenceScene.action1.action}}" data-step="{{tutorReferenceScene.action1.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action1.label}}</text></view>
          </view>

          <view class="tutor-pointing-panel" wx:elif="{{activeTutorScene === 'pointing'}}">
            <text class="tutor-pointing-pattern"></text>
            <text class="tutor-subpage-top"><text bindtap="closeTutorScene">‹</text><text>题目点拨</text><text>···</text></text>
            <text class="tutor-pointing-lead"><text>AI 专属私教</text><text>把题目发来，<text>咕点</text>只问第一步。</text><text>看懂题意 · 找第一步 · 检查错因</text><text>打字/拍照留档 · 安全摘要 · 不代写答案</text></text>
            <view class="tutor-question-box">
              <textarea value="{{input}}" bindinput="onInput" auto-height maxlength="-1" placeholder="这道题有些搞不懂，在这里输入题目文字，或直接点击下方拍题..." />
              <view class="tutor-question-media-row"><text class="tutor-question-thumb"></text><text class="tutor-question-camera" bindtap="attachTutorPhoto">拍题</text><text class="tutor-question-safe">自动保存</text></view>
              <text class="tutor-question-tools"><text bindtap="attachTutorPhoto">拍题留档</text><text data-step="write_first_step" bindtap="launchFirstStep">我卡住了</text></text>
            </view>
            <text class="tutor-pointing-section-title">选择点拨模式</text>
            <view class="tutor-pointing-mode-row">
              <text class="active" data-action="step" data-step="read_problem" bindtap="runTutorReferenceAction"><text class="tutor-mode-check">✓</text><text>看懂题意</text><text>理清条件&#10;找准问题</text></text>
              <text data-action="step" data-step="write_first_step" bindtap="runTutorReferenceAction"><text class="tutor-mode-check"></text><text>找第一步</text><text>毫无头绪&#10;找突破口</text></text>
              <text data-action="step" data-step="explain_misconception" bindtap="runTutorReferenceAction"><text class="tutor-mode-check"></text><text>检查错因</text><text>算错不对&#10;定位错因</text></text>
            </view>
            <text class="tutor-start-row"><text class="tutor-start-secondary" data-step="write_first_step" bindtap="launchFirstStep">◷</text><text class="tutor-start-cta" data-step="find_direction" bindtap="launchFirstStep">开始点拨</text></text>
          </view>

          <view class="tutor-stuck-panel" wx:elif="{{activeTutorScene === 'stuck'}}">
            <text class="tutor-stuck-pattern"></text>
            <text class="tutor-subpage-top"><text bindtap="closeTutorScene">‹</text><text>卡住恢复</text><text>···</text></text>
            <text class="tutor-stuck-chip">深呼吸，慢慢来</text>
            <text class="tutor-stuck-lead"><text>没关系，</text><text>我们把问题<text>切小</text>一点</text></text>
            <text class="tutor-stuck-question">接下来想先试试哪个？</text>
            <text class="tutor-stuck-action-grid"><text class="tutor-stuck-action-card active" data-action="{{tutorReferenceScene.action0.action}}" data-step="{{tutorReferenceScene.action0.step}}" bindtap="runTutorReferenceAction"><text class="tutor-stuck-action-icon">⌕</text><text class="tutor-stuck-action-copy"><text>{{tutorReferenceScene.action0.label}}</text><text>{{tutorReferenceScene.action0.line}}</text></text><text class="tutor-stuck-action-check">✓</text></text><text class="tutor-stuck-action-card" data-action="{{tutorReferenceScene.action1.action}}" data-step="{{tutorReferenceScene.action1.step}}" bindtap="runTutorReferenceAction"><text class="tutor-stuck-action-icon target">◎</text><text class="tutor-stuck-action-copy"><text>{{tutorReferenceScene.action1.label}}</text><text>{{tutorReferenceScene.action1.line}}</text></text><text class="tutor-stuck-action-check"></text></text></text>
            <view class="tutor-stuck-journal"><text>刚才的思考小记</text><view><text>1</text><text>{{tutorReferenceScene.row4.text}}</text></view><view><text>?</text><text>{{tutorReferenceScene.row5.text}}</text></view></view>
            <view class="tutor-stuck-footer"><text data-action="{{tutorReferenceScene.action2.action}}" data-step="{{tutorReferenceScene.action2.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action2.label}}</text><text data-action="{{tutorReferenceScene.action3.action}}" data-step="{{tutorReferenceScene.action3.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action3.label}}</text></view>
          </view>

          <view class="tutor-recap-panel" wx:elif="{{activeTutorScene === 'recap'}}"><text class="tutor-subpage-top"><text bindtap="closeTutorScene">‹</text><text>刚才学了什么</text><text>···</text></text><text class="tutor-recap-hero"><text>把刚才的第一步</text><text>收进档案袋</text><text>{{tutorReferenceScene.row0.text}}</text></text><label class="tutor-recap-card"><text>我刚才卡在哪里？</text><textarea value="{{input}}" bindinput="onInput" auto-height maxlength="-1" placeholder="例如：我一开始没看出题目问的是加速度..." /></label>
            <view class="tutor-dialogue-actions"><text data-action="{{tutorReferenceScene.action0.action}}" data-step="{{tutorReferenceScene.action0.step}}" bindtap="runTutorReferenceAction">{{tutorReferenceScene.action0.label}}</text><text data-action="review" bindtap="runTutorReferenceAction">去知识乐园练一下</text></view>
          </view>
        </view>

        <view class="tutor-result-stack compact-dialogue-result" wx:if="{{showTutorDetails && activeTutorScene === 'dialogue' && (socraticBrief || tutorDiagnosticCard || socraticMicroChoices.length || socraticFeedbackNextAction || miniLessonFeedbackBridge)}}">
          <view class="tutor-socratic-brief" wx:if="{{socraticBrief}}"><text class="tutor-brief-head"><text>{{socraticBrief.label}}</text><text>{{socraticBrief.title}}</text></text><text class="tutor-brief-question">{{socraticBrief.nextQuestion}}</text><view class="tutor-brief-steps"><text class="tutor-brief-step">{{socraticBrief.steps[0].label}}：{{socraticBrief.steps[0].text}}</text><text class="tutor-brief-step">{{socraticBrief.steps[1].label}}：{{socraticBrief.steps[1].text}}</text><text class="tutor-brief-step">{{socraticBrief.steps[2].label}}：{{socraticBrief.steps[2].text}}</text></view><text class="tutor-brief-actions"><text>{{socraticBrief.boundary}}</text><text bindtap="requestSmallerTutorPrompt">再问小一点</text><text bindtap="goSocraticBriefRoute">{{socraticBrief.routeLabel}}</text></text></view>
          <text class="tutor-diagnostic-card" wx:if="{{tutorDiagnosticCard}}"><text>{{tutorDiagnosticCard.title}}</text><text>卡点：{{tutorDiagnosticCard.issue}}</text><text>下一步：{{tutorDiagnosticCard.firstStep}}</text><text>家长问：{{tutorDiagnosticCard.parentCheck}}</text><text class="tutor-diagnostic-action primary" data-id="diagnosis_review" data-label="{{tutorDiagnosticCard.reviewMove}}" data-route="{{tutorDiagnosticCard.reviewRoute}}" data-evidence="tutor_diagnostic_card" bindtap="runTutorHandoffAction">去知识乐园验证</text><text class="tutor-diagnostic-action" data-id="diagnosis_parent" data-label="{{tutorDiagnosticCard.parentCheck}}" data-route="{{tutorDiagnosticCard.parentRoute}}" data-evidence="tutor_diagnostic_parent_check" bindtap="runTutorHandoffAction">给家长看证据</text></text>
          <view class="tutor-micro-choice-row" wx:if="{{socraticMicroChoices && socraticMicroChoices.length}}"><text data-id="{{socraticMicroChoices[0].id}}" data-index="0" bindtap="selectSocraticMicroChoice">{{socraticMicroChoices[0].label}} {{socraticMicroChoices[0].text}}</text><text data-id="{{socraticMicroChoices[1].id}}" data-index="1" bindtap="selectSocraticMicroChoice">{{socraticMicroChoices[1].label}} {{socraticMicroChoices[1].text}}</text></view>
          <view class="tutor-feedback-row" wx:if="{{hasUserTutorTurn}}"><text class="tutor-feedback-good" data-status="first_step_spoken" bindtap="recordSocraticEffectivenessFeedback">我说出第一步了</text><text class="tutor-feedback-stuck" data-status="still_blocked" bindtap="recordSocraticEffectivenessFeedback">还是卡住</text></view>
          <text class="tutor-feedback-note" wx:if="{{socraticFeedbackNextAction}}">{{socraticFeedbackNextAction}}</text>
          <view class="tutor-bridge-card" wx:if="{{miniLessonFeedbackBridge && miniLessonFeedbackBridge.nextAction}}"><text class="tutor-bridge-head"><text>补一张证据</text><text>{{miniLessonFeedbackBridge.nextAction}}</text></text><text>{{miniLessonFeedbackBridge.type === 'evidence_review_required' ? '只留 A/B 小黑板证据，回知识乐园复测。' : '转成 3 分钟小讲堂，做完回知识乐园。'}}</text><text class="tutor-bridge-action" data-id="mini_lesson_bridge" data-label="{{miniLessonFeedbackBridge.nextAction}}" data-route="{{miniLessonFeedbackBridge.route}}" data-evidence="still_blocked_feedback" bindtap="runTutorHandoffAction">继续</text></view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
