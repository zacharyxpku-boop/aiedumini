page {
  background: #f9f8f4;
}

.review-page {
  min-height: 100vh;
  background: #f9f8f4;
  color: #111827;
}

.content-area {
  height: 100vh;
}

.content-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-review-screen {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 32rpx calc(172rpx + env(safe-area-inset-bottom));
  background: #f9f8f4;
  border-radius: 0;
}

.yd-review-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-review-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.yd-review-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-review-brand view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-review-brand text:first-child {
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111827;
}

.yd-review-brand text:last-child {
  font-size: 22rpx;
  line-height: 28rpx;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-review-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.05);
}

.yd-review-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 168rpx;
  min-height: 440rpx;
  margin: 0 -32rpx;
  padding: 44rpx 40rpx 34rpx;
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
  background:
    radial-gradient(circle at 86% 12%, rgba(255, 138, 76, 0.2), transparent 26%),
    radial-gradient(circle at 18% 96%, rgba(20, 184, 166, 0.15), transparent 28%),
    linear-gradient(180deg, #e0f2f1 0%, #f9f8f4 86%);
  box-shadow: none;
}

.yd-review-hero::before {
  content: "";
  position: absolute;
  left: 40rpx;
  top: 168rpx;
  width: 56rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f59e0b;
}

.yd-review-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: 0;
}

.yd-review-title {
  max-width: 410rpx;
  color: #111827;
  font-size: 52rpx;
  line-height: 62rpx;
  font-weight: 950;
}

.yd-review-sub {
  max-width: 520rpx;
  width: fit-content;
  box-sizing: border-box;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-color: transparent;
  border-radius: 0;
  background: transparent;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 720;
  box-shadow: none;
}

.route-note.short {
  display: block;
}

.yd-review-art {
  position: absolute;
  right: 8rpx;
  bottom: 0;
  width: 176rpx;
  height: 164rpx;
  object-fit: contain;
  opacity: 0.24;
}

.review-route-map {
  position: absolute;
  inset: 32rpx 0 0;
  z-index: 0;
  pointer-events: none;
}

.review-route-seg {
  position: absolute;
  display: block;
  height: 0;
  border-top: 5rpx dashed rgba(20, 184, 166, 0.38);
  border-radius: 999rpx;
  transform-origin: left center;
}

.review-route-seg.seg-a {
  left: -40rpx;
  top: 272rpx;
  width: 194rpx;
  transform: rotate(-18deg);
}

.review-route-seg.seg-b {
  left: 126rpx;
  top: 170rpx;
  width: 190rpx;
  transform: rotate(17deg);
}

.review-route-seg.seg-c {
  left: 302rpx;
  top: 194rpx;
  width: 176rpx;
  transform: rotate(-18deg);
}

.review-route-node {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(20, 184, 166, 0.58);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.6);
}

.review-route-node text {
  display: block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ffffff;
}

.review-route-node.node-a {
  left: 126rpx;
  top: 238rpx;
}

.review-route-node.node-b {
  left: 388rpx;
  top: 166rpx;
  width: 54rpx;
  height: 54rpx;
  background: rgba(245, 158, 11, 0.15);
  box-shadow: none;
}

.review-route-node.node-b text {
  width: 24rpx;
  height: 24rpx;
  background: #f59e0b;
}

.review-route-node.node-c {
  left: 614rpx;
  top: 104rpx;
  opacity: 0.5;
}

.review-route-blob {
  position: absolute;
  right: -32rpx;
  bottom: -24rpx;
  width: 154rpx;
  height: 126rpx;
  border-radius: 44% 56% 58% 42%;
  background: rgba(20, 184, 166, 0.05);
  transform: rotate(-18deg);
}

.review-chip-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  max-width: 100%;
  overflow: hidden;
  padding: 8rpx 0 2rpx;
}

.review-chip-row text {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 36rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 760;
  box-shadow: 0 3rpx 10rpx rgba(17, 24, 39, 0.04);
}

.review-chip-row text:first-child {
  border-color: #14b8a6;
  background: #14b8a6;
  color: #ffffff;
  font-weight: 900;
}

.review-main-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: -10rpx;
}

.review-main-tool-card {
  display: flex;
  min-height: 188rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(37, 45, 55, 0.075);
}

.review-main-tool-card text {
  display: block;
}

.review-main-tool-card text:first-child {
  width: fit-content;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
}

.review-main-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.review-main-tool-card text:last-child {
  display: -webkit-box;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 600;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-main-tool-card.warm {
  background: #fff6eb;
}

.review-main-tool-card.yellow {
  background: #fff7cf;
}

.review-main-tool-card.blue {
  background: #eaf5ff;
}

.review-main-tool-card.teal {
  background: #e7f8f4;
}

.review-record-panel,
.review-target-card,
.review-feedback-strip,
.review-empty-note,
.review-template-pack,
.review-template-workbench {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.06);
}

.review-record-panel {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
}

.review-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-section-head text:first-child {
  color: #111827;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.review-section-head text:last-child {
  max-width: 340rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.review-flow-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
}

.review-flow-tabs text {
  display: block;
  padding: 12rpx 4rpx;
  border-radius: 14rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.review-flow-tabs text.active {
  background: #ffffff;
  color: #0f766e;
  box-shadow: 0 6rpx 16rpx rgba(20, 184, 166, 0.13);
}

.review-topic-row,
.review-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.review-topic-card {
  display: block;
  min-height: 186rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 2rpx solid #f0ebe1;
  border-radius: 28rpx;
  background: #fff9f5;
  color: #2c2621;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  white-space: pre-line;
}

.review-topic-card.active {
  border-color: #ff8a4c;
  background: #fff1e7;
  color: #ea580c;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 76, 0.12);
}

.review-topic-cta,
.review-main-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  margin-top: 8rpx;
  border-radius: 28rpx;
  background: #ff8a4c;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 34rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 30rpx rgba(255, 138, 76, 0.3);
}

.review-target-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8rpx 14rpx;
  align-items: center;
  padding: 26rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(20, 184, 166, 0.18), transparent 28%),
    linear-gradient(135deg, #fff5f0, #e8fafa);
  box-shadow: 0 10rpx 26rpx rgba(255, 125, 64, 0.12);
}

.review-target-card text:first-child {
  grid-column: 1 / -1;
  color: #ff7d40;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-target-card text:nth-child(2) {
  grid-column: 1;
  color: #111827;
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.review-target-card text:last-child {
  grid-column: 2;
  justify-self: end;
  max-width: 210rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #b45309;
  font-weight: 900;
}

.review-tool-card {
  display: grid;
  gap: 8rpx;
  min-height: 328rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 2rpx solid #f0f0ef;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.035);
}

.review-tool-card.ready {
  border-color: rgba(255, 125, 64, 0.32);
}

.review-tool-card.locked {
  opacity: 0.78;
}

.review-tool-card text {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.review-tool-card text:nth-child(3),
.review-tool-card text:last-child {
  color: #374151;
  font-weight: 650;
}

.review-tool-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #fff5f0;
  color: #ff7d40;
  text-align: center;
  line-height: 58rpx;
  font-size: 30rpx;
}

.review-empty-note {
  padding: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
  background: #f9fafb;
}

.review-live-tool {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.review-live-tool.stage-live {
  min-height: 690rpx;
  justify-content: flex-start;
  padding: 0 0 16rpx;
}

.review-play-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 6rpx;
}

.review-play-top text:first-child,
.review-play-top text:last-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #9ca3af;
  font-size: 32rpx;
  line-height: 64rpx;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.045);
}

.review-play-top text:nth-child(2) {
  color: #1f2937;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.review-game-progress {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  color: #9ca3af;
}

.review-game-progress view {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.review-game-progress view text:first-child {
  color: #0d9488;
  font-size: 36rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.review-game-progress view text:last-child {
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.review-game-progress > text {
  padding: 5rpx 14rpx;
  border-radius: 6rpx;
  background: #ecfdf5;
  color: rgba(13, 148, 136, 0.82);
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.review-game-bar {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f0ebe1;
}

.review-game-bar view {
  width: 30%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2dd4bf, #5eead4);
  box-shadow: 0 0 16rpx rgba(45, 212, 191, 0.4);
}

.review-live-reference,
.review-live-card,
.review-choice-board,
.review-finish-card {
  border-radius: 22rpx;
  background: #f9fafb;
}

.review-live-reference {
  position: relative;
  display: grid;
  gap: 30rpx;
  min-height: 560rpx;
  box-sizing: border-box;
  padding: 54rpx 40rpx 0;
  overflow: hidden;
  border: 1rpx solid rgba(255, 237, 213, 0.6);
  border-radius: 32rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.04);
}

.review-live-glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(20rpx);
  opacity: 0.72;
}

.review-live-glow.top {
  right: -64rpx;
  top: -64rpx;
  width: 256rpx;
  height: 256rpx;
  background: #fff7ed;
}

.review-live-glow.bottom {
  left: -54rpx;
  bottom: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: #ecfdf5;
}

.review-live-reference view {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  align-self: start;
}

.review-live-reference view text {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: #fff4ed;
  color: #ff8a4c;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.review-live-reference .review-live-mission {
  max-width: 380rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-live-brain {
  position: relative;
  z-index: 1;
  justify-self: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff7ed, rgba(255, 237, 213, 0.55));
  box-shadow: inset 0 6rpx 18rpx rgba(251, 146, 60, 0.08);
}

.review-live-reference > text:nth-of-type(4) {
  position: relative;
  z-index: 1;
  color: #2d3748;
  font-size: 44rpx;
  line-height: 70rpx;
  font-weight: 900;
}

.review-live-reference > text:nth-of-type(5) {
  position: relative;
  z-index: 1;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.review-live-bottom-line {
  height: 12rpx;
  margin: 20rpx -40rpx 0;
  background: linear-gradient(90deg, #ffedd5, #fed7aa, #ccfbf1);
}

.review-live-card {
  display: grid;
  gap: 8rpx;
  padding: 18rpx;
}

.review-live-card.compact {
  padding: 14rpx 16rpx;
}

.review-live-card text:first-child {
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-live-card text:nth-child(2) {
  color: #111827;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.review-live-card text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-choice-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 14rpx;
}

.review-choice-board.sequence {
  grid-template-columns: 1fr;
}

.review-choice-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  text-align: center;
}

.review-choice-tile.selected,
.review-choice-tile.matched {
  border-color: #14b8a6;
  background: #ecfdf5;
  color: #0f766e;
}

.review-live-actions {
  display: grid;
  gap: 12rpx;
}

.review-live-actions.grade {
  grid-template-columns: 1fr 1.4fr;
  gap: 18rpx;
}

.review-live-actions.finish {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions button {
  min-height: 96rpx;
  padding: 0;
  border: 2rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-shadow: none;
}

.review-live-actions.grade button:nth-child(3) {
  background: #ff8a4c;
  color: #ffffff;
  border-color: #ff8a4c;
  box-shadow: 0 12rpx 32rpx rgba(255, 138, 76, 0.25);
}

.review-live-actions.grade button:nth-child(1),
.review-live-actions.grade button:nth-child(2),
.review-live-actions.grade button:nth-child(4) {
  border-radius: 999rpx;
  min-height: 72rpx;
  background: rgba(243, 244, 246, 0.8);
  color: #6b7280;
  font-size: 24rpx;
}

.review-live-tool.stage-finished {
  gap: 0;
  min-height: 690rpx;
  justify-content: flex-start;
  padding: 0;
}

.review-live-tool.stage-finished .review-game-progress,
.review-live-tool.stage-finished .review-game-bar,
.review-live-tool.stage-finished .review-live-card,
.review-live-tool.stage-finished .review-choice-board,
.review-live-tool.stage-finished .review-round-strip,
.review-live-tool.stage-finished .review-live-actions.finish,
.review-live-tool.stage-finished .review-live-actions.grade {
  display: none;
}

.review-finish-card {
  flex: 1;
  display: grid;
  gap: 32rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.review-finish-hero {
  display: grid;
  justify-items: center;
  gap: 14rpx;
  margin: 16rpx 0 18rpx;
  text-align: center;
}

.review-finish-hero > text:first-child {
  width: 128rpx;
  height: 128rpx;
  border: 1rpx solid #ffffff;
  border-radius: 999rpx;
  background: #eaf3ef;
  box-shadow: 0 6rpx 14rpx rgba(40, 150, 137, 0.08);
}

.review-finish-hero > text:nth-child(2) {
  color: #2c3e50;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.review-finish-hero > text:nth-child(3) {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  color: #546e7a;
  font-size: 28rpx;
  line-height: 34rpx;
}

.review-finish-hero > text:nth-child(3) text {
  color: #f0714d;
  font-size: 32rpx;
  font-weight: 900;
}

.review-finish-section {
  display: grid;
  gap: 20rpx;
  padding: 32rpx;
  border: 1rpx solid #eaf3ef;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(40, 150, 137, 0.04);
}

.review-finish-section > view:first-child {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.review-finish-section > view:first-child > text:first-child {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #eaf3ef;
}

.review-finish-section > view:first-child > text:last-child {
  color: #2c3e50;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.review-finish-section.remembered > view:not(:first-child) {
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #eef7f4;
  border-radius: 16rpx;
  background: #f6fbf9;
}

.review-finish-section.remembered > view:not(:first-child) > text:first-child {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #289689;
}

.review-finish-section.remembered > view:not(:first-child) > text:last-child,
.review-finish-section.stuck > text,
.review-finish-section.tomorrow > view:nth-child(2) text {
  color: #455a64;
  font-size: 28rpx;
  line-height: 40rpx;
}

.review-finish-section.stuck {
  border-color: #fdf0eb;
}

.review-finish-section.stuck > view:first-child > text:first-child {
  background: #fdf0eb;
}

.review-finish-section.stuck > text {
  position: relative;
  padding: 28rpx;
  border: 1rpx solid #fdf0eb;
  border-radius: 16rpx;
  background: #fff9f6;
}

.review-finish-section.stuck > text text {
  display: block;
  margin-top: 8rpx;
  color: #d96b4a;
  font-weight: 800;
}

.review-finish-section.tomorrow {
  border-color: #f2f0ea;
}

.review-finish-section.tomorrow > view:first-child > text:first-child {
  background: #f2f0ea;
}

.review-finish-section.tomorrow > view:nth-child(2) {
  display: grid;
  grid-template-columns: 80rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #f2f0ea;
  border-radius: 16rpx;
  background: #fcfbf8;
}

.review-finish-section.tomorrow > view:nth-child(2) > text:first-child {
  width: 80rpx;
  height: 80rpx;
  border: 1rpx solid #f2f0ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.review-finish-section.tomorrow > view:nth-child(2) > text:nth-child(2) {
  color: #455a64;
  font-weight: 800;
}

.review-finish-bottom {
  display: grid;
  gap: 18rpx;
  padding: 8rpx 0 20rpx;
}

.review-finish-bottom button {
  min-height: 104rpx;
  border: 0;
  border-radius: 24rpx;
  background: #f0714d;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 32rpx rgba(240, 113, 77, 0.25);
}

.review-finish-bottom button:last-child {
  border: 1rpx solid #fde2d9;
  background: #ffffff;
  color: #f0714d;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.02);
}

.review-round-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.review-round-strip text {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 800;
}
