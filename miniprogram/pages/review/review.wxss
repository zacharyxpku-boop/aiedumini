page {
  background: #f7f8fa;
}

.review-page {
  min-height: 100vh;
  background: #f7f8fa;
  color: #111827;
}

.content-area {
  height: 100vh;
}

.content-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-review-screen {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 32rpx 176rpx;
  background: #f7f8fa;
  border-radius: 0;
}

.yd-review-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-review-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.yd-review-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-review-brand view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-review-brand text:first-child {
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111827;
}

.yd-review-brand text:last-child {
  font-size: 22rpx;
  line-height: 28rpx;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-review-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border: 1rpx solid #ccfbf1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0d9488;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.05);
}

.yd-review-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 172rpx;
  min-height: 292rpx;
  margin: 0 -32rpx;
  padding: 34rpx 40rpx 26rpx;
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
  background:
    radial-gradient(circle at 88% 8%, rgba(251, 191, 36, 0.22), transparent 26%),
    linear-gradient(135deg, rgba(224, 242, 241, 0.86), #f7f8fa 76%);
  box-shadow: none;
}

.yd-review-hero::before {
  content: "";
  position: absolute;
  left: 40rpx;
  bottom: 76rpx;
  width: 56rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f59e0b;
}

.yd-review-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.yd-review-title {
  max-width: 360rpx;
  color: #111827;
  font-size: 50rpx;
  line-height: 58rpx;
  font-weight: 950;
}

.yd-review-sub {
  max-width: 520rpx;
  width: fit-content;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.42);
  color: #4b5563;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 720;
  box-shadow: 0 4rpx 14rpx rgba(17, 24, 39, 0.04);
}

.route-note.short {
  display: block;
}

.yd-review-art {
  position: absolute;
  right: 12rpx;
  bottom: 14rpx;
  width: 188rpx;
  height: 174rpx;
  object-fit: contain;
  opacity: 0.86;
}

.review-map-rail {
  position: absolute;
  left: 230rpx;
  right: 92rpx;
  bottom: 42rpx;
  display: grid;
  grid-template-columns: repeat(4, 28rpx);
  justify-content: space-between;
  align-items: center;
  z-index: 2;
  pointer-events: none;
}

.review-map-rail text {
  display: block;
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: #14b8a6;
  box-shadow: 0 6rpx 14rpx rgba(20, 184, 166, 0.24);
}

.review-map-rail text:nth-child(2) {
  background: #f59e0b;
}

.review-map-rail text:nth-child(3) {
  background: #ffffff;
  border-color: #f59e0b;
}

.review-chip-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  max-width: 100%;
  overflow: hidden;
  padding-right: 0;
}

.review-chip-row text {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 36rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 28rpx;
  font-weight: 760;
  box-shadow: 0 3rpx 10rpx rgba(17, 24, 39, 0.04);
}

.review-chip-row text:first-child {
  border-color: #14b8a6;
  background: #14b8a6;
  color: #ffffff;
  font-weight: 900;
}

.review-main-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.review-main-tool-card {
  display: flex;
  min-height: 186rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: space-between;
  padding: 22rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.045);
}

.review-main-tool-card text {
  display: block;
}

.review-main-tool-card text:first-child {
  width: fit-content;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
}

.review-main-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 28rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.review-main-tool-card text:last-child {
  display: -webkit-box;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 600;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-main-tool-card.warm {
  background: #fff7ed;
}

.review-main-tool-card.yellow {
  background: #fef3c7;
}

.review-main-tool-card.blue {
  background: #eff6ff;
}

.review-main-tool-card.teal {
  background: #ecfdf5;
}

.review-record-panel,
.review-target-card,
.review-feedback-strip,
.review-empty-note,
.review-template-pack,
.review-template-workbench {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.06);
}

.review-record-panel {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
}

.review-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-section-head text:first-child {
  color: #111827;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.review-section-head text:last-child {
  max-width: 340rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.review-flow-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
}

.review-flow-tabs text {
  display: block;
  padding: 12rpx 4rpx;
  border-radius: 14rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.review-flow-tabs text.active {
  background: #ffffff;
  color: #0f766e;
  box-shadow: 0 6rpx 16rpx rgba(20, 184, 166, 0.13);
}

.review-topic-row,
.review-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.review-topic-card {
  display: block;
  min-height: 166rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid #f0ebe1;
  border-radius: 20rpx;
  background: #fff9f5;
  color: #2c2621;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  white-space: pre-line;
}

.review-topic-card.active {
  border-color: #ff8a4c;
  background: #fff1e7;
  color: #ea580c;
  box-shadow: 0 10rpx 26rpx rgba(255, 138, 76, 0.12);
}

.review-topic-cta,
.review-main-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  margin-top: 8rpx;
  border-radius: 24rpx;
  background: #f59e0b;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 34rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 26rpx rgba(245, 158, 11, 0.28);
}

.review-target-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8rpx 14rpx;
  align-items: center;
  padding: 26rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(20, 184, 166, 0.18), transparent 28%),
    linear-gradient(135deg, #fff5f0, #e8fafa);
  box-shadow: 0 10rpx 26rpx rgba(255, 125, 64, 0.12);
}

.review-target-card text:first-child {
  grid-column: 1 / -1;
  color: #ff7d40;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-target-card text:nth-child(2) {
  grid-column: 1;
  color: #111827;
  font-size: 38rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.review-target-card text:last-child {
  grid-column: 2;
  justify-self: end;
  max-width: 210rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #b45309;
  font-weight: 900;
}

.review-tool-card {
  display: grid;
  gap: 8rpx;
  min-height: 256rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid #f0f0ef;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.035);
}

.review-tool-card.ready {
  border-color: rgba(255, 125, 64, 0.32);
}

.review-tool-card.locked {
  opacity: 0.78;
}

.review-tool-card text {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 32rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.review-tool-card text:nth-child(3),
.review-tool-card text:last-child {
  color: #374151;
  font-weight: 650;
}

.review-tool-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #fff5f0;
  color: #ff7d40;
  text-align: center;
  line-height: 58rpx;
  font-size: 30rpx;
}

.review-empty-note {
  padding: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
  background: #f9fafb;
}

.review-live-tool {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-live-tool.stage-live {
  min-height: 620rpx;
  justify-content: center;
  padding: 34rpx 0;
}

.review-live-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #111827;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.review-live-head text:last-child {
  color: #14b8a6;
  font-size: 22rpx;
}

.review-game-progress {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #6b7280;
}

.review-game-progress text:first-child {
  color: #111827;
  font-size: 46rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.review-game-progress text:nth-child(2),
.review-game-progress text:last-child {
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.review-game-bar {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.review-game-bar view {
  width: 30%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff8a4c, #f27a3d);
}

.review-live-line,
.review-live-mission {
  color: #4b5563;
  font-size: 24rpx;
  line-height: 32rpx;
}

.review-live-reference,
.review-live-card,
.review-choice-board,
.review-finish-card {
  border-radius: 22rpx;
  background: #f9fafb;
}

.review-live-reference {
  display: grid;
  gap: 18rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(0, 0, 0, 0.055);
}

.review-live-reference text:first-child {
  color: #ff8a4c;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.review-live-reference text:nth-child(2) {
  color: #2d3748;
  font-size: 48rpx;
  line-height: 60rpx;
  font-weight: 900;
}

.review-live-reference text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-live-card {
  display: grid;
  gap: 8rpx;
  padding: 18rpx;
}

.review-live-card.compact {
  padding: 14rpx 16rpx;
}

.review-live-card text:first-child {
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-live-card text:nth-child(2) {
  color: #111827;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.review-live-card text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-choice-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 14rpx;
}

.review-choice-board.sequence {
  grid-template-columns: 1fr;
}

.review-choice-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  text-align: center;
}

.review-choice-tile.selected,
.review-choice-tile.matched {
  border-color: #14b8a6;
  background: #ecfdf5;
  color: #0f766e;
}

.review-live-actions {
  display: grid;
  gap: 12rpx;
}

.review-live-actions.grade {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions.finish {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions button {
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 82rpx;
  font-weight: 800;
  box-shadow: none;
}

.review-live-actions.finish button:first-child,
.review-live-actions.grade button:nth-child(3) {
  background: #ff8a4c;
  color: #ffffff;
}

.review-live-tool.stage-finished {
  gap: 22rpx;
  min-height: 620rpx;
  justify-content: center;
}

.review-live-tool.stage-finished .review-live-head,
.review-live-tool.stage-finished .review-game-progress,
.review-live-tool.stage-finished .review-game-bar,
.review-live-tool.stage-finished .review-live-line,
.review-live-tool.stage-finished .review-live-mission,
.review-live-tool.stage-finished .review-live-card,
.review-live-tool.stage-finished .review-choice-board,
.review-live-tool.stage-finished .review-live-actions.grade {
  display: none;
}

.review-live-tool.stage-finished::before {
  content: "这一局探索结束啦";
  display: block;
  color: #2c3e50;
  font-size: 60rpx;
  line-height: 68rpx;
  font-weight: 900;
  text-align: center;
}

.review-finish-card {
  display: grid;
  gap: 16rpx;
  padding: 20rpx;
  background: #f6fbf9;
}

.review-finish-card view {
  display: grid;
  gap: 6rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 18rpx rgba(40, 150, 137, 0.05);
}

.review-finish-card text:first-child {
  color: #111827;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.review-finish-card text:last-child {
  color: #4b5563;
  font-size: 23rpx;
  line-height: 31rpx;
}

.review-round-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.review-round-strip text {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 800;
}
