page {
  background: #f9f8f5;
}

.review-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1a211d;
  background: #f9f8f5;
}

.content-area {
  position: relative;
  z-index: 2;
  height: 100vh;
  box-sizing: border-box;
}

.content-inner {
  padding: calc(108rpx + env(safe-area-inset-top)) 30rpx calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-review-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  min-height: auto;
  margin-bottom: 18rpx;
  padding: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 8% 4%, rgba(248, 198, 34, 0.18), transparent 24%),
    radial-gradient(circle at 92% 8%, rgba(34, 185, 92, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-review-top,
.yd-review-brand,
.review-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-review-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-review-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(248, 198, 34, 0.26);
  border-radius: 18rpx;
  background: #fff6c9;
  box-shadow: 0 14rpx 26rpx rgba(248, 198, 34, 0.18);
}

.yd-review-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-review-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-review-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-review-pill {
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-review-top .yd-review-pill {
  flex: 0 0 auto;
}

.yd-review-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 146rpx;
  gap: 14rpx;
  align-items: center;
  min-height: 178rpx;
  margin-top: 16rpx;
}

.yd-review-title {
  color: #101a16;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.1;
  letter-spacing: 0;
}

.yd-review-sub {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 20rpx;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.review-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.review-chip-row text {
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 19rpx;
  font-weight: 820;
  white-space: nowrap;
}

.yd-review-art {
  width: 146rpx;
  height: 138rpx;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 26rpx;
  background: #f3fbef;
}

.review-map-card {
  margin-top: 14rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.review-section-head text:first-child {
  color: #18211d;
  font-size: 25rpx;
  font-weight: 950;
}

.review-section-head text:last-child {
  color: #738077;
  font-size: 19rpx;
  font-weight: 780;
  line-height: 1.2;
  text-align: right;
}

.review-map-line {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.review-map-node {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 112rpx;
  align-content: center;
  justify-items: center;
  gap: 5rpx;
  padding: 9rpx 3rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 19rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8faf5 100%);
  box-shadow: 0 12rpx 24rpx rgba(41, 65, 52, 0.07);
}

.review-map-node:active {
  transform: translateY(1rpx);
  box-shadow: 0 8rpx 18rpx rgba(41, 65, 52, 0.05);
}

.review-map-node::after {
  content: "";
  position: absolute;
  top: 50%;
  right: -14rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #dce8dc;
  transform: translateY(-50%);
}

.review-map-node:last-child::after {
  display: none;
}

.review-map-node.done,
.review-map-node.active {
  border-color: rgba(34, 185, 92, 0.28);
  background: linear-gradient(180deg, #effbf2 0%, #ffffff 100%);
}

.review-map-node.final {
  border-color: rgba(248, 198, 34, 0.34);
  background: linear-gradient(180deg, #fff8df 0%, #ffffff 100%);
}

.review-map-icon {
  width: 38rpx;
  height: 38rpx;
  padding: 6rpx;
  border-radius: 15rpx;
  background: #f0f8ee;
}

.review-map-node text {
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-map-node text:nth-child(2) {
  color: #17211d;
  font-size: 18rpx;
  font-weight: 950;
  line-height: 1.18;
}

.review-map-node text:nth-child(3) {
  color: #526158;
  font-size: 16rpx;
  font-weight: 780;
  line-height: 1.18;
}

.review-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.review-action-card {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  min-height: 108rpx;
  align-items: center;
  justify-items: stretch;
  column-gap: 10rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 34rpx rgba(38, 58, 43, 0.055);
}

.review-action-card.primary {
  background: linear-gradient(180deg, #ffffff 0%, #f0fbf0 100%);
}

.review-action-card image {
  grid-row: 1 / span 2;
  width: 52rpx;
  height: 52rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.review-action-card text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
}

.review-action-card text:nth-child(2) {
  color: #17211d;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.2;
  white-space: nowrap;
}

.review-action-card text:nth-child(3) {
  color: #66746d;
  font-size: 18rpx;
  line-height: 1.25;
}

.review-main-cta {
  height: 64rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.22);
  font-size: 23rpx;
  font-weight: 950;
  line-height: 64rpx;
  text-align: center;
}

.review-action-row {
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-action-row button {
  min-height: 58rpx;
  padding: 0 14rpx;
  border: 2rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 999rpx;
  color: #14854a;
  background: rgba(255, 255, 255, 0.92);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 58rpx;
  white-space: nowrap;
}

.review-action-row button:last-child {
  border-color: rgba(248, 198, 34, 0.28);
  color: #9a6b00;
  background: #fff8df;
}
