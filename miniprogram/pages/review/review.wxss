page {
  background: #f9f8f5;
}

.review-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1a211d;
  background: #f9f8f5;
}

.content-area {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  height: auto;
  box-sizing: border-box;
}

.content-inner {
  padding: calc(86rpx + env(safe-area-inset-top)) 28rpx calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-review-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 14rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  margin-bottom: 0;
  padding: 22rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 8% 4%, rgba(248, 198, 34, 0.18), transparent 24%),
    radial-gradient(circle at 92% 8%, rgba(34, 185, 92, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-review-top,
.yd-review-brand,
.review-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-review-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-review-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 7rpx;
  border: 1rpx solid rgba(248, 198, 34, 0.26);
  border-radius: 18rpx;
  background: #fff6c9;
  box-shadow: 0 14rpx 26rpx rgba(248, 198, 34, 0.18);
}

.yd-review-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-review-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-review-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-review-pill {
  display: inline-flex;
  width: max-content;
  max-width: 100%;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-review-top .yd-review-pill {
  flex: 0 0 auto;
}

.yd-review-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 164rpx;
  gap: 14rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 238rpx;
  margin-top: 0;
}

.yd-review-title {
  color: #101a16;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.1;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-review-sub {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 24rpx;
  line-height: 1.36;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.review-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.review-chip-row text {
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  border-radius: 999rpx;
  color: #26754c;
  background: #f0fbf0;
  font-size: 20rpx;
  font-weight: 820;
  white-space: nowrap;
}

.yd-review-art {
  width: 158rpx;
  height: 142rpx;
  align-self: center;
  object-fit: contain;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 26rpx;
  background: #f3fbef;
}

.review-section-head text:first-child {
  color: #18211d;
  font-size: 25rpx;
  font-weight: 950;
}

.review-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.2;
  text-align: right;
}

.review-record-panel {
  padding: 14rpx 12rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.045);
}

.review-workshop-lead {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #fff8df;
  color: #17211d;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1.26;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-feedback-strip {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  background: #eef8ed;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.14);
}

.review-feedback-strip text {
  min-width: 0;
  color: #25352c;
  font-size: 22rpx;
  font-weight: 840;
  line-height: 1.26;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-feedback-strip text:last-child {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #14854a;
  font-size: 21rpx;
  font-weight: 950;
  white-space: nowrap;
}

.review-record-steps {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.review-lane-card {
  display: grid;
  min-width: 0;
  min-height: 138rpx;
  align-content: center;
  gap: 7rpx;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: #f6fbf0;
}

.review-lane-card {
  color: #17211d;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.review-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 10rpx;
}

.review-tool-card {
  display: grid;
  min-width: 0;
  min-height: 132rpx;
  align-content: center;
  gap: 6rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background: #f6fbf0;
  box-shadow: inset 0 0 0 1rpx rgba(232, 238, 230, 0.96);
}

.review-tool-card.ready {
  background: #eef7ff;
  box-shadow: inset 0 0 0 2rpx rgba(76, 159, 255, 0.16);
}

.review-tool-card.locked {
  opacity: 0.76;
}

.review-tool-card:active {
  transform: scale(0.985);
}

.review-tool-card text {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.review-tool-card text:first-child {
  color: #17211d;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.12;
}

.review-tool-card text:nth-child(2) {
  display: -webkit-box;
  overflow: hidden;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.2;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.review-tool-card text:nth-child(3) {
  justify-self: center;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #26754c;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.12;
}

.review-empty-note {
  display: block;
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(76, 159, 255, 0.16);
  border-radius: 16rpx;
  background: #eef7ff;
}

.review-empty-note text {
  display: block;
  color: #52636f;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.28;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-live-tool {
  display: grid;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 14rpx;
  border: 2rpx solid rgba(76, 159, 255, 0.18);
  border-radius: 22rpx;
  background: #eef7ff;
}

.review-live-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.review-live-head text:first-child {
  color: #12201a;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.16;
}

.review-live-head text:last-child {
  flex: 0 0 auto;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  color: #23679f;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.review-live-line,
.review-live-empty text {
  display: block;
  color: #52636f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-live-empty {
  display: grid;
  gap: 8rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
}

.review-live-card {
  display: grid;
  gap: 7rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.1);
}

.review-live-card text {
  display: block;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-live-card text:first-child {
  color: #23679f;
  font-size: 20rpx;
  font-weight: 950;
}

.review-live-card text:nth-child(2) {
  color: #16221d;
  font-size: 25rpx;
  font-weight: 930;
  line-height: 1.28;
}

.review-live-card text:nth-child(3) {
  color: #64706a;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.3;
}

.review-match-board,
.review-snake-board {
  display: grid;
  gap: 10rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.1);
}

.review-match-board {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-match-tile,
.review-snake-tile {
  display: grid;
  min-height: 78rpx;
  align-content: center;
  gap: 4rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.14);
}

.review-match-tile:active,
.review-snake-tile:active {
  transform: scale(0.985);
}

.review-match-tile.selected,
.review-snake-tile.picked {
  background: #fff8df;
  box-shadow: inset 0 0 0 2rpx rgba(248, 198, 34, 0.45);
}

.review-match-tile.matched {
  opacity: 0.62;
  background: #eef8ed;
  box-shadow: inset 0 0 0 2rpx rgba(34, 185, 92, 0.24);
}

.review-match-tile text,
.review-snake-tile text,
.review-snake-question,
.review-snake-done {
  display: block;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-match-tile text:first-child {
  color: #23679f;
  font-size: 20rpx;
  font-weight: 950;
}

.review-match-tile text:last-child,
.review-snake-tile text {
  color: #16221d;
  font-size: 22rpx;
  font-weight: 880;
  line-height: 1.22;
}

.review-snake-question {
  color: #52636f;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.28;
}

.review-snake-tiles {
  display: grid;
  gap: 8rpx;
}

.review-snake-done {
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  color: #14854a;
  background: #eef8ed;
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}

.review-live-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.review-live-actions button {
  min-height: 74rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 18rpx;
  background: #16221d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 74rpx;
}

.review-live-actions button:last-child {
  color: #17211d;
  background: #ffffff;
}

.review-live-actions.grade {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions.finish {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions.finish button {
  min-height: 64rpx;
  line-height: 64rpx;
  color: #17211d;
  background: #f4f7fb;
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.16);
}

.review-live-actions.finish button:last-child {
  color: #ffffff;
  background: #23679f;
}

.review-live-actions.grade button {
  min-height: 68rpx;
  line-height: 68rpx;
  color: #17211d;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(76, 159, 255, 0.14);
}

.review-live-actions.grade button:nth-child(3) {
  color: #ffffff;
  background: #16221d;
}

.review-template-pack {
  display: grid;
  gap: 6rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(214, 230, 205, 0.95);
  border-radius: 22rpx;
  background: #fbfff6;
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.045);
}

.review-template-pack.compact {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  padding: 12rpx 14rpx;
}

.review-template-title,
.review-template-meta {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-template-title {
  color: #17211d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.25;
}

.review-template-meta {
  color: #6a756d;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.32;
}

.review-template-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.review-template-action {
  display: flex;
  min-width: 0;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 999rpx;
  background: #ffffff;
  color: #17211d;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 72rpx;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.review-template-workbench {
  display: grid;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  border-radius: 22rpx;
  background: #f3fbef;
  box-shadow: 0 14rpx 30rpx rgba(38, 58, 43, 0.06);
}

.review-workbench-title,
.review-workbench-status {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-workbench-title {
  color: #12201a;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.12;
}

.review-workbench-status {
  width: max-content;
  max-width: 100%;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #5d6b62;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.22;
}

.review-workbench-line,
.review-workbench-safe {
  display: block;
  max-width: 100%;
  overflow-wrap: break-word;
  word-break: break-word;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.34;
}

.review-workbench-line {
  color: #35443b;
}

.review-workbench-safe {
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  color: #5b5b39;
  background: #fff8df;
}

.review-preview-card {
  display: flex;
  min-width: 0;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  padding: 12rpx 10rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #17211d;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.2;
  overflow-wrap: break-word;
  word-break: break-word;
  text-align: center;
}

.review-mechanism-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
}

.review-mechanism-cell {
  display: flex;
  min-width: 0;
  min-height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f6fbf0;
  color: #17211d;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.18;
  text-align: center;
  overflow-wrap: break-word;
  word-break: break-word;
}

.review-main-cta {
  height: 94rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.22);
  font-size: 31rpx;
  font-weight: 950;
  line-height: 94rpx;
  text-align: center;
}
