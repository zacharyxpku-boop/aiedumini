page {
  background: #f7f8fa;
}

.review-page {
  min-height: 100vh;
  background: #f7f8fa;
  color: #111827;
}

.content-area {
  height: 100vh;
}

.content-inner {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 0 env(safe-area-inset-bottom);
}

.yd-review-screen {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 198rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 0 32rpx 176rpx;
  background: #f7f8fa;
  border-radius: 0;
}

.yd-review-app {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.yd-review-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.yd-review-brand {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.yd-review-mark {
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
}

.yd-review-brand view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.yd-review-brand text:first-child {
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111827;
}

.yd-review-brand text:last-child {
  font-size: 22rpx;
  line-height: 28rpx;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-review-pill {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.05);
}

.yd-review-hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 214rpx;
  min-height: 246rpx;
  padding: 28rpx 24rpx 24rpx;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
  background: linear-gradient(135deg, #e6f4f1 0%, #ffffff 54%, #fff7ed 100%);
  box-shadow: 0 18rpx 36rpx rgba(17, 24, 39, 0.07);
}

.yd-review-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.yd-review-title {
  max-width: 360rpx;
  color: #111827;
  font-size: 54rpx;
  line-height: 60rpx;
  font-weight: 900;
}

.yd-review-sub {
  max-width: 370rpx;
  color: #4b5563;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 600;
}

.route-note.short {
  display: block;
}

.yd-review-art {
  position: absolute;
  right: 12rpx;
  bottom: 2rpx;
  width: 204rpx;
  height: 188rpx;
  object-fit: contain;
}

.review-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding-right: 116rpx;
}

.review-chip-row text {
  padding: 9rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #374151;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 118, 110, 0.08);
}

.review-main-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.review-main-tool-card {
  display: flex;
  min-height: 180rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: space-between;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.07);
}

.review-main-tool-card text {
  display: block;
}

.review-main-tool-card text:first-child {
  width: fit-content;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b7280;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 800;
}

.review-main-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 31rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.review-main-tool-card text:last-child {
  display: -webkit-box;
  color: #4b5563;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 600;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-main-tool-card.warm {
  background: #fff7ed;
}

.review-main-tool-card.yellow {
  background: #fef3c7;
}

.review-main-tool-card.blue {
  background: #eff6ff;
}

.review-main-tool-card.teal {
  background: #ecfdf5;
}

.review-record-panel,
.review-target-card,
.review-feedback-strip,
.review-empty-note,
.review-template-pack,
.review-template-workbench {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.06);
}

.review-record-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
}

.review-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-section-head text:first-child {
  color: #111827;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.review-section-head text:last-child {
  max-width: 340rpx;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
}

.review-flow-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f3f4f6;
}

.review-flow-tabs text {
  display: block;
  padding: 12rpx 4rpx;
  border-radius: 14rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
}

.review-flow-tabs text.active {
  background: #ffffff;
  color: #0f766e;
  box-shadow: 0 6rpx 16rpx rgba(20, 184, 166, 0.13);
}

.review-topic-row,
.review-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.review-topic-card {
  display: block;
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #eef2f7;
  border-radius: 20rpx;
  background: #f9fafb;
  color: #111827;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  white-space: pre-line;
}

.review-topic-card.active {
  border-color: #14b8a6;
  background: #ecfdf5;
  color: #0f766e;
}

.review-topic-cta,
.review-main-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  margin-top: 8rpx;
  border-radius: 24rpx;
  background: #f59e0b;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 34rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 26rpx rgba(245, 158, 11, 0.28);
}

.review-target-card {
  display: grid;
  gap: 8rpx;
  padding: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(20, 184, 166, 0.12);
}

.review-target-card text:first-child {
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-target-card text:nth-child(2) {
  color: #111827;
  font-size: 31rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.review-target-card text:last-child {
  color: #6b7280;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 23rpx;
  line-height: 30rpx;
}

.review-feedback-strip text:last-child {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #b45309;
  font-weight: 900;
}

.review-tool-card {
  display: grid;
  gap: 8rpx;
  min-height: 216rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 2rpx solid #eef2f7;
  border-radius: 22rpx;
  background: #ffffff;
}

.review-tool-card.ready {
  border-color: rgba(20, 184, 166, 0.34);
}

.review-tool-card.locked {
  opacity: 0.78;
}

.review-tool-card text {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-tool-card text:nth-child(2) {
  color: #111827;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.review-tool-card text:nth-child(3),
.review-tool-card text:last-child {
  color: #374151;
  font-weight: 650;
}

.review-tool-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #ecfdf5;
  color: #0f766e;
  text-align: center;
  line-height: 54rpx;
  font-size: 30rpx;
}

.review-empty-note {
  padding: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 32rpx;
  background: #f9fafb;
}

.review-live-tool {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review-live-tool.stage-live {
  min-height: 440rpx;
  justify-content: center;
  padding: 24rpx 0;
}

.review-live-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #111827;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.review-live-head text:last-child {
  color: #14b8a6;
  font-size: 22rpx;
}

.review-game-progress {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #6b7280;
}

.review-game-progress text:first-child {
  color: #111827;
  font-size: 46rpx;
  line-height: 52rpx;
  font-weight: 900;
}

.review-game-progress text:nth-child(2),
.review-game-progress text:last-child {
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.review-game-bar {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.review-game-bar view {
  width: 32%;
  height: 100%;
  border-radius: inherit;
  background: #14b8a6;
}

.review-live-line,
.review-live-mission {
  color: #4b5563;
  font-size: 24rpx;
  line-height: 32rpx;
}

.review-live-reference,
.review-live-card,
.review-choice-board,
.review-finish-card {
  border-radius: 22rpx;
  background: #f9fafb;
}

.review-live-reference {
  display: grid;
  gap: 12rpx;
  padding: 26rpx;
  text-align: center;
}

.review-live-reference text:first-child {
  color: #0f766e;
  font-size: 23rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.review-live-reference text:nth-child(2) {
  color: #111827;
  font-size: 33rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.review-live-reference text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-live-card {
  display: grid;
  gap: 8rpx;
  padding: 18rpx;
}

.review-live-card.compact {
  padding: 14rpx 16rpx;
}

.review-live-card text:first-child {
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 900;
}

.review-live-card text:nth-child(2) {
  color: #111827;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
}

.review-live-card text:last-child {
  color: #6b7280;
  font-size: 22rpx;
  line-height: 28rpx;
}

.review-choice-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 14rpx;
}

.review-choice-board.sequence {
  grid-template-columns: 1fr;
}

.review-choice-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  text-align: center;
}

.review-choice-tile.selected,
.review-choice-tile.matched {
  border-color: #14b8a6;
  background: #ecfdf5;
  color: #0f766e;
}

.review-live-actions {
  display: grid;
  gap: 12rpx;
}

.review-live-actions.grade {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions.finish {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.review-live-actions button {
  height: 76rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #374151;
  font-size: 24rpx;
  line-height: 76rpx;
  font-weight: 800;
  box-shadow: none;
}

.review-live-actions.finish button:first-child,
.review-live-actions.grade button:nth-child(3) {
  background: #14b8a6;
  color: #ffffff;
}

.review-live-tool.stage-finished {
  gap: 18rpx;
}

.review-live-tool.stage-finished .review-live-head,
.review-live-tool.stage-finished .review-game-progress,
.review-live-tool.stage-finished .review-game-bar,
.review-live-tool.stage-finished .review-live-line,
.review-live-tool.stage-finished .review-live-mission,
.review-live-tool.stage-finished .review-live-card,
.review-live-tool.stage-finished .review-choice-board,
.review-live-tool.stage-finished .review-live-actions.grade {
  display: none;
}

.review-live-tool.stage-finished::before {
  content: "这一局探索结束啦";
  display: block;
  color: #111827;
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 900;
  text-align: center;
}

.review-finish-card {
  display: grid;
  gap: 14rpx;
  padding: 18rpx;
  background: #ffffff;
}

.review-finish-card view {
  display: grid;
  gap: 6rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f9fafb;
}

.review-finish-card text:first-child {
  color: #111827;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.review-finish-card text:last-child {
  color: #4b5563;
  font-size: 23rpx;
  line-height: 31rpx;
}

.review-round-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.review-round-strip text {
  padding: 9rpx 12rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 26rpx;
  font-weight: 800;
}
