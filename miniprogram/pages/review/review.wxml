<view class="review-page">
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner">
      <view class="yd-review-screen yd-app-screen yd-review-app stage-{{reviewFlowStage}}">
        <view class="yd-review-top" wx:if="{{reviewFlowStage === 'main'}}">
          <text class="yd-review-brand">知识乐园</text>
          <text class="yd-review-pill">···</text>
        </view>

        <view class="yd-review-hero" wx:if="{{reviewFlowStage === 'main'}}">
          <view class="review-route-map" aria-hidden="true">
            <text class="review-route-seg seg-a"></text>
            <text class="review-route-seg seg-b"></text>
            <text class="review-route-seg seg-c"></text>
            <text class="review-route-node node-a"><text></text></text>
            <text class="review-route-node node-b"><text></text></text>
            <text class="review-route-node node-c"><text></text></text>
            <text class="review-route-blob"></text>
          </view>
            <view class="yd-review-copy">
              <text class="yd-review-title"><text>选个知识点，</text><text>开一局</text></text>
              <text class="yd-review-sub route-note short"><text>没有错题也能先玩；</text><text>有错题后会变成你的<text class="review-sub-highlight">专属练习</text></text></text>
            </view>
            <image class="yd-review-art" mode="aspectFit" src="/assets/reference/review-world-map-transparent.png" />
          </view>

          <view class="review-chip-row" wx:if="{{reviewFlowStage === 'main'}}"><text>分数</text><text>应用题</text><text>英语单词</text><text>阅读理解</text><text>计算检查</text><text>表达组织</text></view>

        <view class="review-main-tool-grid" wx:if="{{reviewFlowStage === 'main'}}">
          <view class="review-main-tool-card warm" data-stage="topic" data-tool-id="whack" bindtap="setReviewFlowStage"><view><text class="review-main-tool-icon hammer"></text><text class="review-main-tool-time">约3分</text></view><text>错因地鼠</text><text>揪出隐藏的易错点，轻松找漏洞</text></view>
          <view class="review-main-tool-card yellow" data-stage="topic" data-tool-id="quiz" bindtap="setReviewFlowStage"><view><text class="review-main-tool-icon lightning"></text><text class="review-main-tool-time">约2分</text></view><text>快闪问答</text><text>快速判断，极速反应知识快练</text></view>
          <view class="review-main-tool-card blue" data-stage="topic" data-tool-id="match" bindtap="setReviewFlowStage"><view><text class="review-main-tool-icon puzzle"></text><text class="review-main-tool-time">约4分</text></view><text>拼图配对</text><text>核心概念连连看，拼合线索</text></view>
          <view class="review-main-tool-card teal" data-stage="topic" data-tool-id="snake" bindtap="setReviewFlowStage"><view><text class="review-main-tool-icon path"></text><text class="review-main-tool-time">约5分</text></view><text>路线接龙</text><text>逻辑推导解题路线，步步推导</text></view>
        </view>

        <view class="review-record-panel" wx:if="{{reviewFlowStage !== 'main'}}">
          <text class="review-subpage-top" wx:if="{{reviewFlowStage !== 'finished'}}">
            <text bindtap="closeReviewSubpage">‹</text>
            <text>{{reviewFlowStage === 'topic' ? '选知识点' : reviewFlowStage === 'tool' ? '玩法选择' : reviewFlowStage === 'finished' ? '结算页' : (activeReviewTool.title || '快闪问答')}}</text>
            <text>{{reviewFlowStage === 'topic' ? ':)' : '···'}}</text>
          </text>
          <view class="review-section-head" wx:if="{{reviewFlowStage === 'topic' || reviewFlowStage === 'tool'}}"><text>{{reviewFlowStage === 'topic' ? '今天想练哪一块？' : '挑选开局方式'}}</text><text>{{reviewFlowStage === 'topic' ? '选个知识点，马上开局探索' : '选一个最适合现在的节奏，马上开始'}}</text></view>
          <text class="review-flow-tabs" wx:if="{{reviewFlowStage === 'topic' || reviewFlowStage === 'tool'}}">
            <text class="{{reviewFlowStage === 'topic' ? 'active' : ''}}" data-stage="topic" bindtap="setReviewFlowStage">选知识点</text>
            <text class="{{reviewFlowStage === 'tool' ? 'active' : ''}}" data-stage="tool" bindtap="setReviewFlowStage">玩法选择</text>
            <text class="{{reviewFlowStage === 'live' ? 'active' : ''}}" data-stage="live" bindtap="setReviewFlowStage">进行中</text>
            <text class="{{reviewFlowStage === 'finished' ? 'active' : ''}}" data-stage="finished" bindtap="setReviewFlowStage">一局结束</text>
          </text>
          <view class="review-topic-search" wx:if="{{reviewFlowStage === 'topic'}}">
            <text class="review-topic-search-icon">⌕</text>
            <input value="{{topicSearchText}}" bindinput="onTopicSearchInput" placeholder="搜索知识点，如：小数乘法" />
          </view>
          <view class="review-topic-toolbar" wx:if="{{reviewFlowStage === 'topic'}}">
            <text>推荐探索</text>
            <text bindtap="shuffleKnowledgeStarterTopics">换一批</text>
          </view>
          <view class="review-topic-row" wx:if="{{reviewFlowStage === 'topic'}}">
            <view wx:for="{{knowledgeStarterTopicCards}}" wx:key="topic" class="review-topic-card review-topic-chip theme-{{item.theme}} {{selectedKnowledgeTopic === item.topic ? 'active' : ''}}" data-topic="{{item.topic}}" bindtap="selectKnowledgeStarterTopic">
              <text>{{item.topic}}</text>
              <text>{{item.tag}}</text>
              <text>{{item.duration}}</text>
            </view>
          </view>
          <text class="review-topic-cta" wx:if="{{reviewFlowStage === 'topic'}}" data-stage="tool" bindtap="setReviewFlowStage">用这个开一局</text>
          <view class="review-workshop-lead review-target-card" wx:if="{{reviewFlowStage === 'tool'}}"><text>当前攻克目标</text><text>{{selectedKnowledgeTopic || '分数除法'}}</text><text>{{cards.length || 3}} 张卡 · 挑选开局方式，马上开始。</text></view>
          <view class="review-feedback-strip" wx:if="{{feedbackText && reviewFlowStage !== 'live' && reviewFlowStage !== 'finished'}}"><text>{{feedbackText}}</text><text wx:if="{{activeReviewTool && activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修这一张</text></view>
          <view class="review-tool-grid" wx:if="{{reviewFlowStage === 'tool'}}">
            <view wx:for="{{visiblePlayableReviewTools}}" wx:key="id" class="review-tool-card {{item.available ? 'ready' : 'locked'}} {{item.themeClass}} {{selectedPlayableReviewToolId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectPlayableReviewTool"><text class="review-tool-selected-mark"></text><text class="review-tool-icon">{{item.icon}}</text><text>{{item.title}}</text><text>{{item.line}}</text><text>{{item.duration}}</text><text>{{item.status}} · {{item.count}} 张</text><text>{{item.mission}}</text></view>
          </view>
          <view class="review-template-workbench" wx:if="{{reviewFlowStage === 'tool' && practiceTemplateWorkbench && practiceTemplateWorkbench.id}}">
            <text class="review-template-head"><text>{{practiceTemplateWorkbench.title}}</text><text>{{practiceTemplateWorkbench.status}}</text></text>
            <text class="review-template-line">{{practiceTemplateWorkbench.line}}</text>
            <text class="review-template-samples">
              <text class="review-template-sample"><text>{{practiceTemplateWorkbench.samples[0].label}}</text><text>{{practiceTemplateWorkbench.samples[0].source}}</text></text>
              <text class="review-template-sample"><text>{{practiceTemplateWorkbench.samples[1].label}}</text><text>{{practiceTemplateWorkbench.samples[1].source}}</text></text>
              <text class="review-template-sample"><text>{{practiceTemplateWorkbench.samples[2].label}}</text><text>{{practiceTemplateWorkbench.samples[2].source}}</text></text>
            </text>
            <text class="review-template-safe">{{practiceTemplateWorkbench.safetyLine}}</text>
          </view>
          <view class="review-empty-note" wx:if="{{reviewFlowStage !== 'topic' && activeReviewTool && activeReviewTool.empty}}"><text>还没有真实卡。先上传材料或完成一次 AI私教。</text></view>
          <view class="review-live-tool stage-{{reviewFlowStage}}" wx:elif="{{reviewFlowStage !== 'tool' && activeReviewTool && activeReviewTool.id}}">
            <view class="review-play-top" wx:if="{{reviewFlowStage === 'live'}}"><text bindtap="closeReviewSubpage">×</text><text>{{activeReviewTool.title || '快闪问答'}}</text><text>Ⅱ</text></view>
            <view class="review-game-progress" wx:if="{{reviewFlowStage === 'live'}}"><text class="review-game-count"><text>1</text><text>/ {{activeReviewTool.itemCount || 3}}</text></text><text>正在热身</text></view>
            <view class="review-game-bar" wx:if="{{reviewFlowStage === 'live'}}"><view></view></view>
            <view class="review-live-reference" wx:if="{{reviewFlowStage === 'live'}}"><text class="review-live-glow top"></text><text class="review-live-glow bottom"></text><text class="review-live-labels"><text>{{activeReviewTool.primary.label || '找第一步'}}</text><text class="review-live-mission">{{activeReviewTool.mission}}</text></text><text class="review-live-brain"></text><text>{{activeReviewTool.primary.prompt || '遇到“相遇问题”时，脑海里跳出的第一个动作应该是什么？'}}</text><text>{{activeReviewTool.primary.check || '先在心里想好第一步，再点击下方按钮'}}</text><text class="review-live-bottom-line"></text></view>
            <view class="review-play-panel whack" wx:if="{{reviewFlowStage === 'live' && activeReviewTool.gameType === 'whack' && activeReviewTool.whackQuestion}}"><text class="review-play-question"><text>快选错因</text><text>{{activeReviewTool.whackQuestion.question}}</text></text><view class="review-play-choice-grid"><button wx:for="{{activeReviewTool.whackChoices}}" wx:key="id" data-index="{{item.index}}" bindtap="selectWhackChoice">{{item.text}}</button></view><button class="review-play-done" wx:if="{{activeReviewTool.whackComplete}}" data-result="remembered" bindtap="finishPlayableReviewTool">记录本局证据</button></view>
            <view class="review-play-panel match" wx:if="{{reviewFlowStage === 'live' && activeReviewTool.gameType === 'match' && activeReviewTool.tiles.length}}"><text class="review-play-question"><text>拼图配对</text><text>把卡点和对应的第一步拼在一起。</text></text><view class="review-play-tile-grid"><text wx:for="{{activeReviewTool.tiles}}" wx:key="id" class="review-play-tile {{item.selected ? 'selected' : ''}} {{item.matched ? 'matched' : ''}}" data-id="{{item.id}}" bindtap="selectMatchTile">{{item.text}}</text></view><button class="review-play-done" wx:if="{{activeReviewTool.attemptSummary && activeReviewTool.attemptSummary.correct >= activeReviewTool.itemCount}}" data-result="remembered" bindtap="finishPlayableReviewTool">记录本局证据</button></view>
            <view class="review-play-panel snake" wx:if="{{reviewFlowStage === 'live' && activeReviewTool.gameType === 'snake' && activeReviewTool.currentTrack}}"><text class="review-play-question"><text>路线接龙</text><text>{{activeReviewTool.currentTrack.question || '按第一步顺序接起来。'}}</text></text><view class="review-play-track"><text wx:for="{{activeReviewTool.currentTrack.tiles}}" wx:key="id" class="review-play-step {{item.picked ? 'picked' : ''}}" data-id="{{item.id}}" bindtap="pickSnakeTile">{{item.text}}</text></view><button class="review-play-done" wx:if="{{activeReviewTool.snakeComplete}}" data-result="remembered" bindtap="finishPlayableReviewTool">记录本局证据</button></view>
            <view class="review-finish-card" wx:if="{{reviewFlowStage === 'finished' && activeReviewTool.attemptSummary}}">
              <view class="review-finish-hero"><text></text><text>这一局探索结束啦</text><text>档案袋留下了 <text>{{activeReviewTool.finishEvidenceCount || activeReviewTool.attemptSummary.correct}}</text> 条证据</text></view>
              <view class="review-finish-section remembered"><view><text></text><text>记住了什么</text></view><view><text></text><text>{{activeReviewTool.finishEvidencePrimary}}</text></view><view><text></text><text>{{activeReviewTool.finishEvidenceSecondary}}</text></view></view>
              <view class="review-finish-section stuck"><view><text></text><text>还卡在哪里</text></view><text>{{activeReviewTool.finishStuckLine}}<text>大脑正在给它建新文件夹呢，明天再认认门～</text></text></view>
              <view class="review-finish-section tomorrow"><view><text></text><text>明天回访什么</text></view><view><text></text><text>{{activeReviewTool.finishTomorrowLine}}</text><text>系统已安排 · 预计 2 分钟</text></view></view>
              <view class="review-finish-bottom"><button data-result="retry" bindtap="finishPlayableReviewTool">再练一局</button><button bindtap="openReviewParentEvidence">给家长看证据</button></view>
            </view>
            <view class="review-live-actions grade" wx:if="{{reviewFlowStage === 'live' && activeReviewTool.gameType !== 'whack' && activeReviewTool.gameType !== 'match' && activeReviewTool.gameType !== 'snake'}}"><button data-rating="again" bindtap="rate">需要提示</button><button data-result="remembered" bindtap="finishPlayableReviewTool">我能说第一步</button><button data-rating="hard" bindtap="rate">有点模糊</button><button data-rating="easy" bindtap="rate">先跳过</button></view>
          </view>
        </view>

        <text class="review-main-cta" wx:if="{{reviewFlowStage === 'main'}}" data-stage="topic" bindtap="setReviewFlowStage">开始一局练习</text>
        <text class="review-main-cta" wx:if="{{reviewFlowStage === 'topic'}}" data-stage="tool" bindtap="setReviewFlowStage">用这个开一局</text>
        <view class="review-main-cta" wx:if="{{reviewFlowStage === 'tool'}}" bindtap="startSelectedPlayableReviewTool">{{selectedPlayableReviewToolStartText}}</view>
      </view>
    </view>
  </scroll-view>
</view>
