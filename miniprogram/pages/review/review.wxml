<view class="review-page">
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner">
      <view class="yd-review-screen yd-app-screen yd-review-app">
        <view class="yd-review-pill">知识乐园</view>
        <view class="yd-review-top">
          <view class="yd-review-brand"><image class="yd-review-mark" mode="aspectFit" src="/assets/reference/brand-house.png" /><view><text>知识乐园</text><text>把错因变成互动玩法</text></view></view>
          <view class="yd-review-pill">{{revisitRunway.due || 0}} 张到期</view>
        </view>

        <view class="yd-review-hero">
          <view class="yd-review-copy">
            <view class="yd-review-title">选个知识点，开一局</view>
            <view class="yd-review-sub route-note short">没有错题也能先玩；有错题后会变成你的专属练习。</view>
            <view class="review-chip-row"><text>错因地鼠</text><text>快闪问答</text><text>拼图配对</text><text>路线接龙</text></view>
          </view>
          <image class="yd-review-art" mode="aspectFit" src="/assets/reference/review-world-map-transparent.png" />
        </view>

        <view class="review-record-panel">
          <view class="review-section-head"><text>先选知识点</text><text>{{selectedKnowledgeTopic}}</text></view>
          <text class="review-flow-tabs">
            <text class="{{reviewFlowStage === 'topic' ? 'active' : ''}}">选知识点</text>
            <text class="{{reviewFlowStage === 'tool' ? 'active' : ''}}">玩法选择</text>
            <text class="{{reviewFlowStage === 'live' ? 'active' : ''}}">游戏进行中</text>
            <text class="{{reviewFlowStage === 'finished' ? 'active' : ''}}">一局结束</text>
          </text>
          <view class="review-topic-row">
            <text class="review-topic-chip {{selectedKnowledgeTopic === '应用题第一步' ? 'active' : ''}}" data-topic="应用题第一步" bindtap="selectKnowledgeStarterTopic">应用题第一步</text>
            <text class="review-topic-chip {{selectedKnowledgeTopic === '阅读理解' ? 'active' : ''}}" data-topic="阅读理解" bindtap="selectKnowledgeStarterTopic">阅读理解</text>
            <text class="review-topic-chip {{selectedKnowledgeTopic === '方程关系' ? 'active' : ''}}" data-topic="方程关系" bindtap="selectKnowledgeStarterTopic">方程关系</text>
            <text class="review-topic-chip {{selectedKnowledgeTopic === '英语语法' ? 'active' : ''}}" data-topic="英语语法" bindtap="selectKnowledgeStarterTopic">英语语法</text>
            <text class="review-topic-chip {{selectedKnowledgeTopic === '科学概念' ? 'active' : ''}}" data-topic="科学概念" bindtap="selectKnowledgeStarterTopic">科学概念</text>
          </view>
          <text class="review-workshop-lead">选一个玩法，练第一步和错因；不展示完整解法。</text>
          <view class="review-feedback-strip" wx:if="{{feedbackText}}">
            <text>{{feedbackText}}</text>
            <text wx:if="{{activeReviewTool && activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修这一张</text>
          </view>
          <view class="review-tool-grid">
            <view wx:for="{{playableReviewTools}}" wx:key="id" class="review-tool-card {{item.available ? 'ready' : 'locked'}} {{item.themeClass}}" data-id="{{item.id}}" bindtap="runPlayableReviewTool"><text class="review-tool-icon">{{item.icon}}</text><text>{{item.title}}</text><text>{{item.line}}</text><text>{{item.status}}｜{{item.count}} 张</text><text>{{item.mission}}</text></view>
          </view>
          <view class="review-empty-note" wx:if="{{activeReviewTool && activeReviewTool.empty}}"><text>还没有真实卡。先上传材料或完成一次 AI私教。</text></view>
          <view class="review-live-tool" wx:elif="{{activeReviewTool && activeReviewTool.id}}">
            <text class="review-live-head"><text>{{activeReviewTool.title}}</text><text>{{activeReviewTool.status}}</text></text>
            <view class="review-game-progress"><text>3</text><text>/ 10</text><text>{{selectedKnowledgeTopic}}</text></view>
            <view class="review-game-bar"><view></view></view>
            <text class="review-live-line">{{activeReviewTool.line}}</text>
            <text class="review-live-mission">{{activeReviewTool.mission}}</text>
            <view class="review-live-card"><text>{{activeReviewTool.primary.label}}</text><text>{{activeReviewTool.primary.prompt}}</text><text>{{activeReviewTool.primary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.secondary && activeReviewTool.secondary.id}}"><text>{{activeReviewTool.secondary.label}}</text><text>{{activeReviewTool.secondary.prompt}}</text><text>{{activeReviewTool.secondary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.third && activeReviewTool.third.id}}"><text>{{activeReviewTool.third.label}}</text><text>{{activeReviewTool.third.prompt}}</text><text>{{activeReviewTool.third.check}}</text></view>
            <view class="review-choice-board whack" wx:if="{{activeReviewTool.gameType === 'whack' && activeReviewTool.whackChoices && activeReviewTool.whackChoices.length}}">
              <text wx:for="{{activeReviewTool.whackChoices}}" wx:key="id" class="review-choice-tile {{item.picked ? 'selected' : ''}}" data-index="{{item.index}}" data-id="{{item.id}}" bindtap="selectWhackChoice">{{item.text}}</text>
            </view>
            <view class="review-choice-board" wx:elif="{{activeReviewTool.gameType === 'match' && activeReviewTool.tiles && activeReviewTool.tiles.length}}">
              <text wx:for="{{activeReviewTool.tiles}}" wx:key="id" class="review-choice-tile {{item.selected ? 'selected' : ''}} {{item.matched ? 'matched' : ''}}" data-id="{{item.id}}" bindtap="selectMatchTile">{{item.text}}</text>
            </view>
            <view class="review-choice-board sequence" wx:elif="{{activeReviewTool.gameType === 'snake' && activeReviewTool.currentTrack && activeReviewTool.currentTrack.tiles}}">
              <text wx:for="{{activeReviewTool.currentTrack.tiles}}" wx:key="id" class="review-choice-tile {{item.picked ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="pickSnakeTile">{{item.text}}</text>
            </view>
            <view class="review-finish-card" wx:if="{{activeReviewTool.attemptSummary}}">
              <view><text>这一局探索结束啦</text><text>档案袋留下了 {{activeReviewTool.attemptSummary.correct}} 条会的线索，{{activeReviewTool.attemptSummary.wrong}} 条还要回访。</text></view>
              <view><text>记住了什么</text><text>{{activeReviewTool.roundAdvice ? activeReviewTool.roundAdvice.primary : '先把第一步说清楚'}}</text></view>
              <view><text>明天回访什么</text><text>{{activeReviewTool.repairFocus || '换一道同类小题再认一次门'}} · 系统已安排 2 分钟</text></view>
            </view>
            <view class="review-round-strip" wx:if="{{activeReviewTool.attemptSummary}}"><text>{{activeReviewTool.attemptSummary.accuracy}}%</text><text>对 {{activeReviewTool.attemptSummary.correct}}</text><text>错 {{activeReviewTool.attemptSummary.wrong}}</text><text>{{activeReviewTool.roundAdvice ? activeReviewTool.roundAdvice.primary : '继续'}}</text><text data-result="retry" bindtap="finishPlayableReviewTool">再回忆一次</text><text wx:if="{{activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修错卡</text><text bindtap="openReviewParentEvidence">家长证据</text></view>
            <view class="review-live-actions finish"><button data-result="remembered" bindtap="finishPlayableReviewTool">记录本轮</button></view>
            <view class="review-live-actions grade"><button data-rating="again" bindtap="rate">忘了</button><button data-rating="hard" bindtap="rate">模糊</button><button data-rating="good" bindtap="rate">想起来了</button><button data-rating="easy" bindtap="rate">很轻松</button></view>
          </view>
        </view>

        <view class="review-main-cta" data-id="quiz" bindtap="runPlayableReviewTool">开始一局练习</view>
        <view class="review-template-pack compact" wx:if="{{practiceTemplatePack && practiceTemplatePack.id}}"><text class="review-template-title">知识乐园练习</text><view class="review-template-actions"><text class="review-template-action {{practiceTemplatePack.deliverables[0].ready ? 'ready' : 'pending'}}" data-id="{{practiceTemplatePack.deliverables[0].id}}" data-label="{{practiceTemplatePack.deliverables[0].label}}" data-route="{{practiceTemplatePack.deliverables[0].route}}" bindtap="runTemplateDeliverable">{{practiceTemplatePack.deliverables[0].label}}</text><text class="review-template-action {{practiceTemplatePack.deliverables[1].ready ? 'ready' : 'pending'}}" data-id="{{practiceTemplatePack.deliverables[1].id}}" data-label="{{practiceTemplatePack.deliverables[1].label}}" data-route="{{practiceTemplatePack.deliverables[1].route}}" bindtap="runTemplateDeliverable">{{practiceTemplatePack.deliverables[1].label}}</text><text class="review-template-action {{practiceTemplatePack.deliverables[2].ready ? 'ready' : 'pending'}}" data-id="{{practiceTemplatePack.deliverables[2].id}}" data-label="{{practiceTemplatePack.deliverables[2].label}}" data-route="{{practiceTemplatePack.deliverables[2].route}}" bindtap="runTemplateDeliverable">{{practiceTemplatePack.deliverables[2].label}}</text><text class="review-template-action {{practiceTemplatePack.deliverables[3].ready ? 'ready' : 'pending'}}" data-id="{{practiceTemplatePack.deliverables[3].id}}" data-label="{{practiceTemplatePack.deliverables[3].label}}" data-route="{{practiceTemplatePack.deliverables[3].route}}" bindtap="runTemplateDeliverable">{{practiceTemplatePack.deliverables[3].label}}</text></view></view>
        <view class="review-template-workbench" wx:if="{{practiceTemplateWorkbench && practiceTemplateWorkbench.id}}"><text class="review-workbench-title">{{practiceTemplateWorkbench.title}}</text><text class="review-workbench-status">{{practiceTemplateWorkbench.status}} ｜ {{practiceTemplateWorkbench.count}} 张卡</text><text class="review-workbench-line">{{practiceTemplateWorkbench.line}}</text><text class="review-preview-card">{{practiceTemplateWorkbench.samples[0].label}} ｜ {{practiceTemplateWorkbench.samples[0].source}}</text><text class="review-workbench-safe">{{practiceTemplateWorkbench.safetyLine}}</text></view>
      </view>
    </view>
  </scroll-view>
</view>
