<view class="review-page">
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner">
      <view class="yd-review-screen yd-app-screen yd-review-app">
        <view class="yd-review-pill">3 分钟回访</view>
        <view class="yd-review-top">
          <view class="yd-review-brand"><image class="yd-review-mark" mode="aspectFit" src="/assets/reference/brand-house.png" /><view><text>短回访</text><text>主动回忆和迁移验证</text></view></view>
          <view class="yd-review-pill">{{revisitRunway.due || 0}} 张到期</view>
        </view>

        <view class="yd-review-hero">
          <view class="yd-review-copy">
            <view class="yd-review-title">{{reviewViewModel.title}}</view>
            <view class="yd-review-sub route-note short">先回忆一张真卡，再换题验证迁移。</view>
            <view class="review-chip-row"><text>主动回忆</text><text>错因回放</text><text>明天回流</text></view>
          </view>
          <image class="yd-review-art" mode="aspectFit" src="/assets/reference/review-world-map-transparent.png" />
        </view>

        <view class="review-record-panel">
          <view class="review-section-head"><text>选一张卡</text><text>回忆、核对、明天再看</text></view>
          <text class="review-workshop-lead">先完成一轮 3 分钟回访。</text>
          <view class="review-feedback-strip" wx:if="{{feedbackText}}">
            <text>{{feedbackText}}</text>
            <text wx:if="{{activeReviewTool && activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修这一张</text>
          </view>
          <view class="review-tool-grid">
            <view wx:for="{{playableReviewTools}}" wx:key="id" class="review-tool-card {{item.available ? 'ready' : 'locked'}}" data-id="{{item.id}}" bindtap="runPlayableReviewTool"><text>{{item.title}}</text><text>{{item.line}}</text><text>{{item.status}}｜{{item.count}} 张</text></view>
          </view>
          <view class="review-empty-note" wx:if="{{activeReviewTool && activeReviewTool.empty}}"><text>还没有真实卡。先上传材料或完成一次 AI 点拨。</text></view>
          <view class="review-live-tool" wx:elif="{{activeReviewTool && activeReviewTool.id}}">
            <text class="review-live-head"><text>{{activeReviewTool.title}}</text><text>{{activeReviewTool.status}}</text></text>
            <text class="review-live-line">{{activeReviewTool.line}}</text>
            <view class="review-live-card"><text>{{activeReviewTool.primary.label}}</text><text>{{activeReviewTool.primary.prompt}}</text><text>{{activeReviewTool.primary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.secondary && activeReviewTool.secondary.id}}"><text>{{activeReviewTool.secondary.label}}</text><text>{{activeReviewTool.secondary.prompt}}</text><text>{{activeReviewTool.secondary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.third && activeReviewTool.third.id}}"><text>{{activeReviewTool.third.label}}</text><text>{{activeReviewTool.third.prompt}}</text><text>{{activeReviewTool.third.check}}</text></view>
            <view class="review-round-strip" wx:if="{{activeReviewTool.attemptSummary}}"><text>{{activeReviewTool.attemptSummary.accuracy}}%</text><text>对 {{activeReviewTool.attemptSummary.correct}}</text><text>错 {{activeReviewTool.attemptSummary.wrong}}</text><text>{{activeReviewTool.roundAdvice ? activeReviewTool.roundAdvice.primary : '继续'}}</text><text data-result="retry" bindtap="finishPlayableReviewTool">再来一局</text><text wx:if="{{activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修错卡</text><text bindtap="openReviewParentEvidence">家长证据</text></view>
            <text class="review-whack-board" wx:if="{{activeReviewTool.gameType === 'whack' && activeReviewTool.whackQuestion}}"><text class="review-whack-question">{{activeReviewTool.whackQuestion.question}}</text><text class="review-whack-choice" data-index="0" bindtap="selectWhackChoice">{{activeReviewTool.whackChoices[0].text}}</text><text class="review-whack-choice" data-index="1" bindtap="selectWhackChoice">{{activeReviewTool.whackChoices[1].text}}</text><text class="review-whack-choice" data-index="2" bindtap="selectWhackChoice">{{activeReviewTool.whackChoices[2].text}}</text><text class="review-whack-choice" data-index="3" bindtap="selectWhackChoice">{{activeReviewTool.whackChoices[3].text}}</text><text class="review-whack-done" wx:if="{{activeReviewTool.whackComplete}}">快选完成，可以记录本轮</text></text>
            <view class="review-match-board" wx:if="{{activeReviewTool.gameType === 'match' && activeReviewTool.tiles.length}}">
              <view wx:for="{{activeReviewTool.tiles}}" wx:key="id" class="review-match-tile {{item.selected ? 'selected' : ''}} {{item.matched ? 'matched' : ''}}" data-id="{{item.id}}" bindtap="selectMatchTile"><text>{{item.sideLabel}}</text><text>{{item.text}}</text></view>
            </view>
            <view class="review-snake-board" wx:if="{{activeReviewTool.gameType === 'snake' && activeReviewTool.currentTrack && activeReviewTool.currentTrack.tiles.length}}">
              <view class="review-snake-question">{{activeReviewTool.currentTrack.question}}</view>
              <view class="review-snake-tiles">
                <view wx:for="{{activeReviewTool.currentTrack.tiles}}" wx:key="id" class="review-snake-tile {{item.picked ? 'picked' : ''}}" data-id="{{item.id}}" bindtap="pickSnakeTile"><text>{{item.text}}</text></view>
              </view>
              <view class="review-snake-done" wx:if="{{activeReviewTool.snakeComplete}}">排序完成，可以记录本轮</view>
            </view>
            <view class="review-live-actions finish"><button data-result="remembered" bindtap="finishPlayableReviewTool">记录本轮</button></view>
            <view class="review-live-actions grade"><button data-rating="again" bindtap="rate">忘了</button><button data-rating="hard" bindtap="rate">模糊</button><button data-rating="good" bindtap="rate">想起来了</button><button data-rating="easy" bindtap="rate">很轻松</button></view>
          </view>
        </view>

        <view class="review-main-cta" data-action="review" bindtap="runPlaybookAction">{{reviewViewModel.primaryCta.text}}</view>
        <view class="review-template-pack compact" wx:if="{{practiceTemplatePack && practiceTemplatePack.id && activeReviewTool && activeReviewTool.id}}"><text class="review-template-title">回访后可生成练习卡</text><text class="review-template-action" data-id="{{practiceTemplatePack.deliverables[0].id}}" data-label="{{practiceTemplatePack.deliverables[0].label}}" data-route="{{practiceTemplatePack.deliverables[0].route}}" bindtap="runTemplateDeliverable">生成</text></view>
        <view class="review-template-workbench" wx:if="{{practiceTemplateWorkbench && practiceTemplateWorkbench.id && activeReviewTool && activeReviewTool.id}}"><text class="review-workbench-title">{{practiceTemplateWorkbench.title}}</text><text class="review-workbench-status">{{practiceTemplateWorkbench.status}} ｜ {{practiceTemplateWorkbench.count}} 张卡</text><text class="review-workbench-line">{{practiceTemplateWorkbench.line}}</text><text class="review-preview-card">{{practiceTemplateWorkbench.samples[0].label}} ｜ {{practiceTemplateWorkbench.samples[0].source}}</text><text class="review-workbench-safe">{{practiceTemplateWorkbench.safetyLine}}</text></view>
      </view>
    </view>
  </scroll-view>
</view>
