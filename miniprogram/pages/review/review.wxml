<view class="review-page">
  <scroll-view class="content-area" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-inner">
      <view class="yd-review-screen yd-app-screen yd-review-app">
        <view class="yd-review-top">
          <view class="yd-review-brand"><image class="yd-review-mark" mode="aspectFit" src="/assets/reference/brand-house.png" /><view><text>知识乐园</text><text>把知识点变成一局互动练习</text></view></view>
          <text class="yd-review-pill">{{cards.length || 3}} 张练习卡</text>
        </view>

        <view class="yd-review-hero">
          <view class="review-route-map" aria-hidden="true">
            <text class="review-route-seg seg-a"></text>
            <text class="review-route-seg seg-b"></text>
            <text class="review-route-seg seg-c"></text>
            <text class="review-route-node node-a"><text></text></text>
            <text class="review-route-node node-b"><text></text></text>
            <text class="review-route-node node-c"><text></text></text>
            <text class="review-route-blob"></text>
          </view>
          <view class="yd-review-copy">
            <text class="yd-review-title">选个知识点，开一局</text>
            <text class="yd-review-sub route-note short">没有错题也能先玩；有错题后会变成你的专属练习。</text>
            <view class="review-chip-row"><text>分数</text><text>应用题</text><text>英语单词</text><text>阅读理解</text><text>计算检查</text><text>表达组织</text></view>
          </view>
          <image class="yd-review-art" mode="aspectFit" src="/assets/reference/review-world-map-transparent.png" />
        </view>

        <view class="review-main-tool-grid" wx:if="{{reviewFlowStage === 'main'}}">
          <text class="review-main-tool-card warm" data-id="whack" bindtap="runPlayableReviewTool"><text>约3分</text><text>错因地鼠</text><text>揪出隐藏的易错点</text></text>
          <text class="review-main-tool-card yellow" data-id="quiz" bindtap="runPlayableReviewTool"><text>约2分</text><text>快闪问答</text><text>极速反应知识练习</text></text>
          <text class="review-main-tool-card blue" data-id="match" bindtap="runPlayableReviewTool"><text>约4分</text><text>拼图配对</text><text>核心概念连连看</text></text>
          <text class="review-main-tool-card teal" data-id="snake" bindtap="runPlayableReviewTool"><text>约5分</text><text>路线接龙</text><text>逻辑推导找路径</text></text>
        </view>

        <view class="review-record-panel" wx:if="{{reviewFlowStage !== 'main'}}">
          <view class="review-section-head"><text>{{reviewFlowStage === 'topic' ? '今天想练哪一块？' : reviewFlowStage === 'tool' ? '玩法选择' : reviewFlowStage === 'finished' ? '这一局探索结束啦' : '快闪问答'}}</text><text>{{reviewFlowStage === 'topic' ? '推荐探索 · 换一批 · 选个知识点，马上开局' : reviewFlowStage === 'tool' ? '选一个最适合现在节奏的玩法' : reviewFlowStage === 'finished' ? '档案袋留下证据' : '正在热身 · 找第一步'}}</text></view>
          <text class="review-flow-tabs">
            <text class="{{reviewFlowStage === 'topic' ? 'active' : ''}}" data-stage="topic" bindtap="setReviewFlowStage">选知识点</text>
            <text class="{{reviewFlowStage === 'tool' ? 'active' : ''}}" data-stage="tool" bindtap="setReviewFlowStage">玩法选择</text>
            <text class="{{reviewFlowStage === 'live' ? 'active' : ''}}" data-stage="live" bindtap="setReviewFlowStage">进行中</text>
            <text class="{{reviewFlowStage === 'finished' ? 'active' : ''}}" data-stage="finished" bindtap="setReviewFlowStage">一局结束</text>
          </text>
          <view class="review-topic-row" wx:if="{{reviewFlowStage === 'topic'}}">
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '小数乘法' ? 'active' : ''}}" data-topic="小数乘法" bindtap="selectKnowledgeStarterTopic">小数乘法&#10;消除易错点&#10;约 10 分钟</text>
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '认识分数' ? 'active' : ''}}" data-topic="认识分数" bindtap="selectKnowledgeStarterTopic">认识分数&#10;色彩涂涂&#10;约 15 分钟</text>
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '面积计算' ? 'active' : ''}}" data-topic="面积计算" bindtap="selectKnowledgeStarterTopic">面积计算&#10;拼图解谜&#10;约 12 分钟</text>
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '混合运算' ? 'active' : ''}}" data-topic="混合运算" bindtap="selectKnowledgeStarterTopic">混合运算&#10;极速速算&#10;约 5 分钟</text>
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '认识钟表' ? 'active' : ''}}" data-topic="认识钟表" bindtap="selectKnowledgeStarterTopic">认识钟表&#10;拨盘解密&#10;约 8 分钟</text>
            <text class="review-topic-card review-topic-chip {{selectedKnowledgeTopic === '长度单位' ? 'active' : ''}}" data-topic="长度单位" bindtap="selectKnowledgeStarterTopic">长度单位&#10;魔法尺子&#10;约 10 分钟</text>
          </view>
          <text class="review-topic-cta" wx:if="{{reviewFlowStage === 'topic'}}" bindtap="selectKnowledgeStarterTopic" data-topic="{{selectedKnowledgeTopic}}">用这个开一局</text>
          <view class="review-workshop-lead review-target-card" wx:if="{{reviewFlowStage !== 'topic'}}"><text>当前攻克目标</text><text>{{selectedKnowledgeTopic || '分数除法'}}</text><text>{{cards.length || 3}} 张卡 · 挑选开局方式，马上开始。</text></view>
          <view class="review-feedback-strip" wx:if="{{feedbackText}}"><text>{{feedbackText}}</text><text wx:if="{{activeReviewTool && activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修这一张</text></view>
          <view class="review-tool-grid" wx:if="{{reviewFlowStage === 'tool'}}">
            <view wx:for="{{playableReviewTools}}" wx:key="id" class="review-tool-card {{item.available ? 'ready' : 'locked'}} {{item.themeClass}}" data-id="{{item.id}}" bindtap="runPlayableReviewTool"><text class="review-tool-icon">{{item.icon}}</text><text>{{item.title}}</text><text>{{item.line}}</text><text>{{item.duration}}</text><text>{{item.status}} · {{item.count}} 张</text><text>{{item.mission}}</text></view>
          </view>
          <view class="review-empty-note" wx:if="{{reviewFlowStage !== 'topic' && activeReviewTool && activeReviewTool.empty}}"><text>还没有真实卡。先上传材料或完成一次 AI 点拨。</text></view>
          <view class="review-live-tool stage-{{reviewFlowStage}}" wx:elif="{{reviewFlowStage !== 'tool' && activeReviewTool && activeReviewTool.id}}">
            <view class="review-play-top" wx:if="{{reviewFlowStage === 'live'}}"><text>×</text><text>{{activeReviewTool.title || '快闪问答'}}</text><text>Ⅱ</text></view>
            <view class="review-game-progress" wx:if="{{reviewFlowStage === 'live'}}"><view><text>3</text><text>/ 10</text></view><text>正在热身</text></view>
            <view class="review-game-bar" wx:if="{{reviewFlowStage === 'live'}}"><view></view></view>
            <view class="review-live-reference" wx:if="{{reviewFlowStage === 'live'}}"><text class="review-live-glow top"></text><text class="review-live-glow bottom"></text><view><text>找第一步</text><text class="review-live-mission">{{activeReviewTool.mission}}</text></view><text class="review-live-brain"></text><text>遇到“相遇问题”时，脑海里跳出的第一个动作应该是什么？</text><text>先说出第一步，再点击下方按钮。</text><text class="review-live-bottom-line"></text></view>
            <view class="review-live-card"><text>{{activeReviewTool.primary.label}}</text><text>{{activeReviewTool.primary.prompt}}</text><text>{{activeReviewTool.primary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.secondary && activeReviewTool.secondary.id}}"><text>{{activeReviewTool.secondary.label}}</text><text>{{activeReviewTool.secondary.prompt}}</text><text>{{activeReviewTool.secondary.check}}</text></view>
            <view class="review-live-card compact" wx:if="{{activeReviewTool.third && activeReviewTool.third.id}}"><text>{{activeReviewTool.third.label}}</text><text>{{activeReviewTool.third.prompt}}</text><text>{{activeReviewTool.third.check}}</text></view>
            <view class="review-choice-board whack" wx:if="{{activeReviewTool.gameType === 'whack' && activeReviewTool.whackChoices && activeReviewTool.whackChoices.length}}"><text wx:for="{{activeReviewTool.whackChoices}}" wx:key="id" class="review-choice-tile {{item.picked ? 'selected' : ''}}" data-index="{{item.index}}" data-id="{{item.id}}" bindtap="selectWhackChoice">{{item.text}}</text></view>
            <view class="review-choice-board" wx:elif="{{activeReviewTool.gameType === 'match' && activeReviewTool.tiles && activeReviewTool.tiles.length}}"><text wx:for="{{activeReviewTool.tiles}}" wx:key="id" class="review-choice-tile {{item.selected ? 'selected' : ''}} {{item.matched ? 'matched' : ''}}" data-id="{{item.id}}" bindtap="selectMatchTile">{{item.text}}</text></view>
            <view class="review-choice-board sequence" wx:elif="{{activeReviewTool.gameType === 'snake' && activeReviewTool.currentTrack && activeReviewTool.currentTrack.tiles}}"><text wx:for="{{activeReviewTool.currentTrack.tiles}}" wx:key="id" class="review-choice-tile {{item.picked ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="pickSnakeTile">{{item.text}}</text></view>
            <view class="review-finish-card" wx:if="{{activeReviewTool.attemptSummary}}">
              <view class="review-finish-hero"><text></text><text>这一局探索结束啦</text><text>档案袋留下了 <text>{{activeReviewTool.attemptSummary.correct}}</text> 条证据</text></view>
              <view class="review-finish-section remembered"><view><text></text><text>记住了什么</text></view><view><text></text><text>搞定了当前卡片的第一步和关键条件。</text></view><view><text></text><text>认识了容易混淆的条件关系。</text></view></view>
              <view class="review-finish-section stuck"><view><text></text><text>还卡在哪里</text></view><text>{{activeReviewTool.repairFocus || '同类变式还需要再认认门。'}}<text>大脑正在给它们建新文件夹呢，明天再认认门。</text></text></view>
              <view class="review-finish-section tomorrow"><view><text></text><text>明天回访什么</text></view><view><text></text><text>{{activeReviewTool.repairFocus || '反义词小连线'}}</text><text>系统已安排 · 预计 2 分钟</text></view></view>
              <view class="review-finish-bottom"><button data-result="retry" bindtap="finishPlayableReviewTool">再练一局</button><button bindtap="openReviewParentEvidence">给家长看证据</button></view>
            </view>
            <view class="review-round-strip" wx:if="{{activeReviewTool.attemptSummary}}"><text>{{activeReviewTool.attemptSummary.accuracy}}%</text><text>对 {{activeReviewTool.attemptSummary.correct}}</text><text>错 {{activeReviewTool.attemptSummary.wrong}}</text><text>{{activeReviewTool.roundAdvice ? activeReviewTool.roundAdvice.primary : '继续'}}</text><text data-result="retry" bindtap="finishPlayableReviewTool">再练一局</text><text wx:if="{{activeReviewTool.repairFocus}}" bindtap="openReviewRepairFocus">修错卡</text><text bindtap="openReviewParentEvidence">给家长看证据</text></view>
            <view class="review-live-actions finish"><button data-result="remembered" bindtap="finishPlayableReviewTool">记录本轮</button><button data-result="retry" bindtap="finishPlayableReviewTool">再练一局</button></view>
            <view class="review-live-actions grade"><button data-rating="again" bindtap="rate">需要提示</button><button data-rating="hard" bindtap="rate">有点模糊</button><button data-rating="good" bindtap="rate">我记得第一步</button><button data-rating="easy" bindtap="rate">先跳过</button></view>
          </view>
        </view>

        <text class="review-main-cta" wx:if="{{reviewFlowStage === 'main' || reviewFlowStage === 'topic'}}" data-stage="tool" bindtap="setReviewFlowStage">开始一局练习</text>
        <view class="review-main-cta" wx:if="{{reviewFlowStage === 'tool'}}" data-id="whack" bindtap="runPlayableReviewTool">开始错因地鼠</view>
      </view>
    </view>
  </scroll-view>
</view>
