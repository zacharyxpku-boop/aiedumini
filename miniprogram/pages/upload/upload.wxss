page {
  background: #f8fafc;
}

.upload-page {
  min-height: 100vh;
  color: #1e293b;
  background: #f8fafc;
}

.upload-scroll {
  min-height: 100vh;
  height: auto;
}

.upload-content {
  padding: calc(44rpx + env(safe-area-inset-top)) 48rpx calc(176rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-upload-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 28rpx;
  justify-content: flex-start;
  min-height: auto;
  margin-bottom: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.yd-upload-top,
.yd-upload-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-upload-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-upload-mark {
  display: block;
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  object-fit: contain;
  padding: 0;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.05);
}

.yd-upload-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-upload-brand text:first-child {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-upload-brand text:last-child {
  margin-top: 3rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 760;
}

.yd-upload-pill {
  flex: 0 0 auto;
  padding: 14rpx 18rpx;
  border: 0;
  border-radius: 999rpx;
  color: #94a3b8;
  background: transparent;
  font-size: 28rpx;
  font-weight: 900;
}

.yd-upload-heading {
  flex: 0 0 auto;
  margin: 20rpx 0 8rpx;
}

.yd-upload-title {
  color: #111827;
  font-size: 52rpx;
  font-weight: 950;
  line-height: 1.18;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-upload-sub {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.upload-evidence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.upload-evidence-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 204rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 24rpx 18rpx;
  border: 2rpx dashed #e2e8f0;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.98);
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.025);
}

.upload-evidence-card.primary {
  grid-column: 1 / -1;
  min-height: 202rpx;
  align-items: stretch;
  justify-content: flex-start;
  padding: 32rpx;
  border-style: solid;
  border-color: rgba(20, 184, 166, 0.46);
  background: rgba(204, 251, 241, 0.36);
  text-align: left;
}

.upload-evidence-card image {
  width: 96rpx;
  height: 96rpx;
  object-fit: contain;
  border-radius: 36rpx;
  background: #f8fafc;
}

.upload-evidence-copy {
  display: block;
  min-width: 0;
}

.upload-evidence-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-evidence-copy text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.upload-evidence-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 780;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.upload-evidence-card > text {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #64748b;
  background: #f8fafc;
  font-size: 22rpx;
  font-weight: 950;
}

.upload-evidence-card.primary > text {
  color: #0f766e;
  background: #ffffff;
}

.upload-unlock-panel {
  display: grid;
  gap: 20rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.upload-unlock-panel > text {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-unlock-panel view {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8rpx;
  align-items: center;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.upload-unlock-panel view text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.upload-unlock-panel view text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.18;
  -webkit-line-clamp: 1;
}

.upload-unlock-panel view text:last-child {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-line-clamp: 2;
}

.upload-intake-workbench,
.upload-material-panel,
.upload-report-ready {
  padding: 22rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: none;
}

.upload-workbench-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.upload-workbench-head text:first-child {
  color: #18211d;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-workbench-head text:last-child {
  max-width: 360rpx;
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.28;
  text-align: right;
}

.upload-textarea {
  width: 100%;
  min-height: 148rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  border-radius: 28rpx;
  color: #27352f;
  background: #f8fafc;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.35;
}

.upload-textarea.material {
  min-height: 176rpx;
}

.upload-workbench-actions,
.upload-workflow-actions,
.upload-report-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 9rpx;
}

.upload-workbench-actions text,
.upload-workflow-actions text,
.upload-report-actions text,
.upload-material-submit {
  display: inline-flex;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #174533;
  background: #f0fbf0;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.upload-workbench-actions text:first-child,
.upload-workflow-actions text:first-child,
.upload-report-actions text:first-child,
.upload-material-submit {
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
}

.upload-workflow-actions {
  grid-column: 1 / -1;
  margin-top: 0;
}

.upload-workflow-actions text {
  color: #1d3b2e;
  background: #e8f6ec;
}

.upload-material-submit {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

.upload-report-ready {
  position: fixed;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  background: linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
  box-shadow: 0 12rpx 30rpx rgba(38, 58, 43, 0.12);
}

.upload-material-panel,
.upload-intake-workbench {
  position: fixed;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 22;
  max-height: 54vh;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(38, 58, 43, 0.12);
}

.upload-report-ready text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-report-title {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.3;
}

.upload-report-flow {
  display: block;
  grid-column: 1 / -1;
  padding: 6rpx 10rpx;
  border-radius: 18rpx;
  color: #506157;
  background: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.28;
}

.upload-report-ready > view:first-child text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.upload-report-ready > view:first-child text:nth-child(2) {
  margin-top: 4rpx;
  color: #66756d;
  font-size: 20rpx;
  font-weight: 760;
}

.yd-upload-primary {
  position: fixed;
  right: 48rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 48rpx;
  z-index: 18;
  height: 92rpx;
  margin-top: 0;
  border-radius: 40rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 16rpx 36rpx rgba(251, 191, 36, 0.34);
  font-size: 36rpx;
  font-weight: 950;
  line-height: 92rpx;
  text-align: center;
}
