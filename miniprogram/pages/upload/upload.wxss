page {
  background: #faf9f5;
}

.upload-page {
  min-height: 100vh;
  color: #33312e;
  background: #faf9f5;
}

.upload-scroll {
  height: 100vh;
}

.upload-content {
  padding: calc(108rpx + env(safe-area-inset-top)) 30rpx calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.yd-upload-screen {
  position: relative;
  margin-bottom: 22rpx;
  padding: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 10% 4%, rgba(248, 198, 34, 0.16), transparent 24%),
    radial-gradient(circle at 92% 8%, rgba(76, 159, 255, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-upload-top,
.yd-upload-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-upload-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-upload-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  padding: 7rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  background: #ebf9ed;
  box-shadow: 0 14rpx 26rpx rgba(34, 185, 92, 0.24);
}

.yd-upload-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-upload-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-upload-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-upload-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 22rpx;
  font-weight: 900;
}

.yd-upload-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 156rpx;
  gap: 18rpx;
  align-items: center;
  min-height: 246rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 2rpx dashed rgba(34, 185, 92, 0.5);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(248, 198, 34, 0.18), transparent 22%),
    linear-gradient(135deg, #ffffff 0%, #f3fbef 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.yd-upload-title {
  color: #101a16;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.1;
  letter-spacing: 0;
}

.yd-upload-sub {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 20rpx;
  line-height: 1.34;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-upload-proof,
.upload-type-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.yd-upload-proof text,
.upload-type-strip text {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 820;
  white-space: nowrap;
}

.yd-upload-proof text {
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  color: #26754c;
  background: #f0fbf0;
}

.upload-type-strip text {
  padding: 6rpx 10rpx;
  border: 1rpx solid rgba(248, 198, 34, 0.24);
  color: #6d5b25;
  background: #fff7df;
  font-size: 17rpx;
}

.yd-upload-mascot {
  width: 156rpx;
  height: 148rpx;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 28rpx;
  background: #f6fbf0;
  filter: drop-shadow(0 16rpx 22rpx rgba(34, 68, 48, 0.12));
}

.upload-material-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.upload-material-card {
  display: grid;
  min-width: 0;
  min-height: 128rpx;
  align-content: start;
  justify-items: center;
  gap: 8rpx;
  padding: 11rpx 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(38, 58, 43, 0.055);
}

.upload-material-card.primary {
  background: linear-gradient(180deg, #ffffff 0%, #f0fbf0 100%);
}

.upload-material-icon {
  display: block;
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
  padding: 8rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 16rpx;
  background: #effaf0;
}

.upload-material-icon.blue {
  background: #eef7ff;
}

.upload-material-icon.yellow {
  background: #fff7df;
}

.upload-material-card text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
}

.upload-material-card text:nth-child(2) {
  color: #17211d;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1.2;
  white-space: nowrap;
}

.upload-material-card text:nth-child(3) {
  color: #66746d;
  font-size: 18rpx;
  line-height: 1.35;
}

.yd-upload-pipeline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
}

.upload-pipeline-node {
  position: relative;
  display: grid;
  min-width: 0;
  min-height: 98rpx;
  align-content: center;
  justify-items: center;
  gap: 5rpx;
  padding: 9rpx 3rpx;
  overflow: visible;
  border: 1rpx solid rgba(220, 232, 220, 0.95);
  border-radius: 19rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6fbf3 100%);
  box-shadow: 0 12rpx 24rpx rgba(41, 65, 52, 0.07);
}

.upload-pipeline-node:active {
  transform: translateY(1rpx);
  box-shadow: 0 8rpx 18rpx rgba(41, 65, 52, 0.05);
}

.upload-pipeline-node::after {
  content: "";
  position: absolute;
  top: 50%;
  right: -14rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #dce8dc;
  transform: translateY(-50%);
}

.upload-pipeline-node:last-child::after {
  display: none;
}

.upload-pipeline-icon {
  width: 38rpx;
  height: 38rpx;
  padding: 6rpx;
  border-radius: 15rpx;
  background: #f0f8ee;
}

.upload-pipeline-node text {
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-pipeline-node text:nth-child(2) {
  color: #17211d;
  font-size: 17rpx;
  font-weight: 950;
  line-height: 1.18;
}

.upload-pipeline-node text:nth-child(3) {
  color: #526158;
  font-size: 15rpx;
  font-weight: 780;
  line-height: 1.18;
}

.upload-pipeline-node.done {
  border-color: rgba(34, 185, 92, 0.28);
  background: linear-gradient(180deg, #effbf2 0%, #ffffff 100%);
}

.upload-pipeline-node.active {
  border-color: rgba(76, 159, 255, 0.32);
  background: linear-gradient(180deg, #eef7ff 0%, #ffffff 100%);
}

.upload-pipeline-node.next {
  border-color: rgba(248, 198, 34, 0.34);
  background: linear-gradient(180deg, #fff8df 0%, #ffffff 100%);
}

.upload-pipeline-node.done .upload-pipeline-icon {
  background: #dff7e6;
}

.upload-pipeline-node.active .upload-pipeline-icon {
  background: #e5f2ff;
}

.upload-pipeline-node.next .upload-pipeline-icon {
  background: #fff1bd;
}

.yd-upload-primary {
  height: 66rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  box-shadow: 0 16rpx 28rpx rgba(248, 198, 34, 0.22);
  font-size: 23rpx;
  font-weight: 950;
  line-height: 66rpx;
  text-align: center;
}
