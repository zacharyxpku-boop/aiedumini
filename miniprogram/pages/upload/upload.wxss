page {
  background: #faf9f5;
}

.upload-page {
  min-height: 100vh;
  color: #33312e;
  background: #faf9f5;
}

.upload-scroll {
  min-height: 100vh;
  height: auto;
}

.upload-content {
  padding: calc(86rpx + env(safe-area-inset-top)) 26rpx calc(188rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.yd-upload-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 12rpx;
  justify-content: flex-start;
  min-height: calc(100vh - 190rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  margin-bottom: 34rpx;
  padding: 20rpx;
  overflow: visible;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 216, 79, 0.22) 0%, rgba(255, 216, 79, 0) 34%),
    linear-gradient(205deg, rgba(34, 185, 92, 0.16) 0%, rgba(34, 185, 92, 0) 36%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 8rpx 18rpx rgba(38, 58, 43, 0.04);
}

.yd-upload-top,
.yd-upload-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-upload-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-upload-mark {
  display: block;
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  object-fit: contain;
  padding: 6rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 18rpx;
  background: #ebf9ed;
  box-shadow: inset 0 0 0 1rpx rgba(34, 185, 92, 0.10);
}

.yd-upload-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-upload-brand text:first-child {
  color: #18211d;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-upload-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 20rpx;
  font-weight: 760;
}

.yd-upload-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  color: #14854a;
  background: #ebf9ed;
  font-size: 21rpx;
  font-weight: 900;
}

.yd-upload-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 214rpx;
  gap: 14rpx;
  align-items: center;
  flex: 0 0 auto;
  min-height: 300rpx;
  max-height: none;
  margin-top: 0;
  padding: 26rpx 22rpx;
  overflow: hidden;
  border: 2rpx dashed rgba(34, 185, 92, 0.5);
  border-radius: 32rpx;
  background:
    linear-gradient(145deg, rgba(255, 216, 79, 0.28) 0%, rgba(255, 216, 79, 0) 32%),
    linear-gradient(135deg, #ffffff 0%, #eef9ff 48%, #f3fbef 100%);
  box-shadow:
    0 10rpx 24rpx rgba(34, 185, 92, 0.07),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.72);
}

.yd-upload-title {
  color: #101a16;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 1.06;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-upload-sub {
  display: -webkit-box;
  margin-top: 9rpx;
  overflow: hidden;
  color: #64706a;
  font-size: 25rpx;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-upload-proof {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 8rpx;
}

.yd-upload-proof text {
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 820;
  white-space: normal;
}

.yd-upload-proof text {
  border: 1rpx solid rgba(34, 185, 92, 0.14);
  color: #26754c;
  background: #f0fbf0;
}

.yd-upload-mascot {
  width: 214rpx;
  height: 214rpx;
  align-self: center;
  justify-self: end;
  overflow: hidden;
  object-fit: contain;
  border: 6rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 28rpx;
  background: #f6fbf0;
}

.upload-next-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.upload-next-card {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  min-width: 0;
  min-height: 124rpx;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: none;
}

.upload-next-card.route {
  background: #fff8df;
}

.upload-next-card:active {
  transform: scale(0.985);
}

.upload-next-card image {
  grid-row: 1 / 3;
  width: 58rpx;
  height: 58rpx;
  object-fit: contain;
}

.upload-next-card text {
  min-width: 0;
}

.upload-next-card text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-next-card text:nth-child(2) {
  color: #173f31;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.14;
  white-space: nowrap;
}

.upload-next-card text:nth-child(3) {
  display: -webkit-box;
  margin-top: 5rpx;
  color: #66746d;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.upload-evidence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.upload-evidence-card {
  display: grid;
  min-width: 0;
  min-height: 164rpx;
  align-content: space-between;
  gap: 8rpx;
  padding: 16rpx;
  border: 2rpx dashed rgba(203, 213, 225, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}

.upload-evidence-card.primary {
  grid-column: 1 / -1;
  min-height: 150rpx;
  border-style: solid;
  border-color: rgba(20, 184, 166, 0.38);
  background:
    radial-gradient(circle at 92% 0%, rgba(20, 184, 166, 0.10), transparent 34%),
    rgba(204, 251, 241, 0.34);
}

.upload-evidence-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-evidence-card text:first-child {
  color: #14241d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.16;
  white-space: nowrap;
}

.upload-evidence-card text:nth-child(2) {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 820;
  line-height: 1.24;
  white-space: nowrap;
}

.upload-evidence-card text:last-child {
  justify-self: start;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ccfbf1;
  font-size: 20rpx;
  font-weight: 950;
}

.upload-output-trail,
.upload-unlock-panel {
  display: grid;
  gap: 10rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
}

.upload-unlock-panel > text {
  color: #18211d;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-unlock-panel view {
  display: grid;
  grid-template-columns: 148rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: center;
  min-height: 70rpx;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(246, 251, 244, 0.92);
}

.upload-unlock-panel view text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.upload-unlock-panel view text:first-child {
  color: #173f31;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.18;
  -webkit-line-clamp: 1;
}

.upload-unlock-panel view text:last-child {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.24;
  -webkit-line-clamp: 2;
}

.upload-intake-workbench,
.upload-material-panel,
.upload-report-ready {
  padding: 16rpx;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: none;
}

.upload-workbench-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.upload-workbench-head text:first-child {
  color: #18211d;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-workbench-head text:last-child {
  max-width: 360rpx;
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.28;
  text-align: right;
}

.upload-textarea {
  width: 100%;
  min-height: 136rpx;
  margin-top: 9rpx;
  padding: 15rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 18rpx;
  color: #27352f;
  background: #f9fcf7;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.35;
}

.upload-textarea.material {
  min-height: 176rpx;
}

.upload-workbench-actions,
.upload-workflow-actions,
.upload-report-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 9rpx;
}

.upload-workbench-actions text,
.upload-workflow-actions text,
.upload-report-actions text,
.upload-material-submit {
  display: inline-flex;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #174533;
  background: #f0fbf0;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.upload-workbench-actions text:first-child,
.upload-workflow-actions text:first-child,
.upload-report-actions text:first-child,
.upload-material-submit {
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
}

.upload-workflow-actions {
  grid-column: 1 / -1;
  margin-top: 0;
}

.upload-workflow-actions text {
  color: #1d3b2e;
  background: #e8f6ec;
}

.upload-material-submit {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

.upload-report-ready {
  position: fixed;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  background: linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
  box-shadow: 0 12rpx 30rpx rgba(38, 58, 43, 0.12);
}

.upload-material-panel {
  position: fixed;
  right: 28rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 22;
  max-height: 54vh;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(38, 58, 43, 0.12);
}

.upload-report-ready text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-report-title {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.3;
}

.upload-report-flow {
  display: block;
  grid-column: 1 / -1;
  padding: 6rpx 10rpx;
  border-radius: 18rpx;
  color: #506157;
  background: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 780;
  line-height: 1.28;
}

.upload-report-ready > view:first-child text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.upload-report-ready > view:first-child text:nth-child(2) {
  margin-top: 4rpx;
  color: #66756d;
  font-size: 20rpx;
  font-weight: 760;
}

.upload-output-trail view {
  display: grid;
  min-width: 0;
  min-height: 70rpx;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  border-radius: 18rpx;
  background: #f6fbf0;
}

.upload-output-trail text:first-child {
  width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  color: #1d261f;
  background: #ffd84f;
  font-size: 20rpx;
  font-weight: 950;
  line-height: 30rpx;
  text-align: center;
}

.upload-output-trail text:last-child {
  max-width: 100%;
  overflow: hidden;
  color: #2e3b35;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.18;
  text-align: center;
  text-overflow: ellipsis;
  white-space: normal;
}

.yd-upload-primary {
  height: 92rpx;
  margin-top: 0;
  border-radius: 999rpx;
  color: #1d261f;
  background: linear-gradient(180deg, #ffd84f 0%, #f5b300 100%);
  box-shadow: 0 6rpx 14rpx rgba(248, 198, 34, 0.12);
  font-size: 28rpx;
  font-weight: 950;
  line-height: 92rpx;
  text-align: center;
}
