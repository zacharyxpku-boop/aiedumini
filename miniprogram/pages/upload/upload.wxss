page {
  background: #f9f8f4;
}

.upload-page {
  min-height: 100vh;
  color: #1f2937;
  background:
    radial-gradient(circle at 92% 0%, rgba(255, 237, 213, 0.56), transparent 30%),
    radial-gradient(circle at 0% 28%, rgba(204, 251, 241, 0.46), transparent 28%),
    #f9f8f4;
}

.upload-scroll {
  min-height: 100vh;
  height: auto;
}

.upload-content {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(58rpx + env(safe-area-inset-top)) 44rpx calc(190rpx + env(safe-area-inset-bottom));
}

.yd-upload-screen {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 22rpx;
  justify-content: flex-start;
  min-height: auto;
  margin-bottom: 0;
  padding: 0;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.yd-upload-top,
.yd-upload-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-upload-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-upload-mark {
  display: block;
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  object-fit: contain;
  padding: 0;
  border: 2rpx solid #ffffff;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(44, 38, 33, 0.05);
}

.yd-upload-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-upload-brand text:first-child {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-upload-brand text:last-child {
  margin-top: 3rpx;
  color: #0d9488;
  font-size: 21rpx;
  font-weight: 820;
}

.yd-upload-pill {
  flex: 0 0 auto;
  padding: 14rpx 18rpx;
  border: 0;
  border-radius: 999rpx;
  color: #a89f93;
  background: transparent;
  font-size: 28rpx;
  font-weight: 900;
}

.yd-upload-heading {
  flex: 0 0 auto;
  margin: 18rpx 0 8rpx;
}

.yd-upload-title {
  max-width: 620rpx;
  color: #1f2937;
  font-size: 56rpx;
  font-weight: 950;
  line-height: 1.2;
  letter-spacing: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.yd-upload-sub {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.46;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.upload-evidence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.upload-evidence-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 176rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 18rpx 36rpx;
  border: 2rpx dashed #e2e8f0;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.035);
}

.upload-evidence-card.primary {
  grid-column: 1 / -1;
  min-height: 208rpx;
  align-items: stretch;
  justify-content: flex-start;
  padding: 28rpx 28rpx 34rpx;
  border-style: solid;
  border-color: rgba(20, 184, 166, 0.24);
  background:
    radial-gradient(circle at 92% 0%, rgba(20, 184, 166, 0.13), transparent 26%),
    #e6f4f1;
  text-align: left;
}

.upload-evidence-card image {
  width: 96rpx;
  height: 96rpx;
  object-fit: contain;
  padding: 8rpx;
  border-radius: 30rpx;
  background: #fff7ed;
  box-sizing: border-box;
}

.upload-evidence-card.primary image {
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.06);
}

.upload-evidence-copy {
  display: block;
  min-width: 0;
}

.upload-evidence-card text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-evidence-copy text:first-child {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.upload-evidence-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6b7280;
  font-size: 23rpx;
  font-weight: 780;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.upload-evidence-card > text {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #9ca3af;
  background: #f8fafc;
  font-size: 22rpx;
  font-weight: 950;
}

.upload-evidence-card.primary > text {
  color: #0f766e;
  background: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.05);
}

.upload-unlock-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.upload-unlock-panel > text {
  grid-column: 1 / -1;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-unlock-panel view {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 7rpx;
  align-items: start;
  min-height: 112rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(240, 235, 225, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.035);
}

.upload-unlock-panel view::before {
  content: "";
  width: 38rpx;
  height: 38rpx;
  border-radius: 15rpx;
  background: #ccfbf1;
}

.upload-unlock-panel view:nth-of-type(2)::before {
  background: #fce7f3;
}

.upload-unlock-panel view:nth-of-type(3)::before {
  background: #fef3c7;
}

.upload-unlock-panel view text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}

.upload-unlock-panel view text:first-child {
  color: #1f2937;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.2;
  -webkit-line-clamp: 1;
}

.upload-unlock-panel view text:last-child {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.28;
  -webkit-line-clamp: 2;
}

.upload-intake-workbench,
.upload-material-panel,
.upload-report-ready {
  padding: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.92);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: none;
}

.upload-workbench-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.upload-workbench-head text:first-child {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.2;
}

.upload-workbench-head text:last-child {
  max-width: 360rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.28;
  text-align: right;
}

.upload-textarea {
  width: 100%;
  min-height: 156rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.86);
  border-radius: 28rpx;
  color: #1f2937;
  background: #f8fafc;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.42;
}

.upload-textarea.material {
  min-height: 176rpx;
}

.upload-workbench-actions,
.upload-workflow-actions,
.upload-report-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 9rpx;
}

.upload-workbench-actions text,
.upload-workflow-actions text,
.upload-report-actions text,
.upload-material-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
}

.upload-workbench-actions text:first-child,
.upload-workflow-actions text:first-child,
.upload-report-actions text:first-child,
.upload-material-submit {
  color: #78350f;
  background: #fbbf24;
}

.upload-workflow-actions {
  grid-column: 1 / -1;
  margin-top: 0;
}

.upload-workflow-actions text {
  color: #1d3b2e;
  background: #e8f6ec;
}

.upload-material-submit {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

.upload-report-ready {
  position: fixed;
  right: 32rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  align-items: center;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12);
}

.upload-material-panel,
.upload-intake-workbench {
  position: fixed;
  right: 32rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 22;
  max-height: 58vh;
  overflow-y: auto;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12);
}

.upload-report-ready text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.upload-report-title {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 1.3;
}

.upload-report-flow {
  display: block;
  grid-column: 1 / -1;
  padding: 6rpx 10rpx;
  border-radius: 18rpx;
  color: #64748b;
  background: #f8fafc;
  font-size: 21rpx;
  font-weight: 780;
  line-height: 1.28;
}

.upload-report-ready > view:first-child text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
}

.upload-report-ready > view:first-child text:nth-child(2) {
  margin-top: 4rpx;
  color: #66756d;
  font-size: 20rpx;
  font-weight: 760;
}

.yd-upload-primary {
  position: fixed;
  right: 48rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 48rpx;
  z-index: 18;
  height: 92rpx;
  margin-top: 0;
  border-radius: 40rpx;
  color: #78350f;
  background: #fbbf24;
  box-shadow: 0 16rpx 36rpx rgba(251, 191, 36, 0.34);
  font-size: 36rpx;
  font-weight: 950;
  line-height: 92rpx;
  text-align: center;
}

.yd-upload-primary::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  height: 170rpx;
  background: linear-gradient(180deg, rgba(249, 248, 244, 0), #f9f8f4 48%, #f9f8f4);
  pointer-events: none;
}
