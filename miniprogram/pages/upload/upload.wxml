<view class="upload-page">
  <scroll-view class="upload-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="upload-content">
      <view class="yd-upload-screen yd-app-screen yd-upload-app">
        <view class="yd-upload-top">
          <view class="yd-upload-back" bindtap="goBack">‹</view>
          <view class="yd-upload-titlebar">
            <text>完善信息</text>
          </view>
          <view class="yd-upload-pill" bindtap="viewLatestReport">跳过</view>
        </view>

        <view class="yd-upload-heading">
          <view class="yd-upload-title">收集线索碎片 🧩</view>
          <view class="yd-upload-sub"><text>材料越真实，建议越具体。</text><text><text>直接拍照或打字都可以</text>，不必全部填满哦～</text></view>
        </view>

        <view class="upload-evidence-grid">
          <view class="upload-evidence-card primary" data-type="wrong_question_paper" bindtap="openMaterialReportPanel"><image mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" /><text class="upload-evidence-copy"><text>错题描述</text><text>记录孩子常卡住的题型</text></text><text>✓ 已添加 1 份</text><text class="upload-evidence-sample">"昨天数学卷子大题第二问，总是列错方程..."</text></view>
          <view class="upload-evidence-card" data-type="score_sheet" bindtap="openMaterialReportPanel"><image mode="aspectFit" src="/assets/reference/report-radar-card-illustration.png" /><text class="upload-evidence-copy"><text>成绩/周测</text><text>拍照留存 · 手动摘录线索</text></text><text>+</text></view>
          <view class="upload-evidence-card" data-type="school_material" bindtap="openMaterialReportPanel"><image mode="aspectFit" src="/assets/reference/tutor-socratic-board-transparent.png" /><text class="upload-evidence-copy"><text>老师反馈</text><text>聊天截图/评语</text></text><text>+</text></view>
          <view class="upload-evidence-card" data-type="parent_report" bindtap="openMaterialReportPanel"><image mode="aspectFit" src="/assets/reference/family-avatar-group-transparent.png" /><text class="upload-evidence-copy"><text>家长观察</text><text>随意写几句现状</text></text><text>+</text></view>
          <view class="upload-evidence-card" data-type="talent_assessment" bindtap="openMaterialReportPanel"><image mode="aspectFit" src="/assets/reference/learning-route-map-transparent.png" /><text class="upload-evidence-copy"><text>测评摘要</text><text>以往的诊断报告</text></text><text>+</text></view>
        </view>

        <view class="upload-intake-workbench" wx:if="{{showMaterialPanel}}">
          <view class="upload-workbench-head"><text>补一条可验证线索</text><text bindtap="toggleMaterialPanel">收起</text></view>
          <textarea class="upload-textarea material" value="{{materialText}}" bindinput="onMaterialInput" maxlength="1600" placeholder="例如：六年级数学应用题，孩子看到“多 3 倍”就直接乘，卡在先设哪个量。必须有真实作业/错题锚点，报告才放行。" />
          <view class="upload-workbench-actions"><text bindtap="chooseImage">照片留存</text><text data-type="parent_report" bindtap="setMaterialType">家长观察</text><text data-type="score_sheet" bindtap="setMaterialType">成绩/周测</text><text data-type="school_material" bindtap="setMaterialType">老师反馈</text></view>
          <text class="upload-material-submit" bindtap="importMaterialPack">生成成长报告</text>
        </view>

        <view class="upload-unlock-panel">
          <text>生成报告后，你会得到</text>
          <view><text>学习偏好线索</text><text>用材料和问卷交叉验证。</text></view>
          <view><text>当前卡点定位</text><text>先找孩子卡住的第一步。</text></view>
          <view><text>今晚行动建议</text><text>接到问咕点和知识乐园。</text></view>
        </view>

        <view class="yd-upload-primary" bindtap="submit">生成成长报告</view>
        <view class="upload-report-ready" wx:if="{{lastReportCta}}">
          <text class="upload-report-title">{{lastReportCta.reportReadiness && lastReportCta.reportReadiness.banner ? lastReportCta.reportReadiness.banner : '材料结果'}} · {{lastReportCta.title}}</text><block wx:if="{{parentReportWorkflowView}}">
            <text class="upload-report-flow">{{parentReportWorkflowView.loopLine}}</text>
            <text class="upload-report-flow">{{parentReportWorkflowView.statusLine}}</text>
            <text class="upload-report-flow">{{parentReportWorkflowView.reasoningLine}}</text>
            <text class="upload-report-flow">{{parentReportWorkflowView.imageLine}}</text>
          </block>
          <text class="upload-workflow-actions" wx:if="{{parentReportWorkflowView}}"><text data-workflow="source" bindtap="openReportWorkflowRoute">资料包</text><text data-workflow="modules" bindtap="openReportWorkflowRoute">模块路线</text><text data-workflow="preview" bindtap="openReportWorkflowRoute">报告预览</text></text>
          <view class="upload-report-actions"><text bindtap="viewLatestReport">查看成长报告</text><text bindtap="runReportFollowupAction">{{lastReportCta.actionLabel}}</text></view>
        </view>

      </view>
    </view>
  </scroll-view>
</view>
