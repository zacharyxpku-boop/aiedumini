<view class="upload-page">
  <scroll-view class="upload-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="upload-content">
      <view class="yd-upload-screen yd-app-screen yd-upload-app">
        <view class="yd-upload-top">
          <view class="yd-upload-brand">
            <image class="yd-upload-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
            <view>
              <text>原点智学</text>
              <text>资料先进入证据链</text>
            </view>
          </view>
          <view class="yd-upload-pill">学习包</view>
        </view>

        <view class="yd-upload-hero">
          <view class="yd-upload-copy">
            <view class="yd-upload-title">先把材料分清楚</view>
            <view class="yd-upload-sub">测评、成绩、错题和家长观察会进入不同证据位，再生成报告和今晚路线。</view>
            <view class="yd-upload-proof">
              <text>不公开分享</text>
              <text>先分类再分析</text>
            </view>
            <view class="upload-type-strip">
              <text>学习偏好/测评资料</text>
              <text>成绩单/周测</text>
              <text>错题试卷</text>
            </view>
          </view>
          <image class="yd-upload-mascot" mode="aspectFit" src="/assets/reference/upload-folder-stack-transparent.png" />
        </view>

        <view class="upload-material-grid yd-jump-grid">
          <view class="upload-material-card yd-jump-card primary" data-scene="upload" bindtap="openEntryDetail">
            <image class="upload-material-icon" mode="aspectFit" src="/assets/reference/entry-upload.png" />
            <text>上传材料</text>
            <text>作业/错题/成绩</text>
          </view>
          <view class="upload-material-card yd-jump-card" data-scene="parent" bindtap="openEntryDetail">
            <image class="upload-material-icon blue" mode="aspectFit" src="/assets/reference/entry-report.png" />
            <text>家长报告</text>
            <text>证据与方法匹配</text>
          </view>
          <view class="upload-material-card yd-jump-card" data-scene="today" bindtap="openEntryDetail">
            <image class="upload-material-icon yellow" mode="aspectFit" src="/assets/reference/entry-map.png" />
            <text>今晚路线</text>
            <text>直接生成任务</text>
          </view>
        </view>

        <view class="yd-upload-pipeline">
          <view class="upload-pipeline-node done" data-scene="upload" bindtap="openEntryDetail">
            <image class="upload-pipeline-icon" mode="aspectFit" src="/assets/reference/entry-upload.png" />
            <text>已分类</text>
            <text>材料入库</text>
          </view>
          <view class="upload-pipeline-node active" data-scene="report" bindtap="openEntryDetail">
            <image class="upload-pipeline-icon" mode="aspectFit" src="/assets/reference/entry-report.png" />
            <text>提证据</text>
            <text>置信度</text>
          </view>
          <view class="upload-pipeline-node" data-scene="parent" bindtap="openEntryDetail">
            <image class="upload-pipeline-icon" mode="aspectFit" src="/assets/reference/entry-parent.png" />
            <text>出报告</text>
            <text>给家长</text>
          </view>
          <view class="upload-pipeline-node next" data-scene="tutor" bindtap="openEntryDetail">
            <image class="upload-pipeline-icon" mode="aspectFit" src="/assets/reference/entry-tutor.png" />
            <text>进入AI私教</text>
            <text>说第一步</text>
          </view>
        </view>
        <view class="yd-upload-primary" data-scene="upload" bindtap="openEntryDetail">生成学习包</view>

        <view class="upload-proof-board">
          <view class="upload-proof-title">材料进入后会生成什么</view>
          <view class="upload-proof-list">
            <view data-scene="report" bindtap="openEntryDetail">
              <text>01</text>
              <view>
                <text>天赋/学习偏好证据</text>
                <text>先说明孩子适合怎样学，再匹配方法。</text>
              </view>
            </view>
            <view data-scene="tutor" bindtap="openEntryDetail">
              <text>02</text>
              <view>
                <text>AI私教第一问</text>
                <text>从错题卡点出发，只追问下一步。</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
